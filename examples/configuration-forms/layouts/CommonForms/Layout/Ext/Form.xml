        <Page name="NotesPage" id="8"><Title>Notes</Title><ChildItems>
          <InputField name="NotesInput" id="9"><Title>Notes</Title><DataPath>Notes</DataPath></InputField>
          <Button name="ApplyNotes" id="10"><Title>Build summary</Title><CommandName>BuildSummary</CommandName></Button>
        </ChildItems></Page>
      </ChildItems></Pages>
    </ChildItems></UsualGroup>
    <UsualGroup name="Actions" id="11"><ShowTitle>false</ShowTitle><Group>Horizontal</Group><ChildItems>
      <Button name="ToggleNamesButton" id="12"><Title>Lock/unlock name group</Title><CommandName>ToggleNames</CommandName></Button>
      <Button name="ToggleNotesButton" id="13"><Title>Show/hide notes page</Title><CommandName>ToggleNotes</CommandName></Button>
    </ChildItems></UsualGroup>
    <LabelField name="SummaryLabel" id="14"><Title>Summary</Title><DataPath>Summary</DataPath></LabelField>
  </ChildItems>
  <Commands>
    <Command name="BuildSummary" id="1"><Action>BuildSummaryClick</Action></Command>
    <Command name="ToggleNames" id="2"><Action>ToggleNamesClick</Action></Command>
    <Command name="ToggleNotes" id="3"><Action>ToggleNotesClick</Action></Command>
