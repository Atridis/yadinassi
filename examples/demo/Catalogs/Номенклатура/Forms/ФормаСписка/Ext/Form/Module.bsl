&НаКлиенте
Процедура ПроверитьКарточку(Команда)

	СсылкаНаНоменклатуру = Элементы.Список.ТекущаяСтрока;
	Если Не ЗначениеЗаполнено(СсылкаНаНоменклатуру) Тогда
		Сообщить("Выберите номенклатуру в списке.");
		Возврат;
	КонецЕсли;

	ПроверитьКарточкуНаСервере(СсылкаНаНоменклатуру);

КонецПроцедуры

&НаСервереБезКонтекста
Процедура ПроверитьКарточкуНаСервере(СсылкаНаНоменклатуру)

	Если ТипЗнч(СсылкаНаНоменклатуру) <> Тип("СправочникСсылка.Номенклатура") Тогда
		Сообщить("Для проверки необходимо выбрать элемент справочника Номенклатура.");
		Возврат;
	КонецЕсли;
	Если Не ЗначениеЗаполнено(СсылкаНаНоменклатуру) Тогда
		Сообщить("Выберите номенклатуру в списке.");
		Возврат;
	КонецЕсли;

	Карточка = СсылкаНаНоменклатуру.ПолучитьОбъект();
	Если Карточка = Неопределено Тогда
		Сообщить("Карточка уже удалена. Обновите список.");
		Возврат;
	КонецЕсли;
	Если Карточка.ПометкаУдаления Тогда
		Сообщить("Карточка помечена на удаление. Снимите пометку перед проверкой.");
		Возврат;
	КонецЕсли;

	ЕстьОшибки = Ложь;
	Карточка.ПроверитьДанные(ЕстьОшибки);
	Если Не ЕстьОшибки Тогда
		Сообщить("Карточка заполнена корректно: указан действующий вид и неповторяющиеся склады хранения.");
	КонецЕсли;

КонецПроцедуры
