// Проверки выполняются также при программной записи и загрузке через обмен.
Процедура ПередЗаписью(Отказ)

	// Пометка удаления должна быть доступна и для старых незаполненных карточек.
	Если ПометкаУдаления Тогда
		Возврат;
	КонецЕсли;

	ПодготовитьДанныеКЗаписи(Отказ);

КонецПроцедуры

Процедура ПодготовитьДанныеКЗаписи(Отказ) Экспорт

	Если ПометкаУдаления Тогда
		Возврат;
	КонецЕсли;

	Наименование = СокрЛП(Наименование);
	ПроверитьДанные(Отказ);

КонецПроцедуры

// Общая проверка для записи из формы, программной записи и команды списка.
// Не изменяет объект. Команда списка проверяет только сохраненные данные.
Процедура ПроверитьДанные(Отказ) Экспорт

	Если СтрДлина(СокрЛП(Наименование)) < 3 Тогда
		СообщитьОбОшибке(Отказ,
			"Укажите наименование номенклатуры длиной не менее трех символов.", "Наименование");
	КонецЕсли;

	Если Не ЗначениеЗаполнено(ВидНоменклатуры) Тогда
		СообщитьОбОшибке(Отказ, "Выберите вид номенклатуры.", "ВидНоменклатуры");
	Иначе
		ОбъектВида = ВидНоменклатуры.ПолучитьОбъект();
		Если ОбъектВида = Неопределено Тогда
			СообщитьОбОшибке(Отказ, "Выбранный вид номенклатуры не существует.", "ВидНоменклатуры");
		ИначеЕсли ОбъектВида.ПометкаУдаления Тогда
			СообщитьОбОшибке(Отказ,
				"Выбранный вид номенклатуры помечен на удаление. Выберите другой вид.", "ВидНоменклатуры");
		КонецЕсли;
	КонецЕсли;

	Если Склады.Количество() = 0 Тогда
		СообщитьОбОшибке(Отказ, "Укажите хотя бы один склад хранения.", "Склады");
	КонецЕсли;

	СсылкиСкладов = Склады.ВыгрузитьКолонку("Склад");
	СостоянияСкладов = Новый Соответствие;
	Если СсылкиСкладов.Количество() > 0 Тогда
		ЗапросСкладов = Новый Запрос("ВЫБРАТЬ Ссылка, ПометкаУдаления ИЗ Справочник.Склады ГДЕ Ссылка В (&Ссылки)");
		ЗапросСкладов.УстановитьПараметр("Ссылки", СсылкиСкладов);
		ВыборкаСкладов = ЗапросСкладов.Выполнить().Выбрать();
		Пока ВыборкаСкладов.Следующий() Цикл
			СостоянияСкладов.Вставить(ВыборкаСкладов.Ссылка, ВыборкаСкладов.ПометкаУдаления);
		КонецЦикла;
	КонецЕсли;

	ПроверенныеСклады = Новый Соответствие;
	Для Каждого СтрокаСклада Из Склады Цикл
		СсылкаСклада = СтрокаСклада.Склад;
		Если Не ЗначениеЗаполнено(СсылкаСклада) Тогда
			СообщитьОбОшибкеСклада(Отказ, "Заполните склад в строке " + Строка(СтрокаСклада.НомерСтроки) + ".", СтрокаСклада.НомерСтроки);
			Продолжить;
		КонецЕсли;

		ПерваяСтрока = ПроверенныеСклады.Получить(СсылкаСклада);
		Если ПерваяСтрока <> Неопределено Тогда
			СообщитьОбОшибкеСклада(Отказ,
				"Этот склад уже указан в строке " + Строка(ПерваяСтрока) + ". Удалите повторяющуюся строку.", СтрокаСклада.НомерСтроки);
			Продолжить;
		КонецЕсли;
		ПроверенныеСклады.Вставить(СсылкаСклада, СтрокаСклада.НомерСтроки);

		ПометкаСклада = СостоянияСкладов.Получить(СсылкаСклада);
		Если ПометкаСклада = Неопределено Тогда
			СообщитьОбОшибкеСклада(Отказ, "Выбранный склад не существует.", СтрокаСклада.НомерСтроки);
		ИначеЕсли ПометкаСклада Тогда
			СообщитьОбОшибкеСклада(Отказ, "Склад помечен на удаление. Выберите другой склад.", СтрокаСклада.НомерСтроки);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

Процедура СообщитьОбОшибкеСклада(Отказ, ТекстОшибки, НомерСтроки)

	СообщитьОбОшибке(Отказ, ТекстОшибки, "Склады[" + Формат(НомерСтроки - 1, "ЧГ=0") + "].Склад");

КонецПроцедуры

Процедура СообщитьОбОшибке(Отказ, ТекстОшибки, Поле)

	Отказ = Истина;
	Сообщение = Новый СообщениеПользователю;
	Сообщение.Текст = ТекстОшибки;
	Сообщение.Поле = Поле;
	Сообщение.УстановитьДанные(ЭтотОбъект);
	Сообщение.Сообщить();

КонецПроцедуры
