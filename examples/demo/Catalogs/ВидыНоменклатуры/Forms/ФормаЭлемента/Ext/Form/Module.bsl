&НаКлиенте
Процедура НаименованиеПриИзменении(Элемент)

	Объект.Наименование = СокрЛП(Объект.Наименование);
	Если СтрДлина(Объект.Наименование) < 3 Тогда
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "Название вида должно содержать не менее трех символов, например: Товары или Материалы.";
		Сообщение.Поле = "Объект.Наименование";
		Сообщение.Сообщить();
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)

	Если ТекущийОбъект.ПометкаУдаления Тогда
		Возврат;
	КонецЕсли;

	ТекущийОбъект.Наименование = СокрЛП(ТекущийОбъект.Наименование);
	Если СтрДлина(ТекущийОбъект.Наименование) < 3 Тогда
		Отказ = Истина;
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "Укажите название вида номенклатуры длиной не менее трех символов.";
		Сообщение.Поле = "Объект.Наименование";
		Сообщение.Сообщить();
	КонецЕсли;

КонецПроцедуры
