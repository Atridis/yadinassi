КоличествоИтераций = 10000000;



// Пустой цикл.

Начало = ТекущаяУниверсальнаяДатаВМиллисекундах();



Для НомерИтерации = 1 По КоличествоИтераций Цикл

КонецЦикла;



ВремяПустогоЦикла = ТекущаяУниверсальнаяДатаВМиллисекундах() - Начало;



// Цикл с арифметикой. Результат выводится для проверки вычислений.

Результат = 0;

Начало = ТекущаяУниверсальнаяДатаВМиллисекундах();



Для НомерИтерации = 1 По КоличествоИтераций Цикл

    Результат = Результат + НомерИтерации * 3 - 7;

КонецЦикла;



ВремяМатематики = ТекущаяУниверсальнаяДатаВМиллисекундах() - Начало;



// Вывод находится за пределами измеряемых участков.

Сообщить("Количество итераций: " + Строка(КоличествоИтераций));



Сообщить("Пустой цикл: "

    + Строка(ВремяПустогоЦикла) + " мс; "

    + Строка(ВремяПустогоЦикла / 1000) + " с");



Сообщить("Цикл с арифметикой: "

    + Строка(ВремяМатематики) + " мс; "

    + Строка(ВремяМатематики / 1000) + " с");



Сообщить("Результат: " + Строка(Результат));

Сообщить("Ожидаемый результат: "

    + Строка(3 * КоличествоИтераций * (КоличествоИтераций + 1) / 2

        - 7 * КоличествоИтераций));
