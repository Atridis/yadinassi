// Original disposable oracle. Only fresh user setup runs in this privileged hook.
// No catalog data access, no authentication/protection assignment, no retries.
Процедура УстановкаПараметровСеанса(ТребуемыеПараметры)
    Если ТребуемыеПараметры <> Неопределено Тогда
        Возврат;
    КонецЕсли;
    Корень = @@EVIDENCE@@;
    Файл = Новый Файл(Корень + "/control.json");
    Если Не Файл.Существует() Тогда
        Возврат;
    КонецЕсли;
    Если Файл.Размер() > 1024 Тогда
        ВызватьИсключение "invalid_control";
    КонецЕсли;
    Чтение = Новый ЧтениеJSON;
    Чтение.ОткрытьФайл(Файл.ПолноеИмя);
    Контроль = ПрочитатьJSON(Чтение);
    Чтение.Закрыть();
    Если ТипЗнч(Контроль) <> Тип("Структура") Тогда
        ВызватьИсключение "invalid_control";
    КонецЕсли;
    Если Контроль.Количество() <> 4 Или Контроль.schema <> 1 Или Контроль.nonce <> @@NONCE@@ Тогда
        ВызватьИсключение "invalid_control";
    КонецЕсли;
    Если Контроль.operation <> "bootstrap" Тогда
        // Ordinary named sessions never execute setup or catalog operations here.
        Возврат;
    КонецЕсли;
    Если ТипЗнч(Контроль.token) <> Тип("Строка") Или СтрДлина(Контроль.token) <> 32 Тогда
        ВызватьИсключение "invalid_control";
    КонецЕсли;
    Для Индекс = 1 По 32 Цикл
        Если СтрНайти("0123456789abcdef", Сред(Контроль.token, Индекс, 1)) = 0 Тогда
            ВызватьИсключение "invalid_control";
        КонецЕсли;
    КонецЦикла;
    Путь = Корень + "/bootstrap.json";
    ФайлРезультата = Новый Файл(Путь);
    Если ФайлРезультата.Существует() Тогда
        ВызватьИсключение "stale_evidence";
    КонецЕсли;
    Текущий = ПользователиИнформационнойБазы.ТекущийПользователь();
    Если Текущий <> Неопределено Тогда
        Если Текущий.Имя <> "" Тогда
            ВызватьИсключение "permission_mismatch";
        КонецЕсли;
    КонецЕсли;
    Если ПользователиИнформационнойБазы.ПолучитьПользователей().Количество() <> 0 Тогда
        ВызватьИсключение "permission_mismatch";
    КонецЕсли;
    Если Метаданные.Роли.Количество() <> 2 Тогда
        ВызватьИсключение "permission_mismatch";
    КонецЕсли;
    NativeСоздатьПользователя(@@SETUP_USER@@, Метаданные.Роли.NativeOracleSetupAdministrator);
    NativeСоздатьПользователя(@@CRUD_USER@@, Метаданные.Роли.NativeOracleCatalogCRUD);
    Пользователи = ПользователиИнформационнойБазы.ПолучитьПользователей();
    Если Пользователи.Количество() <> 2 Тогда
        ВызватьИсключение "permission_mismatch";
    КонецЕсли;
    NativeПроверитьПользователя(ПользователиИнформационнойБазы.НайтиПоИмени(@@SETUP_USER@@), @@SETUP_USER@@, Метаданные.Роли.NativeOracleSetupAdministrator);
    NativeПроверитьПользователя(ПользователиИнформационнойБазы.НайтиПоИмени(@@CRUD_USER@@), @@CRUD_USER@@, Метаданные.Роли.NativeOracleCatalogCRUD);
    Результат = Новый Структура;
    Результат.Вставить("schema", 1);
    Результат.Вставить("nonce", @@NONCE@@);
    Результат.Вставить("token", Контроль.token);
    Результат.Вставить("operation", "bootstrap");
    Результат.Вставить("status", "ok");
    Результат.Вставить("user", "");
    Результат.Вставить("role_verified", Истина);
    Результат.Вставить("users_verified", Истина);
    Результат.Вставить("nonprivileged", Ложь);
    Результат.Вставить("metadata_version", 1);
    Длина = Метаданные.Справочники.NativeOracleItems.Реквизиты.Payload.Тип.КвалификаторыСтроки.Длина;
    Разрядность = Метаданные.Справочники.NativeOracleItems.Реквизиты.Amount.Тип.КвалификаторыЧисла.Разрядность;
    Масштаб = Метаданные.Справочники.NativeOracleItems.Реквизиты.Amount.Тип.КвалификаторыЧисла.РазрядностьДробнойЧасти;
    Если Длина <> 32 Или Разрядность <> 9 Или Масштаб <> 2 Тогда
        ВызватьИсключение "metadata_mismatch";
    КонецЕсли;
    Результат.Вставить("payload_length", Длина);
    Результат.Вставить("amount_digits", Разрядность);
    Результат.Вставить("amount_scale", Масштаб);
    Для Каждого Поле Из СтрРазделить("count,code,payload,amount,deletion_mark,same_reference", ",") Цикл
        Результат.Вставить(Поле, Null);
    КонецЦикла;
    Информация = Новый СистемнаяИнформация;
    Результат.Вставить("actual_version", Информация.ВерсияПриложения);
    Запись = Новый ЗаписьJSON;
    Запись.ОткрытьФайл(Путь);
    ЗаписатьJSON(Запись, Результат);
    Запись.Закрыть();
КонецПроцедуры

Процедура NativeСоздатьПользователя(Имя, Роль)
    Пользователь = ПользователиИнформационнойБазы.СоздатьПользователя();
    Пользователь.Имя = Имя;
    // Preserve all platform-default authentication and dangerous-action settings.
    Для Каждого НеожиданнаяРоль Из Пользователь.Роли Цикл
        ВызватьИсключение "permission_mismatch";
    КонецЦикла;
    Пользователь.Роли.Добавить(Роль);
    Пользователь.Записать();
КонецПроцедуры

Процедура NativeПроверитьПользователя(Пользователь, Имя, Роль)
    Если Пользователь = Неопределено Тогда
        ВызватьИсключение "permission_mismatch";
    КонецЕсли;
    Если Пользователь.Имя <> Имя Или Не Пользователь.Роли.Содержит(Роль) Тогда
        ВызватьИсключение "permission_mismatch";
    КонецЕсли;
    Количество = 0;
    Для Каждого НазначеннаяРоль Из Пользователь.Роли Цикл
        Количество = Количество + 1;
    КонецЦикла;
    Если Количество <> 1 Тогда
        ВызватьИсключение "permission_mismatch";
    КонецЕсли;
КонецПроцедуры
