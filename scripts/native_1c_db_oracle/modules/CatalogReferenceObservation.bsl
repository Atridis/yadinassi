// Private bounded observations for the closed reference measurement only.
Процедура NativeReferenceWrite(Корень, Данные)
    Путь = Корень + "/reference-observation.json";
    ФайлНаблюдения = Новый Файл(Путь);
    Если ФайлНаблюдения.Существует() Тогда
        ВызватьИсключение "marker_invalid";
    КонецЕсли;
    ПараметрыJSON = Новый ПараметрыЗаписиJSON(ПереносСтрокJSON.Нет, " ", Истина);
    Запись = Новый ЗаписьJSON;
    Запись.ОткрытьФайл(Путь, , , ПараметрыJSON);
    ЗаписатьJSON(Запись, Данные);
    Запись.Закрыть();
КонецПроцедуры

Процедура NativeReferenceInstall(Объект, Корень, ТокенЗапуска, Операция)
    Этап = "case_uuid";
    Попытка
        Идентификатор = Новый УникальныйИдентификатор("@@CASE_UUID@@");
        Этап = "get_reference";
        Ссылка = Справочники.NativeOracleItems.ПолучитьСсылку(Идентификатор);
        Этап = "set_reference";
        Объект.УстановитьСсылкуНового(Ссылка);
    Исключение
        Данные = Новый Структура("schema,status,nonce,token,case,operation,phase,code",
            1, "error", @@NONCE@@, ТокенЗапуска, "@@CASE@@", Операция, Этап, "native_api_error");
        NativeReferenceWrite(Корень, Данные);
        ВызватьИсключение "process_failed";
    КонецПопытки;
КонецПроцедуры

Функция NativeReferenceCode(Значение)
    Если ТипЗнч(Значение) <> Тип("Булево") Тогда
        Возврат "E";
    КонецЕсли;
    Если Значение Тогда
        Возврат "T";
    КонецЕсли;
    Возврат "F";
КонецФункции

Функция NativeReferenceProbe(Корень)
    Коды = "";
    Попытка
        Коды = Коды + NativeReferenceCode(Справочники.NativeOracleItems.ПустаяСсылка().УникальныйИдентификатор() = Новый УникальныйИдентификатор("00000000-0000-0000-0000-000000000000"));
    Исключение
        Коды = Коды + "E";
    КонецПопытки;
    Попытка
        Коды = Коды + NativeReferenceCode(Справочники.NativeOracleItems.ПустаяСсылка().Пустая());
    Исключение
        Коды = Коды + "E";
    КонецПопытки;
    Попытка
        Коды = Коды + NativeReferenceCode(ЗначениеЗаполнено(Справочники.NativeOracleItems.ПустаяСсылка()));
    Исключение
        Коды = Коды + "E";
    КонецПопытки;
    Попытка
        Коды = Коды + NativeReferenceCode(Справочники.NativeOracleItems.ПолучитьСсылку(Новый УникальныйИдентификатор("00000000-0000-0000-0000-000000000000")) = Справочники.NativeOracleItems.ПустаяСсылка());
    Исключение
        Коды = Коды + "E";
    КонецПопытки;
    Попытка
        Коды = Коды + NativeReferenceCode(Справочники.NativeOracleItems.ПолучитьСсылку(Новый УникальныйИдентификатор("00000000-0000-0000-0000-000000000000")).Пустая());
    Исключение
        Коды = Коды + "E";
    КонецПопытки;
    Попытка
        Коды = Коды + NativeReferenceCode(ЗначениеЗаполнено(Справочники.NativeOracleItems.ПолучитьСсылку(Новый УникальныйИдентификатор("00000000-0000-0000-0000-000000000000"))));
    Исключение
        Коды = Коды + "E";
    КонецПопытки;
    Попытка
        Коды = Коды + NativeReferenceCode(Справочники.NativeOracleItems.ПолучитьСсылку(Новый УникальныйИдентификатор("@@CASE_UUID@@")).УникальныйИдентификатор() = Новый УникальныйИдентификатор("@@CASE_UUID@@"));
    Исключение
        Коды = Коды + "E";
    КонецПопытки;
    Попытка
        Коды = Коды + NativeReferenceCode(Справочники.NativeOracleItems.ПолучитьСсылку(Новый УникальныйИдентификатор("@@CASE_UUID@@")).Пустая());
    Исключение
        Коды = Коды + "E";
    КонецПопытки;
    Попытка
        Коды = Коды + NativeReferenceCode(ЗначениеЗаполнено(Справочники.NativeOracleItems.ПолучитьСсылку(Новый УникальныйИдентификатор("@@CASE_UUID@@"))));
    Исключение
        Коды = Коды + "E";
    КонецПопытки;
    Сохраненная = NativeСохраненнаяСсылка(Корень);
    Есть = Сохраненная <> Неопределено;
    UUID = "";
    Если Есть Тогда
        UUID = Строка(Сохраненная.УникальныйИдентификатор());
        Попытка
            Коды = Коды + NativeReferenceCode(Справочники.NativeOracleItems.ПолучитьСсылку(Сохраненная.УникальныйИдентификатор()) = Сохраненная);
        Исключение
            Коды = Коды + "E";
        КонецПопытки;
        Попытка
            Коды = Коды + NativeReferenceCode(Сохраненная.Пустая());
        Исключение
            Коды = Коды + "E";
        КонецПопытки;
        Попытка
            Коды = Коды + NativeReferenceCode(ЗначениеЗаполнено(Сохраненная));
        Исключение
            Коды = Коды + "E";
        КонецПопытки;
    Иначе
        Коды = Коды + "NNN";
    КонецЕсли;
    Возврат Новый Структура("present,codes,uuid", Есть, Коды, UUID);
КонецФункции

Процедура NativeReferenceFinish(Корень, ТокенЗапуска, Операция, До)
    После = NativeReferenceProbe(Корень);
    Данные = Новый Структура("schema,status,nonce,token,case,operation,before_present,after_present,before,after,actual_uuid",
        1, "ok", @@NONCE@@, ТокенЗапуска, "@@CASE@@", Операция,
        До.present, После.present, До.codes, После.codes, После.uuid);
    NativeReferenceWrite(Корень, Данные);
КонецПроцедуры
