// PRIVATE standalone same-session witness; not registered in a runner.
// No assignment seed is an expected readback value.
Процедура NativeNumericCodeObserve(Корень, ТокенЗапуска, Операция)
    Каталог = Метаданные.Справочники.NativeOracleItems;
    Если Каталог.ДлинаКода <> @@NUMERIC_LENGTH@@ Или Каталог.ДлинаНаименования <> 8
        Или Каталог.Автонумерация Тогда
        ВызватьИсключение "metadata_mismatch";
    КонецЕсли;
    ДлинаPayload = Каталог.Реквизиты.Payload.Тип.КвалификаторыСтроки.Длина;
    Если ДлинаPayload <> 32 И ДлинаPayload <> 64 Тогда
        ВызватьИсключение "metadata_mismatch";
    КонецЕсли;
    Сохраненная = NativeСохраненнаяСсылка(Корень);
    Выборка = Справочники.NativeOracleItems.Выбрать();
    Есть = Выборка.Следующий();
    КодXML = "";
    UUID = "";
    Наименование = "";
    ЧисловойКод = Ложь;
    Если Есть Тогда
        Если Выборка.Ссылка <> Сохраненная Или Выборка.ПометкаУдаления Тогда
            ВызватьИсключение "logical_mismatch";
        КонецЕсли;
        ЧисловойКод = ТипЗнч(Выборка.Код) = Тип("Число");
        Если Не ЧисловойКод Тогда
            ВызватьИсключение "logical_mismatch";
        КонецЕсли;
        КодXML = XMLСтрока(Выборка.Код);
        UUID = Строка(Выборка.Ссылка.УникальныйИдентификатор());
        Наименование = Выборка.Наименование;
        Если СтрДлина(КодXML) > 80 Или ТипЗнч(Наименование) <> Тип("Строка")
            Или СтрДлина(Наименование) > 128 Или Выборка.Следующий() Тогда
            ВызватьИсключение "logical_mismatch";
        КонецЕсли;
    КонецЕсли;
    Путь = Корень + "/numeric-code-observation.json";
    ФайлНаблюдения = Новый Файл(Путь);
    Если ФайлНаблюдения.Существует() Тогда
        ВызватьИсключение "stale_evidence";
    КонецЕсли;
    Данные = Новый Структура("schema,nonce,token,case,operation,present,actual_number,actual_code,actual_uuid,actual_description,code_length,description_length,payload_length,autonumbering",
        1, @@NONCE@@, ТокенЗапуска, "@@NUMERIC_CASE@@", Операция, Есть,
        ЧисловойКод, КодXML, UUID, Наименование, Каталог.ДлинаКода,
        Каталог.ДлинаНаименования, ДлинаPayload, Каталог.Автонумерация);
    NativeЗаписатьJSON(Путь, Данные);
КонецПроцедуры
