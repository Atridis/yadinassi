// PRIVATE disabled-Code observation; no runtime registration or write API.
Процедура NativeZeroCodeObserve(Корень, ТокенЗапуска, Операция)
    Каталог = Метаданные.Справочники.NativeOracleItems;
    Если Каталог.ДлинаКода <> 0 Или Каталог.ДлинаНаименования <> @@ZERO_DESCRIPTION@@
        Или Каталог.Автонумерация Тогда
        ВызватьИсключение "metadata_mismatch";
    КонецЕсли;
    Если Каталог.ТипКода = ТипКодаСправочника.Строка Тогда
        ТипКодаМетаданных = "string";
    ИначеЕсли Каталог.ТипКода = ТипКодаСправочника.Число Тогда
        ТипКодаМетаданных = "number";
    Иначе
        ТипКодаМетаданных = "other";
    КонецЕсли;
    ДлинаPayload = Каталог.Реквизиты.Payload.Тип.КвалификаторыСтроки.Длина;
    Если ДлинаPayload <> 32 И ДлинаPayload <> 64 Тогда
        ВызватьИсключение "metadata_mismatch";
    КонецЕсли;
    Сохраненная = NativeСохраненнаяСсылка(Корень);
    Выборка = Справочники.NativeOracleItems.Выбрать();
    Есть = Выборка.Следующий();
    СостояниеКода = "absent";
    ЗначениеКода = "";
    UUID = "";
    Наименование = "";
    Если Есть Тогда
        Если Выборка.Ссылка <> Сохраненная Или Выборка.ПометкаУдаления Тогда
            ВызватьИсключение "logical_mismatch";
        КонецЕсли;
        Доступен = Истина;
        // Catch only property access, never conversion/metadata/reference/write.
        Попытка
            КодНаблюдения = Выборка.Код;
        Исключение
            Доступен = Ложь;
        КонецПопытки;
        Если Не Доступен Тогда
            СостояниеКода = "unavailable";
        ИначеЕсли ТипЗнч(КодНаблюдения) = Тип("Строка") Тогда
            СостояниеКода = "string";
            ЗначениеКода = КодНаблюдения;
        ИначеЕсли ТипЗнч(КодНаблюдения) = Тип("Число") Тогда
            СостояниеКода = "number";
            ЗначениеКода = XMLСтрока(КодНаблюдения);
        Иначе
            СостояниеКода = "other";
        КонецЕсли;
        UUID = Строка(Выборка.Ссылка.УникальныйИдентификатор());
        Если Каталог.ДлинаНаименования > 0 Тогда
            Наименование = Выборка.Наименование;
        КонецЕсли;
        Если СтрДлина(ЗначениеКода) > 128 Или ТипЗнч(Наименование) <> Тип("Строка")
            Или СтрДлина(Наименование) > 128 Или Выборка.Следующий() Тогда
            ВызватьИсключение "logical_mismatch";
        КонецЕсли;
    КонецЕсли;
    Путь = Корень + "/zero-code-observation.json";
    ФайлНаблюдения = Новый Файл(Путь);
    Если ФайлНаблюдения.Существует() Тогда
        ВызватьИсключение "stale_evidence";
    КонецЕсли;
    Данные = Новый Структура("schema,nonce,token,case,operation,present,code_type,code_state,actual_code,actual_uuid,actual_description,code_length,description_length,payload_length,autonumbering",
        1, @@NONCE@@, ТокенЗапуска, "@@ZERO_CASE@@", Операция, Есть,
        ТипКодаМетаданных, СостояниеКода, ЗначениеКода, UUID, Наименование, Каталог.ДлинаКода,
        Каталог.ДлинаНаименования, ДлинаPayload, Каталог.Автонумерация);
    // Explicit compact private transport; existing shared writer is unchanged.
    Запись = Новый ЗаписьJSON;
    Запись.ОткрытьФайл(Путь, "UTF-8", Ложь, Новый ПараметрыЗаписиJSON(ПереносСтрокJSON.Нет));
    ЗаписатьJSON(Запись, Данные);
    Запись.Закрыть();
КонецПроцедуры
