// Original finite server dispatcher. Metadata: ServerCall=true, Privileged=false.
// Authentication/protection defaults are never modified. No raw errors exported.
Функция NativeВыполнить(ТокенЗапуска) Экспорт
    Контекст = Новый Структура("status,operation,phase", "error", "dispatch", "dispatch");
    Попытка
        NativeВыполнитьПроверенный(ТокенЗапуска, Контекст);
        Контекст.phase = "complete";
        Контекст.status = "ok";
    Исключение
        // Preserve only the last fixed phase, never inspect or export the error.
        Контекст.status = "error";
    КонецПопытки;
    Возврат Контекст;
КонецФункции

Процедура NativeВыполнитьПроверенный(ТокенЗапуска, Контекст)
    Если ПривилегированныйРежим() Тогда
        ВызватьИсключение "permission_mismatch";
    КонецЕсли;
    Контекст.phase = "control";
    Корень = @@EVIDENCE@@;
    Контроль = NativeПрочитатьJSON(Корень + "/control.json");
    Если ТипЗнч(Контроль) <> Тип("Структура") Тогда
        ВызватьИсключение "invalid_control";
    КонецЕсли;
    Если Контроль.Количество() <> 4 Или ТипЗнч(Контроль.schema) <> Тип("Число") Или Контроль.schema <> 1
        Или Контроль.nonce <> @@NONCE@@ Или Контроль.token <> ТокенЗапуска Тогда
        ВызватьИсключение "invalid_control";
    КонецЕсли;
    Если Контроль.operation <> "bootstrap" И Контроль.operation <> "audit" И Контроль.operation <> "observe"
        И Контроль.operation <> "create" И Контроль.operation <> "update" И Контроль.operation <> "delete" Тогда
        ВызватьИсключение "invalid_control";
    КонецЕсли;
    // Bind the operation only after the exact fresh control has been checked.
    Контекст.operation = Контроль.operation;
    Контекст.phase = "marker";
    ФайлРезультата = Новый Файл(Корень + "/result.json");
    Если ФайлРезультата.Существует() Тогда
        ВызватьИсключение "stale_evidence";
    КонецЕсли;
    Если Контроль.operation = "bootstrap" Тогда
        Результат = NativeПрочитатьJSON(Корень + "/bootstrap.json");
        Если Результат.schema <> 1 Или Результат.nonce <> @@NONCE@@ Или Результат.token <> ТокенЗапуска
            Или Результат.operation <> "bootstrap" Или Результат.status <> "ok"
            Или Результат.user <> "" Или Результат.role_verified <> Истина Или Результат.users_verified <> Истина
            Или Результат.nonprivileged <> Ложь Тогда
            ВызватьИсключение "invalid_marker";
        КонецЕсли;
        Контекст.phase = "metadata";
        NativeПроверитьМетаданные(Результат);
        Контекст.phase = "serialize";
        NativeЗаписатьJSON(Корень + "/result.json", Результат);
        Возврат;
    КонецЕсли;
    Контекст.phase = "metadata";
    Результат = NativeНовыйРезультат(Контроль);
    NativeПроверитьМетаданные(Результат);
    Контекст.phase = "identity";
    Текущий = ПользователиИнформационнойБазы.ТекущийПользователь();
    Если Контроль.operation = "audit" Тогда
        NativeПроверитьПользователя(Текущий, @@SETUP_USER@@, Метаданные.Роли.NativeOracleSetupAdministrator);
        NativeПроверитьВсехПользователей();
        Результат.user = @@SETUP_USER@@;
        Результат.role_verified = Истина;
        Результат.users_verified = Истина;
    Иначе
        NativeПроверитьПользователя(Текущий, @@CRUD_USER@@, Метаданные.Роли.NativeOracleCatalogCRUD);
        Если Текущий.Роли.Содержит(Метаданные.Роли.NativeOracleSetupAdministrator)
            Или ПравоДоступа("Администрирование", Метаданные)
            Или ПравоДоступа("АдминистрированиеДанных", Метаданные) Тогда
            ВызватьИсключение "permission_mismatch";
        КонецЕсли;
        Результат.user = @@CRUD_USER@@;
        Результат.role_verified = Истина;
        // No privileged user-list enumeration from a CRUD identity.
        Результат.users_verified = Ложь;
        NativeИзмерить(Контроль.operation, Результат, Корень, Контекст);
    КонецЕсли;
    Контекст.phase = "identity";
    Если ПривилегированныйРежим() Тогда
        ВызватьИсключение "permission_mismatch";
    КонецЕсли;
    Результат.status = "ok";
    Контекст.phase = "serialize";
    NativeЗаписатьJSON(Корень + "/result.json", Результат);
КонецПроцедуры

Функция NativeНовыйРезультат(Контроль)
    Результат = Новый Структура;
    Результат.Вставить("schema", 1);
    Результат.Вставить("nonce", @@NONCE@@);
    Результат.Вставить("token", Контроль.token);
    Результат.Вставить("operation", Контроль.operation);
    Результат.Вставить("status", "error");
    Результат.Вставить("user", "");
    Результат.Вставить("role_verified", Ложь);
    Результат.Вставить("users_verified", Ложь);
    Результат.Вставить("nonprivileged", Истина);
    Для Каждого Поле Из СтрРазделить("metadata_version,payload_length,amount_digits,amount_scale,count,code,payload,amount,deletion_mark,same_reference", ",") Цикл
        Результат.Вставить(Поле, Неопределено);
    КонецЦикла;
    Информация = Новый СистемнаяИнформация;
    Результат.Вставить("actual_version", Информация.ВерсияПриложения);
    Возврат Результат;
КонецФункции

Процедура NativeПроверитьПользователя(Пользователь, Имя, Роль)
    Если Пользователь = Неопределено Тогда
        ВызватьИсключение "permission_mismatch";
    КонецЕсли;
    Если Пользователь.Имя <> Имя Или Не Пользователь.Роли.Содержит(Роль) Тогда
        ВызватьИсключение "permission_mismatch";
    КонецЕсли;
    Количество = 0;
    Для Каждого НазначеннаяРоль Из Пользователь.Роли Цикл
        Количество = Количество + 1;
    КонецЦикла;
    Если Количество <> 1 Тогда
        ВызватьИсключение "permission_mismatch";
    КонецЕсли;
КонецПроцедуры

Процедура NativeПроверитьВсехПользователей()
    Пользователи = ПользователиИнформационнойБазы.ПолучитьПользователей();
    Если Пользователи.Количество() <> 2 Тогда
        ВызватьИсключение "permission_mismatch";
    КонецЕсли;
    NativeПроверитьПользователя(ПользователиИнформационнойБазы.НайтиПоИмени(@@SETUP_USER@@), @@SETUP_USER@@, Метаданные.Роли.NativeOracleSetupAdministrator);
    NativeПроверитьПользователя(ПользователиИнформационнойБазы.НайтиПоИмени(@@CRUD_USER@@), @@CRUD_USER@@, Метаданные.Роли.NativeOracleCatalogCRUD);
КонецПроцедуры

Процедура NativeПроверитьМетаданные(Результат)
    Если Метаданные.Справочники.Количество() <> 1 Или Метаданные.Роли.Количество() <> 2
        Или Метаданные.ОбщиеМодули.Количество() <> 1
        Или Метаданные.Документы.Количество() <> 0 Или Метаданные.РегистрыСведений.Количество() <> 0
        Или Метаданные.РегистрыНакопления.Количество() <> 0 Или Метаданные.РегистрыБухгалтерии.Количество() <> 0
        Или Метаданные.РегистрыРасчета.Количество() <> 0 Или Метаданные.РегламентныеЗадания.Количество() <> 0
        Или Метаданные.ПодпискиНаСобытия.Количество() <> 0 Или Метаданные.Константы.Количество() <> 0
        Или Метаданные.Обработки.Количество() <> 0 Или Метаданные.Отчеты.Количество() <> 0 Тогда
        ВызватьИсключение "metadata_mismatch";
    КонецЕсли;
    Каталог = Метаданные.Справочники.NativeOracleItems;
    Если Каталог.Реквизиты.Количество() <> 2 Или Каталог.ТабличныеЧасти.Количество() <> 0
        Или Каталог.Иерархический Или Каталог.ДлинаКода <> 2 Или Каталог.ДлинаНаименования <> 0 Тогда
        ВызватьИсключение "metadata_mismatch";
    КонецЕсли;
    ТипСтроки = Каталог.Реквизиты.Payload.Тип;
    ТипЧисла = Каталог.Реквизиты.Amount.Тип;
    Если ТипСтроки.Типы().Количество() <> 1 Или Не ТипСтроки.СодержитТип(Тип("Строка"))
        Или ТипЧисла.Типы().Количество() <> 1 Или Не ТипЧисла.СодержитТип(Тип("Число")) Тогда
        ВызватьИсключение "metadata_mismatch";
    КонецЕсли;
    Длина = ТипСтроки.КвалификаторыСтроки.Длина;
    Разрядность = ТипЧисла.КвалификаторыЧисла.Разрядность;
    Масштаб = ТипЧисла.КвалификаторыЧисла.РазрядностьДробнойЧасти;
    Если (Длина <> 32 И Длина <> 64) Или Разрядность <> 9 Или Масштаб <> 2
        Или ТипЧисла.КвалификаторыЧисла.ДопустимыйЗнак <> ДопустимыйЗнак.Любой Тогда
        ВызватьИсключение "metadata_mismatch";
    КонецЕсли;
    Результат.metadata_version = ?(Длина = 32, 1, 2);
    Результат.payload_length = Длина;
    Результат.amount_digits = Разрядность;
    Результат.amount_scale = Масштаб;
КонецПроцедуры

Процедура NativeИзмерить(Операция, Результат, Корень, Контекст)
    Контекст.phase = "readback";
    До = NativeСостояние(Корень);
    Контекст.phase = "precondition";
    Если Операция = "create" Тогда
        Если До.count <> 0 Или ТипЗнч(До.same_reference) <> Тип("Неопределено") Тогда
            ВызватьИсключение "logical_mismatch";
        КонецЕсли;
        Контекст.phase = "begin";
        НачатьТранзакцию();
        Попытка
            Контекст.phase = "create_object";
            Объект = Справочники.NativeOracleItems.СоздатьЭлемент();
            Контекст.phase = "set_code";
            Объект.Код = "K1";
            Контекст.phase = "set_payload";
            Объект.Payload = "alpha";
            Контекст.phase = "set_amount";
            Объект.Amount = 1.25;
            Контекст.phase = "write";
            Объект.Записать();
            Контекст.phase = "reference_capture";
            Ссылка = Объект.Ссылка;
            Контекст.phase = "commit";
            ЗафиксироватьТранзакцию();
        Исключение
            ОтменитьТранзакцию();
            ВызватьИсключение "process_failed";
        КонецПопытки;
        Контекст.phase = "reference_uuid";
        ЗначениеСсылки = Строка(Ссылка.УникальныйИдентификатор());
        Контекст.phase = "reference_write";
        ДанныеСсылки = Новый Структура("nonce,reference", @@NONCE@@, ЗначениеСсылки);
        NativeЗаписатьJSON(Корень + "/reference.json", ДанныеСсылки);
    ИначеЕсли Операция = "update" Или Операция = "delete" Тогда
        Если До.count <> 1 Или До.same_reference <> Истина Или До.deletion_mark <> Ложь Тогда
            ВызватьИсключение "logical_mismatch";
        КонецЕсли;
        Если Операция = "update" И (До.payload <> "alpha" Или До.amount <> "1.25") Тогда
            ВызватьИсключение "logical_mismatch";
        КонецЕсли;
        Если Операция = "delete" И (До.payload <> "beta" Или До.amount <> "-2.50") Тогда
            ВызватьИсключение "logical_mismatch";
        КонецЕсли;
        Контекст.phase = "begin";
        НачатьТранзакцию();
        Попытка
            Контекст.phase = "reference_read";
            Ссылка = NativeСохраненнаяСсылка(Корень);
            Контекст.phase = "get_object";
            Объект = Ссылка.ПолучитьОбъект();
            Если Объект = Неопределено Тогда
                ВызватьИсключение "logical_mismatch";
            КонецЕсли;
            Если Операция = "update" Тогда
                Контекст.phase = "set_payload";
                Объект.Payload = "beta";
                Контекст.phase = "set_amount";
                Объект.Amount = -2.50;
                Контекст.phase = "write";
                Объект.Записать();
            Иначе
                // Physical deletion, never merely a deletion mark.
                Контекст.phase = "delete_object";
                Объект.Удалить();
            КонецЕсли;
            Контекст.phase = "commit";
            ЗафиксироватьТранзакцию();
        Исключение
            ОтменитьТранзакцию();
            ВызватьИсключение "process_failed";
        КонецПопытки;
    КонецЕсли;
    Контекст.phase = "readback";
    После = NativeСостояние(Корень);
    Если Операция = "create" И (После.count <> 1 Или После.payload <> "alpha" Или После.amount <> "1.25" Или После.same_reference <> Истина) Тогда
        ВызватьИсключение "logical_mismatch";
    КонецЕсли;
    Если Операция = "update" И (После.count <> 1 Или После.payload <> "beta" Или После.amount <> "-2.50" Или После.same_reference <> Истина) Тогда
        ВызватьИсключение "logical_mismatch";
    КонецЕсли;
    Если Операция = "delete" И (После.count <> 0 Или После.same_reference <> Ложь) Тогда
        ВызватьИсключение "logical_mismatch";
    КонецЕсли;
    Для Каждого Поле Из После Цикл
        Результат[Поле.Ключ] = Поле.Значение;
    КонецЦикла;
КонецПроцедуры

Функция NativeСостояние(Корень)
    Результат = Новый Структура("count,code,payload,amount,deletion_mark,same_reference", 0, Неопределено, Неопределено, Неопределено, Неопределено, Неопределено);
    Сохраненная = NativeСохраненнаяСсылка(Корень);
    Если Сохраненная <> Неопределено Тогда
        // A fresh query by the saved reference must prove physical absence.
        Запрос = Новый Запрос("ВЫБРАТЬ Ссылка ИЗ Справочник.NativeOracleItems ГДЕ Ссылка = &Ссылка");
        Запрос.УстановитьПараметр("Ссылка", Сохраненная);
        Результат.same_reference = Не Запрос.Выполнить().Пустой();
    КонецЕсли;
    Выборка = Справочники.NativeOracleItems.Выбрать();
    Пока Выборка.Следующий() Цикл
        Результат.count = Результат.count + 1;
        Если Результат.count > 1 Или Выборка.Код <> "K1" Или Выборка.ПометкаУдаления Тогда
            ВызватьИсключение "logical_mismatch";
        КонецЕсли;
        Если Сохраненная = Неопределено Или Выборка.Ссылка <> Сохраненная Тогда
            ВызватьИсключение "logical_mismatch";
        КонецЕсли;
        Результат.code = "K1";
        Результат.deletion_mark = Ложь;
        Если Выборка.Payload = "alpha" И Выборка.Amount = 1.25 Тогда
            Результат.payload = "alpha";
            Результат.amount = "1.25";
        ИначеЕсли Выборка.Payload = "beta" И Выборка.Amount = -2.50 Тогда
            Результат.payload = "beta";
            Результат.amount = "-2.50";
        Иначе
            ВызватьИсключение "logical_mismatch";
        КонецЕсли;
    КонецЦикла;
    Если Результат.count = 0 И Результат.same_reference = Истина Тогда
        ВызватьИсключение "logical_mismatch";
    КонецЕсли;
    Возврат Результат;
КонецФункции

Функция NativeСохраненнаяСсылка(Корень)
    Файл = Новый Файл(Корень + "/reference.json");
    Если Не Файл.Существует() Тогда
        Возврат Неопределено;
    КонецЕсли;
    // Two fixed ASCII fields: 95 compact bytes, plus optional 3-byte UTF-8
    // BOM and at most 30 formatting bytes. No shared/report cap is raised.
    Если Файл.Размер() > 128 Или Файл.Размер() = 0 Тогда
        ВызватьИсключение "invalid_reference";
    КонецЕсли;
    Данные = NativeПрочитатьJSON(Корень + "/reference.json");
    Если ТипЗнч(Данные) <> Тип("Структура") Тогда
        ВызватьИсключение "invalid_reference";
    КонецЕсли;
    Если Данные.Количество() <> 2 Или Не Данные.Свойство("nonce") Или Не Данные.Свойство("reference") Тогда
        ВызватьИсключение "invalid_reference";
    КонецЕсли;
    // Structure property lookup ignores case; enumerate original spellings.
    Для Каждого Поле Из Данные Цикл
        Если Поле.Ключ <> "nonce" И Поле.Ключ <> "reference" Тогда
            ВызватьИсключение "invalid_reference";
        КонецЕсли;
    КонецЦикла;
    Если ТипЗнч(Данные.nonce) <> Тип("Строка") Или Данные.nonce <> @@NONCE@@
        Или ТипЗнч(Данные.reference) <> Тип("Строка") Тогда
        ВызватьИсключение "invalid_reference";
    КонецЕсли;
    Значение = Данные.reference;
    Если СтрДлина(Значение) <> 36 Тогда
        ВызватьИсключение "invalid_reference";
    КонецЕсли;
    Идентификатор = Новый УникальныйИдентификатор(Значение);
    Если Строка(Идентификатор) <> Значение Тогда
        ВызватьИсключение "invalid_reference";
    КонецЕсли;
    Возврат Справочники.NativeOracleItems.ПолучитьСсылку(Идентификатор);
КонецФункции

Функция NativeПрочитатьJSON(Путь)
    Файл = Новый Файл(Путь);
    Если Не Файл.Существует() Тогда
        ВызватьИсключение "invalid_control";
    КонецЕсли;
    Если Файл.Размер() = 0 Или Файл.Размер() > 4096 Тогда
        ВызватьИсключение "invalid_control";
    КонецЕсли;
    Чтение = Новый ЧтениеJSON;
    Чтение.ОткрытьФайл(Путь);
    Результат = ПрочитатьJSON(Чтение);
    Чтение.Закрыть();
    Возврат Результат;
КонецФункции

Процедура NativeЗаписатьJSON(Путь, Данные)
    Файл = Новый Файл(Путь);
    Если Файл.Существует() Тогда
        ВызватьИсключение "stale_evidence";
    КонецЕсли;
    Запись = Новый ЗаписьJSON;
    Запись.ОткрытьФайл(Путь);
    ЗаписатьJSON(Запись, Данные);
    Запись.Закрыть();
КонецПроцедуры
