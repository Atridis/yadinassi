// Original finite server dispatcher. Metadata: ServerCall=true, Privileged=false.
// Authentication/protection defaults are never modified. No raw errors exported.
Функция NativeВыполнить(ТокенЗапуска) Экспорт
    Контекст = Новый Структура("status,operation,phase", "error", "dispatch", "dispatch");
    Попытка
        NativeВыполнитьПроверенный(ТокенЗапуска, Контекст);
        Контекст.phase = "complete";
        Контекст.status = "ok";
    Исключение
        // Preserve only the last fixed phase, never inspect or export the error.
        Контекст.status = "error";
    КонецПопытки;
    Возврат Контекст;
КонецФункции

Процедура NativeВыполнитьПроверенный(ТокенЗапуска, Контекст)
    Если ПривилегированныйРежим() Тогда
        ВызватьИсключение "permission_mismatch";
    КонецЕсли;
    Контекст.phase = "control";
    Корень = @@EVIDENCE@@;
    Контроль = NativeПрочитатьJSON(Корень + "/control.json");
    Если ТипЗнч(Контроль) <> Тип("Структура") Тогда
        ВызватьИсключение "invalid_control";
    КонецЕсли;
    Если Контроль.Количество() <> 4 Или ТипЗнч(Контроль.schema) <> Тип("Число") Или Контроль.schema <> 1
        Или Контроль.nonce <> @@NONCE@@ Или Контроль.token <> ТокенЗапуска Тогда
        ВызватьИсключение "invalid_control";
    КонецЕсли;
    Если Контроль.operation <> "bootstrap" И Контроль.operation <> "audit" И Контроль.operation <> "audit_contract" И Контроль.operation <> "observe"
        И Контроль.operation <> "audit_record_metadata"
        И Контроль.operation <> "create" И Контроль.operation <> "update" И Контроль.operation <> "delete" Тогда
        ВызватьИсключение "invalid_control";
    КонецЕсли;
    // Bind the operation only after the exact fresh control has been checked.
    Контекст.operation = Контроль.operation;
    Контекст.phase = "marker";
    ФайлРезультата = Новый Файл(Корень + "/result.json");
    Если ФайлРезультата.Существует() Тогда
        ВызватьИсключение "stale_evidence";
    КонецЕсли;
    Если Контроль.operation = "bootstrap" Тогда
        Результат = NativeПрочитатьJSON(Корень + "/bootstrap.json");
        Если Результат.schema <> 1 Или Результат.nonce <> @@NONCE@@ Или Результат.token <> ТокенЗапуска
            Или Результат.operation <> "bootstrap" Или Результат.status <> "ok"
            Или Результат.user <> "" Или Результат.role_verified <> Истина Или Результат.users_verified <> Истина
            Или Результат.nonprivileged <> Ложь Тогда
            ВызватьИсключение "invalid_marker";
        КонецЕсли;
        Контекст.phase = "metadata";
        NativeПроверитьМетаданные(Результат);
        Контекст.phase = "serialize";
        NativeЗаписатьJSON(Корень + "/result.json", Результат);
        Возврат;
    КонецЕсли;
    Контекст.phase = "metadata";
    Результат = NativeНовыйРезультат(Контроль);
    NativeПроверитьМетаданные(Результат);
    Контекст.phase = "identity";
    Текущий = ПользователиИнформационнойБазы.ТекущийПользователь();
    Если Контроль.operation = "audit" Или Контроль.operation = "audit_contract"
        Или Контроль.operation = "audit_record_metadata" Тогда
        NativeПроверитьПользователя(Текущий, @@SETUP_USER@@, Метаданные.Роли.NativeOracleSetupAdministrator);
        NativeПроверитьВсехПользователей();
        Результат.user = @@SETUP_USER@@;
        Результат.role_verified = Истина;
        Результат.users_verified = Истина;
        Если Контроль.operation = "audit_contract" Тогда
            Если Результат.metadata_version <> 1 Тогда
                ВызватьИсключение "logical_mismatch";
            КонецЕсли;
            Результат.Вставить("storage_names", NativeИменаХранения(Контекст));
        ИначеЕсли Контроль.operation = "audit_record_metadata" Тогда
            Если Результат.metadata_version <> 1 Тогда
                ВызватьИсключение "logical_mismatch";
            КонецЕсли;
            Результат.Вставить("record_metadata", NativeМетаданныеЗаписи(Контекст));
        КонецЕсли;
    Иначе
        NativeПроверитьПользователя(Текущий, @@CRUD_USER@@, Метаданные.Роли.NativeOracleCatalogCRUD);
        Если Текущий.Роли.Содержит(Метаданные.Роли.NativeOracleSetupAdministrator)
            Или ПравоДоступа("Администрирование", Метаданные)
            Или ПравоДоступа("АдминистрированиеДанных", Метаданные) Тогда
            ВызватьИсключение "permission_mismatch";
        КонецЕсли;
        Результат.user = @@CRUD_USER@@;
        Результат.role_verified = Истина;
        // No privileged user-list enumeration from a CRUD identity.
        Результат.users_verified = Ложь;
        NativeИзмерить(Контроль.operation, Результат, Корень, Контекст);
    КонецЕсли;
    Контекст.phase = "identity";
    Если ПривилегированныйРежим() Тогда
        ВызватьИсключение "permission_mismatch";
    КонецЕсли;
    Результат.status = "ok";
    Контекст.phase = "serialize";
    NativeЗаписатьJSON(Корень + "/result.json", Результат);
КонецПроцедуры

// Exact filtered name projection. These three columns were measured in v3.
// Experiment: request the explicit second argument True; measure its result.
// No default-call retry, unfiltered fallback, type mapping, or scalar rendering.
Функция NativeИменаХранения(Контекст)
    Отбор = Новый Массив;
    Отбор.Добавить("Справочник.NativeOracleItems");
    Контекст.phase = "contract_call";
    Таблица = ПолучитьСтруктуруХраненияБазыДанных(Отбор, Истина);
    Контекст.phase = "contract_scan";
    Если ТипЗнч(Таблица) <> Тип("ТаблицаЗначений") Тогда
        ВызватьИсключение "invalid_marker";
    КонецЕсли;
    NativeИменаКолонка(Таблица, "ИмяТаблицыХранения", Тип("Строка"));
    NativeИменаКолонка(Таблица, "Поля", Тип("ТаблицаЗначений"));
    ЧислоТаблиц = Таблица.Количество();
    NativeИменаЛимит(ЧислоТаблиц > 0 И ЧислоТаблиц <= 4, Контекст);
    Проекция = Новый Структура("schema,target,tables", 1, "Справочник.NativeOracleItems", Новый Массив);
    Бюджет = Новый Структура("fields,units", 0, 0);
    ИменаТаблиц = Новый Массив;
    Для Каждого СтрокаТаблицы Из Таблица Цикл
        Имя = СтрокаТаблицы.ИмяТаблицыХранения;
        NativeИменаСтрока(Имя, Бюджет, Контекст);
        Если ИменаТаблиц.Найти(Имя) <> Неопределено Тогда
            ВызватьИсключение "invalid_marker";
        КонецЕсли;
        ИменаТаблиц.Добавить(Имя);
        Поля = СтрокаТаблицы.Поля;
        Если ТипЗнч(Поля) <> Тип("ТаблицаЗначений") Тогда
            ВызватьИсключение "invalid_marker";
        КонецЕсли;
        NativeИменаКолонка(Поля, "ИмяПоляХранения", Тип("Строка"));
        ЧислоПолей = Поля.Количество();
        NativeИменаЛимит(ЧислоПолей > 0 И ЧислоПолей <= 32 И Бюджет.fields + ЧислоПолей <= 64, Контекст);
        Бюджет.fields = Бюджет.fields + ЧислоПолей;
        Описание = Новый Структура("name,fields", Имя, Новый Массив);
        Для Каждого СтрокаПоля Из Поля Цикл
            ИмяПоля = СтрокаПоля.ИмяПоляХранения;
            NativeИменаСтрока(ИмяПоля, Бюджет, Контекст);
            Если Описание.fields.Найти(ИмяПоля) <> Неопределено Тогда
                ВызватьИсключение "invalid_marker";
            КонецЕсли;
            Описание.fields.Добавить(ИмяПоля);
        КонецЦикла;
        Проекция.tables.Добавить(Описание);
    КонецЦикла;
    Возврат Проекция;
КонецФункции

Процедура NativeИменаКолонка(Таблица, Имя, ОжидаемыйТип)
    Колонка = Таблица.Колонки.Найти(Имя);
    Если Колонка = Неопределено Тогда
        ВызватьИсключение "invalid_marker";
    КонецЕсли;
    Если Колонка.ТипЗначения.Типы().Количество() <> 1 Или Не Колонка.ТипЗначения.СодержитТип(ОжидаемыйТип) Тогда
        ВызватьИсключение "invalid_marker";
    КонецЕсли;
КонецПроцедуры

Процедура NativeИменаЛимит(Условие, Контекст)
    Контекст.phase = "contract_limit";
    Если Не Условие Тогда
        ВызватьИсключение "artifact_limit";
    КонецЕсли;
    Контекст.phase = "contract_scan";
КонецПроцедуры

Процедура NativeИменаСтрока(Значение, Бюджет, Контекст)
    Если ТипЗнч(Значение) <> Тип("Строка") Тогда
        ВызватьИсключение "invalid_marker";
    КонецЕсли;
    Длина = СтрДлина(Значение);
    NativeИменаЛимит(Длина > 0 И Длина <= 64 И Бюджет.units + Длина <= 512, Контекст);
    // BMP units are identical in Python and native BSL; escape overhead is bounded.
    Для Индекс = 1 По Длина Цикл
        Код = КодСимвола(Значение, Индекс);
        Если Код < 32 Или Код > 65535 Или (Код >= 55296 И Код <= 57343) Тогда
            ВызватьИсключение "invalid_marker";
        КонецЕсли;
    КонецЦикла;
    Бюджет.units = Бюджет.units + Длина;
КонецПроцедуры

Функция NativeНовыйРезультат(Контроль)
    Результат = Новый Структура;
    Результат.Вставить("schema", 1);
    Результат.Вставить("nonce", @@NONCE@@);
    Результат.Вставить("token", Контроль.token);
    Результат.Вставить("operation", Контроль.operation);
    Результат.Вставить("status", "error");
    Результат.Вставить("user", "");
    Результат.Вставить("role_verified", Ложь);
    Результат.Вставить("users_verified", Ложь);
    Результат.Вставить("nonprivileged", Истина);
    Для Каждого Поле Из СтрРазделить("metadata_version,payload_length,amount_digits,amount_scale,count,code,payload,amount,deletion_mark,same_reference", ",") Цикл
        Результат.Вставить(Поле, Неопределено);
    КонецЦикла;
    Информация = Новый СистемнаяИнформация;
    Результат.Вставить("actual_version", Информация.ВерсияПриложения);
    Возврат Результат;
КонецФункции

// Metadata-only observation, not logical mapping or record acceptance.
// No index/purpose/tablespace traversal, arbitrary rendering or fallback call.
Функция NativeМетаданныеЗаписи(Контекст)
    Отбор = Новый Массив;
    Отбор.Добавить("Справочник.NativeOracleItems");
    Контекст.phase = "record_call";
    Таблица = ПолучитьСтруктуруХраненияБазыДанных(Отбор, Истина);
    Контекст.phase = "record_scan";
    Если ТипЗнч(Таблица) <> Тип("ТаблицаЗначений") Тогда
        ВызватьИсключение "invalid_marker";
    КонецЕсли;
    NativeИменаКолонка(Таблица, "ИмяТаблицыХранения", Тип("Строка"));
    NativeИменаКолонка(Таблица, "ИмяТаблицы", Тип("Строка"));
    NativeИменаКолонка(Таблица, "Метаданные", Тип("Строка"));
    NativeИменаКолонка(Таблица, "Поля", Тип("ТаблицаЗначений"));
    NativeЗаписьЛимит(Таблица.Количество() = 1, Контекст);
    СтрокаТаблицы = Таблица.Получить(0);
    Поля = СтрокаТаблицы.Поля;
    Если ТипЗнч(Поля) <> Тип("ТаблицаЗначений") Тогда
        ВызватьИсключение "invalid_marker";
    КонецЕсли;
    NativeИменаКолонка(Поля, "ИмяПоляХранения", Тип("Строка"));
    NativeИменаКолонка(Поля, "ИмяПоля", Тип("Строка"));
    NativeИменаКолонка(Поля, "Метаданные", Тип("Строка"));
    NativeИменаКолонка(Поля, "ТипПоля", Тип("Строка"));
    ЧислоПолей = Поля.Количество();
    NativeЗаписьЛимит(ЧислоПолей >= 1 И ЧислоПолей <= 16, Контекст);
    // Compact ensure-ASCII JSON: envelope 179, each empty field 71, commas n-1.
    // Quotes and keys are included here; unchanged cell text is counted below.
    Бюджет = Новый Структура("units,bytes,ranges", 0, 179 + 71 * ЧислоПолей + ЧислоПолей - 1, NativeЗаписьПечатныеГраницы());
    Имя = СтрокаТаблицы.ИмяТаблицыХранения;
    Логическое = СтрокаТаблицы.ИмяТаблицы;
    МетаданныеСтрока = СтрокаТаблицы.Метаданные;
    NativeЗаписьСтрока(Имя, Истина, Бюджет, Контекст);
    NativeЗаписьСтрока(Логическое, Ложь, Бюджет, Контекст);
    NativeЗаписьСтрока(МетаданныеСтрока, Ложь, Бюджет, Контекст);
    Описание = Новый Структура("storage_name,logical_name,metadata_name,fields", Имя, Логическое, МетаданныеСтрока, Новый Массив);
    Ключи = Новый Массив;
    Для Каждого СтрокаПоля Из Поля Цикл
        ИмяПоля = СтрокаПоля.ИмяПоляХранения;
        ЛогическоеПоле = СтрокаПоля.ИмяПоля;
        МетаданныеПоля = СтрокаПоля.Метаданные;
        ТипТекст = СтрокаПоля.ТипПоля;
        Ключ = NativeЗаписьСтрока(ИмяПоля, Истина, Бюджет, Контекст);
        NativeЗаписьСтрока(ЛогическоеПоле, Ложь, Бюджет, Контекст);
        NativeЗаписьСтрока(МетаданныеПоля, Ложь, Бюджет, Контекст);
        NativeЗаписьСтрока(ТипТекст, Ложь, Бюджет, Контекст);
        // Full ASCII grammar precedes this temporary collision key. Raw values
        // remain unchanged; neither duplicates nor case collisions drop fields.
        Если Ключи.Найти(Ключ) <> Неопределено Тогда
            ВызватьИсключение "invalid_marker";
        КонецЕсли;
        Ключи.Добавить(Ключ);
        Описание.fields.Добавить(Новый Структура("storage_name,logical_name,metadata_name,type_text", ИмяПоля, ЛогическоеПоле, МетаданныеПоля, ТипТекст));
    КонецЦикла;
    NativeЗаписьЛимит(Бюджет.bytes <= 6144, Контекст);
    Возврат Новый Структура("schema,target,table", 1, "Справочник.NativeOracleItems", Описание);
КонецФункции

Процедура NativeЗаписьЛимит(Условие, Контекст)
    Контекст.phase = "record_limit";
    Если Не Условие Тогда
        ВызватьИсключение "artifact_limit";
    КонецЕсли;
    Контекст.phase = "record_scan";
КонецПроцедуры

Функция NativeЗаписьСтрока(Значение, Идентификатор, Бюджет, Контекст)
    Если ТипЗнч(Значение) <> Тип("Строка") Тогда
        ВызватьИсключение "invalid_marker";
    КонецЕсли;
    Длина = СтрДлина(Значение);
    NativeЗаписьЛимит(Длина <= 64 И Бюджет.units + Длина <= 768, Контекст);
    Если Идентификатор И Длина = 0 Тогда
        ВызватьИсключение "invalid_marker";
    КонецЕсли;
    Ключ = "";
    Байт = 0;
    Для Индекс = 1 По Длина Цикл
        Код = КодСимвола(Значение, Индекс);
        Если Не NativeЗаписьПечатный(Код, Бюджет.ranges) Тогда
            ВызватьИсключение "invalid_marker";
        КонецЕсли;
        Если Идентификатор Тогда
            Если Не (Код = 95 Или (Код >= 65 И Код <= 90) Или (Код >= 97 И Код <= 122)
                Или (Индекс > 1 И Код >= 48 И Код <= 57)) Тогда
                ВызватьИсключение "invalid_marker";
            КонецЕсли;
            // Explicit ASCII-only collision key, never locale/Unicode folding.
            КодКлюча = ?(Код >= 97 И Код <= 122, Код - 32, Код);
            Ключ = Ключ + Символ(КодКлюча);
        КонецЕсли;
        Если Код > 126 Тогда
            Байт = Байт + 6;
        ИначеЕсли Код = 34 Или Код = 92 Тогда
            Байт = Байт + 2;
        Иначе
            Байт = Байт + 1;
        КонецЕсли;
    КонецЦикла;
    NativeЗаписьЛимит(Бюджет.bytes + Байт <= 6144, Контекст);
    Бюджет.units = Бюджет.units + Длина;
    Бюджет.bytes = Бюджет.bytes + Байт;
    Возврат Ключ;
КонецФункции

Функция NativeЗаписьПечатный(Код, Границы)
    Если Код >= 32 И Код <= 126 Тогда
        Возврат Истина;
    КонецЕсли;
    Если Код < 161 Или Код > 65533 Тогда
        Возврат Ложь;
    КонецЕсли;
    Лево = 0;
    Право = Границы.Количество() / 2 - 1;
    Пока Лево <= Право Цикл
        Середина = Цел((Лево + Право) / 2);
        Если Код < Границы[2 * Середина] Тогда
            Право = Середина - 1;
        ИначеЕсли Код > Границы[2 * Середина + 1] Тогда
            Лево = Середина + 1;
        Иначе
            Возврат Истина;
        КонецЕсли;
    КонецЦикла;
    Возврат Ложь;
КонецФункции

Функция NativeЗаписьПечатныеГраницы()
    // Frozen Unicode 15.0.0 BMP printable ranges, including ASCII space only.
    // Exclude Cc/Cf/Cs/Co/Cn and Zl/Zp/Zs; no normalization or platform inference.
    // Closed, sorted pairs are binary-searched. The constants are not cell data.
    ГраницыТекст = "32,126,161,172,174,887,890,895,900,906,908,908,910,929,931,1327,1329,1366,"
        + "1369,1418,1421,1423,1425,1479,1488,1514,1519,1524,1542,1563,1565,1756,1758,1805,1808,1866,"
        + "1869,1969,1984,2042,2045,2093,2096,2110,2112,2139,2142,2142,2144,2154,2160,2190,2200,2273,"
        + "2275,2435,2437,2444,2447,2448,2451,2472,2474,2480,2482,2482,2486,2489,2492,2500,2503,2504,"
        + "2507,2510,2519,2519,2524,2525,2527,2531,2534,2558,2561,2563,2565,2570,2575,2576,2579,2600,"
        + "2602,2608,2610,2611,2613,2614,2616,2617,2620,2620,2622,2626,2631,2632,2635,2637,2641,2641,"
        + "2649,2652,2654,2654,2662,2678,2689,2691,2693,2701,2703,2705,2707,2728,2730,2736,2738,2739,"
        + "2741,2745,2748,2757,2759,2761,2763,2765,2768,2768,2784,2787,2790,2801,2809,2815,2817,2819,"
        + "2821,2828,2831,2832,2835,2856,2858,2864,2866,2867,2869,2873,2876,2884,2887,2888,2891,2893,"
        + "2901,2903,2908,2909,2911,2915,2918,2935,2946,2947,2949,2954,2958,2960,2962,2965,2969,2970,"
        + "2972,2972,2974,2975,2979,2980,2984,2986,2990,3001,3006,3010,3014,3016,3018,3021,3024,3024,"
        + "3031,3031,3046,3066,3072,3084,3086,3088,3090,3112,3114,3129,3132,3140,3142,3144,3146,3149,"
        + "3157,3158,3160,3162,3165,3165,3168,3171,3174,3183,3191,3212,3214,3216,3218,3240,3242,3251,"
