// Standalone private post-commit witness. No expected seed comparison.
Процедура NativeDescriptionObserve(Корень, ТокенЗапуска, Операция)
    Сохраненная = NativeСохраненнаяСсылка(Корень);
    Выборка = Справочники.NativeOracleItems.Выбрать();
    Есть = Выборка.Следующий();
    Наименование = "";
    Если Есть Тогда
        Если Выборка.Ссылка <> Сохраненная Или Выборка.ПометкаУдаления Тогда
            ВызватьИсключение "logical_mismatch";
        КонецЕсли;
        Наименование = Выборка.Наименование;
        Если ТипЗнч(Наименование) <> Тип("Строка") Или СтрДлина(Наименование) > 128 Тогда
            ВызватьИсключение "logical_mismatch";
        КонецЕсли;
        Если Выборка.Следующий() Тогда
            ВызватьИсключение "logical_mismatch";
        КонецЕсли;
    КонецЕсли;
    Путь = Корень + "/description-observation.json";
    ФайлНаблюдения = Новый Файл(Путь);
    Если ФайлНаблюдения.Существует() Тогда
        ВызватьИсключение "stale_evidence";
    КонецЕсли;
    Данные = Новый Структура("schema,nonce,token,case,operation,present,actual_description",
        2, @@NONCE@@, ТокенЗапуска, "@@DESCRIPTION_CASE@@", Операция, Есть, Наименование);
    NativeЗаписатьJSON(Путь, Данные);
КонецПроцедуры
