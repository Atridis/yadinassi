// New observation only. No expected native order is assumed.
// á and ä below are deliberately decomposed.
Функция КодыЛатинскойПробы(Знач Текст)
    Коды = "";
    Для Номер = 1 По СтрДлина(Текст) Цикл
        Если Номер > 1 Тогда Коды = Коды + "+"; КонецЕсли;
        Коды = Коды + Строка(КодСимвола(Текст, Номер));
    КонецЦикла;
    Возврат Коды;
КонецФункции

Процедура НаблюдатьЛатинскуюСортировку(Знач Ключи, Знач Метка, Знач Порядок)
    Таблица = Новый ТаблицаЗначений;
    Таблица.Колонки.Добавить("Key");
    Таблица.Колонки.Добавить("ID");
    Ссылки = Новый Массив;
    Для Каждого Ключ Из Ключи Цикл
        СтрокаТаблицы = Таблица.Добавить();
        СтрокаТаблицы.Key = Ключ;
        Ссылки.Добавить(СтрокаТаблицы);
        СтрокаТаблицы.ID = Ссылки.Количество();
    КонецЦикла;

    Если Порядок <> "" Тогда Таблица.Сортировать(Порядок); КонецЕсли;
    Запись = "value-table.latin-sort.v1|" + Метка;
    Сохранены = Истина;
    Для Каждого СтрокаТаблицы Из Таблица Цикл
        Номер = СтрокаТаблицы.ID;
        Если СтрокаТаблицы <> Ссылки[Номер - 1] Тогда Сохранены = Ложь; КонецЕсли;
        Запись = Запись + "|" + Строка(Номер) + ":" + КодыЛатинскойПробы(СтрокаТаблицы.Key);
    КонецЦикла;
    Сообщить(Запись + ?(Сохранены, "|same-rows", "|changed-rows"));
КонецПроцедуры

Ключи = СтрРазделить("ß|Á| |ą|A|ñ|á|ä|c|a |â|a-|ł|à|a|á|ã|č|-|ä|å|l|n|ss|ö|ü", "|");
НаблюдатьЛатинскуюСортировку(Ключи, "input", "");
НаблюдатьЛатинскуюСортировку(Ключи, "asc", "Key Возр");
НаблюдатьЛатинскуюСортировку(Ключи, "desc", "Key Убыв");
НаблюдатьЛатинскуюСортировку(Ключи, "asc-id-asc", "Key Возр, ID Возр");
НаблюдатьЛатинскуюСортировку(Ключи, "asc-id-desc", "Key Возр, ID Убыв");
Сообщить("value-table.latin-sort.v1|complete");
