&НаКлиенте
Процедура ПриОткрытии(Отказ)

    // /C содержит путь к request.json, подготовленному Python.
    Попытка

        Чтение = Новый ЧтениеJSON;
        Чтение.ОткрытьФайл(ПараметрЗапуска);
        Запрос = ПрочитатьJSON(Чтение);
        Чтение.Закрыть();

        ПослеСоздания = Ложь;
        Запрос.Свойство("post_create", ПослеСоздания);
        Если ТипЗнч(ПослеСоздания) <> Тип("Булево") Тогда
            ВызватьИсключение "Invalid post-create request";
        КонецЕсли;

        Попытка
            Результат = ЗапуститьТестНаСервере(Запрос.module, ПослеСоздания);
        Исключение
            Результат = Новый Структура(
                "messages,error",
                Новый Массив,
                ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
        КонецПопытки;

        Запись = Новый ЗаписьJSON;
        Запись.ОткрытьФайл(Запрос.result);
        ЗаписатьJSON(Запись, Результат);
        Запись.Закрыть();

    Исключение
        // При сбое протокола Python обнаружит отсутствие result.json.
        Сообщить(ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
    КонецПопытки;

    ЗавершитьРаботуСистемы(Ложь);

КонецПроцедуры


&НаСервереБезКонтекста
Функция ЗапуститьТестНаСервере(Знач ПутьМодуля, Знач ПослеСоздания = Ложь)

    Если ТипЗнч(ПослеСоздания) <> Тип("Булево") Тогда
        ВызватьИсключение "Invalid post-create request";
    КонецЕсли;

    ПолучитьСообщенияПользователю(Истина);
    ОшибкаТеста = "";

    Попытка

        // Создание объекта исполняет основной код его модуля.
        // Тест компилируется целиком: процедуры и функции разрешены.
        ОбъектТеста = ВнешниеОбработки.Создать(ПутьМодуля, Ложь);
        Если ПослеСоздания Тогда
            Сообщить("export-phase.post-create: [begin]");
            Попытка
                // A fixed public call on the actual successfully created receiver.
                ОбъектТеста.ExportProbeAfterCreate(ОбъектТеста);
                Сообщить("export-phase.post-create: [ok]");
            Исключение
                Описание = ИнформацияОбОшибке().Описание;
                ВидОшибки = "other";
                Если СтрНайти(Описание, "Метод объекта не обнаружен") > 0 Тогда
                    ВидОшибки = "method-missing";
                КонецЕсли;
                ИмяМетода = СтрНайти(НРег(Описание), "exportprobeaftercreate") > 0;
                Сообщить("export-phase.post-create: [error;kind=" + ВидОшибки
                    + ";named=" + ЗначениеВСтрокуВнутр(ИмяМетода) + "]");
            КонецПопытки;
        КонецЕсли;

    Исключение
        ОшибкаТеста = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
    КонецПопытки;

    // Забираем также сообщения, выведенные до ошибки теста.
    СообщенияТеста = ПолучитьСообщенияПользователю(Истина);
    ТекстыСообщений = Новый Массив;

    Для Каждого СообщениеТеста Из СообщенияТеста Цикл
        ТекстыСообщений.Добавить(СообщениеТеста.Текст);
    КонецЦикла;

    Возврат Новый Структура("messages,error", ТекстыСообщений, ОшибкаТеста);

КонецФункции
