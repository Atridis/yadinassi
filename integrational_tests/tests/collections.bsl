// Коллекции: записи, индекс, фиксированные снимки и обратные копии. Эталон получает только 1С.
Перем Выход;

#Область ВспомогательныеПроцедуры

// Три независимых контроля удаления: ошибка не скрывает конечный состав.
Процедура ПроверитьУдалениеЗаГраницей(Знач Метка)
    Данные = Новый Массив;
    Если Метка <> "empty" Тогда
        Данные.Добавить("Я😀");
        Данные.Добавить(7);
    КонецЕсли;
    Статус = "ok";
    Попытка
        Если Метка = "empty" Тогда
            Данные.Удалить(0);
        ИначеЕсли Метка = "above-bound" Тогда
            Данные.Delete(2);
        Иначе
            Данные.Удалить(100);
            Данные.Delete(0);
        КонецЕсли;
    Исключение
        Статус = "error";
    КонецПопытки;
    Запись = Статус + ";" + ЗначениеВСтрокуВнутр(Данные.Количество())
        + ";" + ЗначениеВСтрокуВнутр(Данные.ВГраница());
    Если Данные.Количество() > 0 Тогда
        Запись = Запись + ";" + ЗначениеВСтрокуВнутр(Данные[0]);
    КонецЕсли;
    Если Данные.Количество() > 1 Тогда
        Запись = Запись + ";" + ЗначениеВСтрокуВнутр(Данные[1]);
    КонецЕсли;
    Показать("array-delete.control." + Метка, Запись);
КонецПроцедуры


// ЗаполнитьЗначенияСвойств: пересечение и спорные дополнительные списки.
// В каждом случае новый приемник; ошибки не скрывают возможную частичную запись.
Процедура ПроверитьЗаполнениеСвойств(Знач Метка)
    Приемник = Новый Структура("Имя,Счет", "старое", 5);
    Источник = Новый Структура("имя,Счет,Лишнее", "Я😀", 9, 42);
    Статус = "ok";
    Попытка
        Если Метка = "intersection" Тогда
            ЗаполнитьЗначенияСвойств(Приемник, Источник);
        ИначеЕсли Метка = "fixed-source" Тогда
            FillPropertyValues(Приемник, Новый ФиксированнаяСтруктура(Источник));
        ИначеЕсли Метка = "include" Тогда
            ЗаполнитьЗначенияСвойств(Приемник, Источник, "Имя");
        ИначеЕсли Метка = "exclude" Тогда
            ЗаполнитьЗначенияСвойств(Приемник, Источник, , "Имя");
        ИначеЕсли Метка = "unknown-include" Тогда
            ЗаполнитьЗначенияСвойств(Приемник, Источник, "Имя,НетТакогоСвойства");
        ИначеЕсли Метка = "undefined-list" Тогда
            ЗаполнитьЗначенияСвойств(Приемник, Источник, Неопределено);
        ИначеЕсли Метка = "invalid-source" Тогда
            ЗаполнитьЗначенияСвойств(Приемник, 1);
        ИначеЕсли Метка = "fixed-target" Тогда
            Приемник = Новый ФиксированнаяСтруктура(Приемник);
            ЗаполнитьЗначенияСвойств(Приемник, Источник);
        КонецЕсли;
    Исключение
        Статус = "error";
    КонецПопытки;
    Показать("fill." + Метка, Статус + ";" + ЗначениеВСтрокуВнутр(Приемник.Имя)
        + ";" + ЗначениеВСтрокуВнутр(Приемник.Счет)
        + ";" + ЗначениеВСтрокуВнутр(Приемник.Количество()));
КонецПроцедуры

// Скалярные записи сохраняют типы и позиции без многострочного контейнерного формата.
Процедура ПоказатьСоставМассива(Знач Метка, Знач Массив)
    Запись = ЗначениеВСтрокуВнутр(Массив.Количество());
    Для Каждого Элемент Из Массив Цикл
        Запись = Запись + ";" + ЗначениеВСтрокуВнутр(Элемент);
    КонецЦикла;
    Показать(Метка, Запись);
КонецПроцедуры

// ЗначениеЗаполнено: только короткие булевы записи или переносимый маркер ошибки.
Процедура ПроверитьЗаполненность(Знач Метка, Знач Значение)
    Попытка
        Показать(Метка, ЗначениеВСтрокуВнутр(ЗначениеЗаполнено(Значение))
            + ";" + ЗначениеВСтрокуВнутр(ValueIsFilled(Значение)));
    Исключение
        Показать(Метка, "error");
    КонецПопытки;
КонецПроцедуры

Процедура Показать(Знач Метка, Знач Значение)
    Сообщить(Метка + ": [" + Строка(Значение) + "]");
КонецПроцедуры

// Восстановленный объект возвращается для отдельной проверки общей ссылки.
Процедура ПоказатьВнутреннее(Знач Метка, Знач Значение, Восстановлено = Неопределено)
    Восстановлено = Неопределено;
    Попытка
        Запись = ЗначениеВСтрокуВнутр(Значение);
        Показать(Метка + ".payload", Запись);
    Исключение
        Показать(Метка + ".error", ОписаниеОшибки());
        Возврат;
    КонецПопытки;
    Попытка
        Восстановлено = ЗначениеИзСтрокиВнутр(Запись);
        Вид = ТипЗнч(Значение);
        ПоказатьБулево(Метка + ".roundtrip.type", ТипЗнч(Восстановлено) = Вид);
        Если Вид = Тип("Type") Тогда
            ПоказатьБулево(Метка + ".roundtrip.value", Восстановлено = Значение);
        ИначеЕсли Вид = Тип("KeyAndValue") Тогда
            ПоказатьБулево(Метка + ".roundtrip.key", Восстановлено.Ключ = Значение.Ключ);
            ПоказатьБулево(Метка + ".roundtrip.value", Восстановлено.Значение = Значение.Значение);
        Иначе
            ПоказатьБулево(Метка + ".roundtrip.count", Восстановлено.Количество() = Значение.Количество());
        КонецЕсли;
        // Сырой повторный вывод: возможная смена порядка не означает потерю данных.
        Показать(Метка + ".roundtrip.payload", ЗначениеВСтрокуВнутр(Восстановлено));
    Исключение
        Показать(Метка + ".roundtrip.error", ОписаниеОшибки());
    КонецПопытки;
КонецПроцедуры

// Равенство фиксированных значений само по себе не доказывает общую ссылку.
// Для изменяемых контейнеров дополнительно наблюдаем распространение изменения.
Процедура ПоказатьВосстановленныеСсылки(Знач Метка, Знач Пара)
    Если ТипЗнч(Пара) <> Тип("Array") Тогда Возврат; КонецЕсли;
    Попытка
        ПоказатьБулево(Метка + ".restored-pair-equal", Пара[0] = Пара[1]);
        Вид = ТипЗнч(Пара[0]);
        До = Пара[1].Количество();
        Если Вид = Тип("Array") Тогда
            Пара[0].Добавить("roundtrip-change");
        ИначеЕсли Вид = Тип("Structure") Или Вид = Тип("Map") Тогда
            Пара[0].Вставить("RoundtripChange", Истина);
        Иначе
            Возврат;
        КонецЕсли;
        ПоказатьБулево(Метка + ".shared-after-change", Пара[1].Количество() <> До);
    Исключение
        Показать(Метка + ".identity.error", ОписаниеОшибки());
    КонецПопытки;
КонецПроцедуры

Процедура ПоказатьБулево(Знач Метка, Знач Значение)
    Показать(Метка, ?(Значение, "true", "false"));
КонецПроцедуры

// Одинаковое содержимое и повтор одной ссылки исследуются раздельно.
Процедура ПоказатьВнутренниеСсылки(Знач Метка, Знач Первое, Знач ТакоеЖе)
    Повтор = Новый Массив;
    Повтор.Добавить(Первое);
    Повтор.Добавить(Первое);
    Копии = Новый Массив;
    Копии.Добавить(Первое);
    Копии.Добавить(ТакоеЖе);
    ВосстановленныйПовтор = Неопределено;
    ВосстановленныеКопии = Неопределено;
    ПоказатьВнутреннее(Метка + ".repeated-reference", Повтор, ВосстановленныйПовтор);
    ПоказатьВнутреннее(Метка + ".independent-equal", Копии, ВосстановленныеКопии);
    ПоказатьВосстановленныеСсылки(Метка + ".repeated-reference", ВосстановленныйПовтор);
    ПоказатьВосстановленныеСсылки(Метка + ".independent-equal", ВосстановленныеКопии);
    Показать(Метка + ".present", Строка(Первое));
КонецПроцедуры

Процедура ПолучитьПозиции(Знач Заказ, Результат)
    Заказ.Свойство("Позиции", Результат);
КонецПроцедуры

Процедура ДобавитьПозицию(Знач Позиции)
    Позиции.Добавить(Новый Структура("Код,Цена,Количество", "в", 4, 1));
    Позиции = Новый Массив; // Переприсваивание Знач не заменяет массив вызывающего.
КонецПроцедуры

#Region FixedCollectionProbes
// Для спорных операций сохраняем исход, а не локализованный текст исключения.
Функция РезультатРавенства(Знач Левое, Знач Правое)
    Попытка
        Возврат ?(Левое = Правое, "true", "false");
    Исключение
        Возврат "error";
    КонецПопытки;
КонецФункции

Процедура ПоказатьПоиск(Знач Метка, Знач Значения, Знач Искомое)
    Попытка
        Показать(Метка, Значения.Найти(Искомое));
    Исключение
        Показать(Метка, "error");
    КонецПопытки;
КонецПроцедуры

Функция ПрочитатьКлюч(Знач Словарь, Знач Ключ)
    Попытка
        Результат = Словарь.Получить(Ключ);
        Возврат ?(Результат = Неопределено, "missing", Строка(Результат));
    Исключение
        Возврат "error";
    КонецПопытки;
КонецФункции

Процедура ИсследоватьФиксированное(Знач Метка, Знач Первое, Знач ТакоеЖе, Знач Другое)
    Ссылка = Первое;
    Показать(Метка + ".equal-alias", РезультатРавенства(Первое, Ссылка));
    Показать(Метка + ".equal-copy", РезультатРавенства(Первое, ТакоеЖе));
    Показать(Метка + ".equal-different", РезультатРавенства(Первое, Другое));
    Значения = Новый Массив;
    Значения.Добавить(Первое);
    ПоказатьПоиск(Метка + ".find-alias", Значения, Ссылка);
    ПоказатьПоиск(Метка + ".find-copy", Значения, ТакоеЖе);
    Попытка
        Если ТипЗнч(Первое) = Тип("FixedArray") Тогда
            Копия = Новый ФиксированныйМассив(Первое);
        ИначеЕсли ТипЗнч(Первое) = Тип("FixedStructure") Тогда
            Копия = Новый ФиксированнаяСтруктура(Первое);
        Иначе
            Копия = Новый ФиксированноеСоответствие(Первое);
        КонецЕсли;
        Показать(Метка + ".fixed-source-count", Копия.Количество());
        ПоказатьБулево(Метка + ".fixed-source-type", ТипЗнч(Копия) = ТипЗнч(Первое));
    Исключение
        Показать(Метка + ".fixed-source", "error");
    КонецПопытки;
    // Вставка, чтение и удаление исследуются независимо, даже если ключ запрещен.
    Ключи = Новый Соответствие;
    Попытка
        Ключи.Вставить(Первое, 1);
        Показать(Метка + ".key-insert", "accepted");
    Исключение
        Показать(Метка + ".key-insert", "error");
    КонецПопытки;
    Показать(Метка + ".key-alias", ПрочитатьКлюч(Ключи, Ссылка));
    Показать(Метка + ".key-copy", ПрочитатьКлюч(Ключи, ТакоеЖе));
    Попытка
        Ключи.Вставить(ТакоеЖе, 2);
        Показать(Метка + ".key-reinsert", "accepted");
    Исключение
        Показать(Метка + ".key-reinsert", "error");
    КонецПопытки;
    Показать(Метка + ".key-count", Ключи.Количество());
    Показать(Метка + ".key-original-value", ПрочитатьКлюч(Ключи, Первое));
    Создан = Ложь;
    Попытка
        СнимокКлючей = Новый ФиксированноеСоответствие(Ключи);
        Создан = Истина;
    Исключение
        Показать(Метка + ".key-fixed-map-source", "error");
    КонецПопытки;
    Попытка
        Ключи.Удалить(Ссылка);
        Показать(Метка + ".key-delete", "accepted");
    Исключение
        Показать(Метка + ".key-delete", "error");
    КонецПопытки;
    Показать(Метка + ".key-after-delete", Ключи.Количество());
    Если Создан Тогда
        Показать(Метка + ".key-fixed-map", ПрочитатьКлюч(СнимокКлючей, Первое));
    КонецЕсли;
КонецПроцедуры

#EndRegion
#КонецОбласти

// Начало компактных проб Sort/GroupBy.
// Это постоянные регрессии поведения, не дампы исследования внутреннего кодека.
Функция ЗначенияОперацийТаблицы(Знач Текст)
    Возврат СтрРазделить(Текст, "|", Ложь);
КонецФункции

Функция СсылкаПослеОперации(Знач Таблица, Знач СтрокаТаблицы)
    Итог = Новый Структура("Owner,Index,Cells,Key,Amount,Discard,SameRow");
    Попытка Итог.Owner = СтрокаТаблицы.Owner() = Таблица; Исключение Итог.Owner = "[error]"; КонецПопытки;
    Попытка Итог.Index = Таблица.IndexOf(СтрокаТаблицы); Исключение Итог.Index = "[error]"; КонецПопытки;
    Попытка Итог.Cells = ПоляСтрокиПробы(СтрокаТаблицы); Исключение Итог.Cells = "[error]"; КонецПопытки;
    Попытка Итог.Key = СтрокаТаблицы.Key; Исключение Итог.Key = "[error]"; КонецПопытки;
    Попытка Итог.Amount = СтрокаТаблицы.Amount; Исключение Итог.Amount = "[error]"; КонецПопытки;
    Попытка Итог.Discard = СтрокаТаблицы.Discard; Исключение Итог.Discard = "[error]"; КонецПопытки;
    Попытка
        Позиция = Таблица.IndexOf(СтрокаТаблицы);
        Итог.SameRow = Ложь;
        Если Позиция >= 0 Тогда Итог.SameRow = Таблица[Позиция] = СтрокаТаблицы; КонецЕсли;
    Исключение Итог.SameRow = "[error]"; КонецПопытки;
    Возврат Итог;
КонецФункции

Функция СортировкаТаблицыПробы(Знач Набор, Знач Порядок, Знач Сравнение = "omitted")
    Таблица = Вычислить("Новый ТаблицаЗначений");
    Колонки = Таблица.Columns;
    Колонки.Add("Key"); Колонки.Add("Second"); Колонки.Add("ID");
    Ключи = Новый Массив;
    Если Набор = "locale" Тогда
        Ключи = ЗначенияОперацийТаблицы("я|е|Ё|Е|ё|a|A|á|a |a-1|a1|a10|a2| |!|😀|Я|");
    ИначеЕсли Набор = "utf16-boundary" Тогда
        Ключи = ЗначенияОперацийТаблицы("я|😀|😁|𐀀|");
    ИначеЕсли Набор = "mixed" Тогда
        Ключи.Add("2"); Ключи.Add(2); Ключи.Add(Истина); Ключи.Add(Неопределено);
        Ключи.Add(Дата(2024, 1, 1)); Ключи.Add(Null); Ключи.Add(Ложь);
        Ключи.Add(-1); Ключи.Add(""); Ключи.Add(Дата(2023, 1, 1));
        Ключи.Add(Null); Ключи.Add(Неопределено); Ключи.Add(Истина); Ключи.Add(2); Ключи.Add("2");
    ИначеЕсли Набор = "objects" Тогда
        Ключи.Add(Новый Структура("A", 2)); Ключи.Add(Новый Массив);
        Ключи.Add(Новый Структура("A", 1)); Ключи.Add(Новый Массив);
        Ключи.Add(Тип("Число")); Ключи.Add(Тип("Строка"));
    ИначеЕсли Набор = "singleton" Тогда Ключи.Add(1);
    ИначеЕсли Набор <> "empty" Тогда
        Ключи.Add(2); Ключи.Add(1); Ключи.Add(2); Ключи.Add(1); Ключи.Add(2); Ключи.Add(1);
    КонецЕсли;
    Для Номер = 0 По Ключи.Count() - 1 Цикл
        СтрокаТаблицы = Таблица.Add();
        СтрокаТаблицы.Key = Ключи[Номер]; СтрокаТаблицы.ID = Номер + 1;
        СтрокаТаблицы.Second = ?(Номер = 1 Или Номер = 4, 2, 1);
    КонецЦикла;
    Первая = Неопределено;
    Если Таблица.Count() > 0 Тогда Первая = Таблица[0]; КонецЕсли;
    Итог = Новый Структура("Status,Order,FirstIndex,FirstID,SameRow", "invoking");
    Попытка
        Если Сравнение = "missing" Тогда Таблица.Sort();
        ИначеЕсли Сравнение = "undefined" Тогда Таблица.Sort(Порядок, Неопределено);
        ИначеЕсли Сравнение = "invalid" Тогда Таблица.Sort(Порядок, 1);
        ИначеЕсли Сравнение = "russian" Тогда Таблица.Сортировать(Порядок);
        Иначе Таблица.Sort(Порядок);
        КонецЕсли;
        Итог.Status = "ok";
    Исключение Итог.Status = "error";
    КонецПопытки;
    Попытка Итог.Order = Таблица.UnloadColumn("ID"); Исключение Итог.Order = "[error]"; КонецПопытки;
    Если Первая <> Неопределено Тогда
        Попытка Итог.FirstIndex = Таблица.IndexOf(Первая); Исключение Итог.FirstIndex = "[error]"; КонецПопытки;
        Попытка Итог.FirstID = Первая.ID; Исключение Итог.FirstID = "[error]"; КонецПопытки;
        Попытка
            Итог.SameRow = Ложь;
            Позиция = Таблица.IndexOf(Первая);
            Если Позиция >= 0 Тогда Итог.SameRow = Таблица[Позиция] = Первая; КонецЕсли;
        Исключение Итог.SameRow = "[error]"; КонецПопытки;
    КонецЕсли;
    Возврат Итог;
КонецФункции

Функция СверткаТаблицыПробы(Знач Набор, Знач Группы, Знач Суммы = "omitted")
    Таблица = Вычислить("Новый ТаблицаЗначений");
    Колонки = Таблица.Columns;
    Колонки.Add("Key", , "Key title", 12); Колонки.Add("Second");
    Описание = Новый ОписаниеТипов;
    Если Набор = "number" Тогда Описание = Новый ОписаниеТипов("Число");
    ИначеЕсли Набор = "qualified" Тогда Описание = Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(2, 0));
    ИначеЕсли Набор = "string" Или Набор = "bad-string" Тогда Описание = Новый ОписаниеТипов("Строка");
    ИначеЕсли Набор = "boolean" Тогда Описание = Новый ОписаниеТипов("Булево");
    ИначеЕсли Набор = "date" Тогда Описание = Новый ОписаниеТипов("Дата");
    ИначеЕсли Набор = "multi-number" Тогда Описание = Новый ОписаниеТипов("Число,Строка");
    ИначеЕсли Набор = "multi-no-number" Тогда Описание = Новый ОписаниеТипов("Булево,Строка");
    КонецЕсли;
    Колонки.Add("Amount", Описание, "Amount title", 9); Колонки.Add("Discard");
    Ключи = ЗначенияОперацийТаблицы("B|A|B|C");
    Если Набор = "null-undefined" Тогда
        Ключи = Новый Массив; Ключи.Add(Null); Ключи.Add(Неопределено); Ключи.Add(Null); Ключи.Add(Неопределено);
    ИначеЕсли Набор = "case" Тогда Ключи = ЗначенияОперацийТаблицы("a|A|a |A");
    ИначеЕсли Набор = "mixed-keys" Тогда
        Ключи = Новый Массив; Ключи.Add(1); Ключи.Add("1"); Ключи.Add(Истина); Ключи.Add(1);
    КонецЕсли;
    Если Набор <> "empty" Тогда
        Для Номер = 0 По 3 Цикл
            СтрокаТаблицы = Таблица.Add(); СтрокаТаблицы.Key = Ключи[Номер];
            СтрокаТаблицы.Second = ?(Номер = 2, "y", "x"); СтрокаТаблицы.Discard = Номер + 1;
            Если Набор = "string" Или Набор = "bad-string" Тогда
                СтрокаТаблицы.Amount = ?(Набор = "bad-string" И Номер = 2, "bad", Строка(Номер + 2));
            ИначеЕсли Набор = "boolean" Тогда СтрокаТаблицы.Amount = Номер <> 1;
            ИначеЕсли Набор = "date" Тогда СтрокаТаблицы.Amount = Дата(2024, 1, Номер + 1);
            ИначеЕсли Набор = "qualified" Тогда СтрокаТаблицы.Amount = 99;
            ИначеЕсли Набор = "multi-no-number" Тогда СтрокаТаблицы.Amount = ?(Номер = 2, Истина, "2");
            ИначеЕсли Набор = "multi-number" Тогда СтрокаТаблицы.Amount = ?(Номер = 2 Или Номер = 3, "4", Номер + 2);
            ИначеЕсли Набор = "untyped-mixed" Тогда
                Если Номер = 0 Тогда СтрокаТаблицы.Amount = 2;
                ИначеЕсли Номер = 1 Тогда СтрокаТаблицы.Amount = Истина;
                ИначеЕсли Номер = 2 Тогда СтрокаТаблицы.Amount = "4";
                Иначе СтрокаТаблицы.Amount = Null; КонецЕсли;
            Иначе СтрокаТаблицы.Amount = Номер + 2;
            КонецЕсли;
        КонецЦикла;
    КонецЕсли;
    Первая = Неопределено; Третья = Неопределено; Вторая = Неопределено;
    Если Таблица.Count() > 0 Тогда Первая = Таблица[0]; Третья = Таблица[2]; Вторая = Таблица[1]; КонецЕсли;
    КолонкаКлюча = Колонки[0]; КолонкаСуммы = Колонки[2]; УдаляемаяКолонка = Колонки[3];
    Итог = Новый Структура("Status,After", "invoking");
    Попытка
        Если Суммы = "omitted" Тогда Таблица.GroupBy(Группы);
        ИначеЕсли Набор = "russian" Тогда Таблица.Свернуть(Группы, Суммы);
        Иначе Таблица.GroupBy(Группы, Суммы);
        КонецЕсли;
        Итог.Status = "ok";
    Исключение Итог.Status = "error";
    КонецПопытки;
    Итог.After = ПоляТаблицыПробы(Таблица);
    Если Набор = "references" Тогда
        Итог.Insert("First", СсылкаПослеОперации(Таблица, Первая));
        Итог.Insert("Third", СсылкаПослеОперации(Таблица, Третья));
        Итог.Insert("Second", СсылкаПослеОперации(Таблица, Вторая));
        Итог.Insert("Schema", ВидОбъектаТаблицы(Колонки));
        Попытка Итог.Insert("KeyIndex", Колонки.IndexOf(КолонкаКлюча)); Исключение Итог.Insert("KeyIndex", "[error]"); КонецПопытки;
        Попытка Итог.Insert("AmountIndex", Колонки.IndexOf(КолонкаСуммы)); Исключение Итог.Insert("AmountIndex", "[error]"); КонецПопытки;
        Попытка Итог.Insert("RemovedIndex", Колонки.IndexOf(УдаляемаяКолонка)); Исключение Итог.Insert("RemovedIndex", "[error]"); КонецПопытки;
        Попытка Итог.Insert("RemovedName", УдаляемаяКолонка.Name); Исключение Итог.Insert("RemovedName", "[error]"); КонецПопытки;
        Попытка Первая.Key = "changed"; Итог.Insert("Write", "ok"); Исключение Итог.Insert("Write", "error"); КонецПопытки;
        Итог.Insert("AfterWrite", ПоляТаблицыПробы(Таблица));
    КонецЕсли;
    Если Набор = "qualified" Тогда
        Попытка Итог.Insert("SameColumn", Колонки.Find("Amount") = КолонкаСуммы); Исключение Итог.Insert("SameColumn", "[error]"); КонецПопытки;
        Попытка
            ТекущаяКолонка = Колонки.Find("Amount");
            Итог.Insert("ColumnType", ТекущаяКолонка.ValueType.Types());
        Исключение Итог.Insert("ColumnType", "[error]"); КонецПопытки;
        Попытка
            Квалификаторы = ТекущаяКолонка.ValueType.NumberQualifiers;
            Итог.Insert("Digits", Квалификаторы.Digits); Итог.Insert("FractionDigits", Квалификаторы.FractionDigits);
        Исключение Итог.Insert("Qualifiers", "[error]"); КонецПопытки;
    КонецЕсли;
    Возврат Итог;
КонецФункции
// Короткое уточнение живого обхода удаленной строки и порядка приведения итогов.
Функция НаблюдениеУдаленнойСтроки(Знач Таблица, Знач Удаленная, Знач Первая)
    Итог = Новый Структура("Owner,Index,Get,Items,Status", Неопределено, Неопределено, Неопределено, Новый Массив, "ok");
    Попытка Итог.Owner = Удаленная.Owner() = Таблица; Исключение Итог.Owner = "[error]"; КонецПопытки;
    Попытка Итог.Index = Таблица.IndexOf(Удаленная); Исключение Итог.Index = "[error]"; КонецПопытки;
    Попытка Итог.Get = Удаленная.Get(0); Исключение Итог.Get = "[error]"; КонецПопытки;
    Попытка
        Для Каждого Элемент Из Удаленная Цикл
            Если Итог.Items.Count() >= 8 Тогда Итог.Status = "bounded"; Прервать; КонецЕсли;
            Поля = Новый Структура("Type,IsRemoved,IsFirst,Index,Owner,Key,Amount");
            Поля.Type = ТипЗнч(Элемент);
            Попытка Поля.IsRemoved = Элемент = Удаленная; Исключение Поля.IsRemoved = "[error]"; КонецПопытки;
            Попытка Поля.IsFirst = Элемент = Первая; Исключение Поля.IsFirst = "[error]"; КонецПопытки;
            Попытка Поля.Index = Таблица.IndexOf(Элемент); Исключение Поля.Index = "[error]"; КонецПопытки;
            Попытка Поля.Owner = Элемент.Owner() = Таблица; Исключение Поля.Owner = "[error]"; КонецПопытки;
            Попытка Поля.Key = Элемент.Key; Исключение Поля.Key = "[error]"; КонецПопытки;
            Попытка Поля.Amount = Элемент.Amount; Исключение Поля.Amount = "[error]"; КонецПопытки;
            Итог.Items.Add(Поля);
        КонецЦикла;
    Исключение Итог.Status = "error"; КонецПопытки;
    Возврат Итог;
КонецФункции

Функция УдаленнаяПослеСверткиПробы(Знач Групп, Знач Действие)
    Таблица = Вычислить("Новый ТаблицаЗначений"); Колонки = Таблица.Columns;
    Колонки.Add("Key"); Колонки.Add("Amount");
    Для Номер = 0 По Групп Цикл
        СтрокаТаблицы = Таблица.Add(); СтрокаТаблицы.Key = ?(Номер = 0, 1, Номер); СтрокаТаблицы.Amount = Номер + 10;
    КонецЦикла;
    Первая = Таблица[0]; Удаленная = Таблица[1];
    Итог = Новый Структура("Status,After,BeforeAdd,AfterAdd,AfterClear", "ok");
    Попытка
        Если Действие = "delete" Тогда Таблица.Delete(Удаленная);
        Иначе Таблица.GroupBy("Key", "Amount"); КонецЕсли;
    Исключение Итог.Status = "error"; КонецПопытки;
    Итог.After = ПоляТаблицыПробы(Таблица);
    Итог.BeforeAdd = НаблюдениеУдаленнойСтроки(Таблица, Удаленная, Первая);
    СтрокаТаблицы = Таблица.Add(); СтрокаТаблицы.Key = 9; СтрокаТаблицы.Amount = 99;
    Итог.AfterAdd = НаблюдениеУдаленнойСтроки(Таблица, Удаленная, Первая);
    Таблица.Clear();
    Итог.AfterClear = НаблюдениеУдаленнойСтроки(Таблица, Удаленная, Первая);
    Возврат Итог;
КонецФункции

Функция ПорядокИтоговСверткиПробы(Знач Сценарий)
    Таблица = Вычислить("Новый ТаблицаЗначений"); Колонки = Таблица.Columns; Колонки.Add("Key");
    Если Сценарий = "clamp" Тогда Описание = Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(2, 0));
    Иначе Описание = Новый ОписаниеТипов("Строка"); КонецЕсли;
    Колонки.Add("Amount", Описание);
    Для Номер = 0 По 2 Цикл
        СтрокаТаблицы = Таблица.Add();
        Если Сценарий = "clamp" Тогда СтрокаТаблицы.Key = 1; СтрокаТаблицы.Amount = ?(Номер = 2, -99, 99);
        Иначе
            СтрокаТаблицы.Key = Номер;
            Если Номер = 0 Тогда СтрокаТаблицы.Amount = "002";
            ИначеЕсли Номер = 1 Тогда СтрокаТаблицы.Amount = " 3 ";
            Иначе СтрокаТаблицы.Amount = "bad"; КонецЕсли;
        КонецЕсли;
    КонецЦикла;
    Итог = Новый Структура("Status,After", "ok");
    Попытка Таблица.GroupBy("Key", "Amount"); Исключение Итог.Status = "error"; КонецПопытки;
    Итог.After = ПоляТаблицыПробы(Таблица);
    Возврат Итог;
КонецФункции
// Конец компактных проб Sort/GroupBy.

// Нативный checkpoint ТаблицыЗначений: без придуманных ответов.
// Конструктор нового семейства исполняется только через защищенный Вычислить.
// Все свойства/методы используют переменные-получатели; New().member нет.
// Разделители коллекций структурные; строковые скаляры сохраняют кавычки
// внутреннего формата. Сначала экранируется обратная косая черта, затем CR/LF/TAB.
Функция КомпактноеЗначениеТаблицы(Знач Значение)
    Если ТипЗнч(Значение) = Тип("Массив") Тогда
        Части = Новый Массив;
        Для Каждого Элемент Из Значение Цикл
            Части.Добавить(КомпактноеЗначениеТаблицы(Элемент));
        КонецЦикла;
        Возврат "[" + СтрСоединить(Части, "; ") + "]";
    ИначеЕсли ТипЗнч(Значение) = Тип("Структура") Тогда
        Части = Новый Массив;
        Для Каждого Пара Из Значение Цикл
            Части.Добавить(КомпактноеЗначениеТаблицы(Пара.Ключ) + "=" + КомпактноеЗначениеТаблицы(Пара.Значение));
        КонецЦикла;
        Возврат "{" + СтрСоединить(Части, "; ") + "}";
    КонецЕсли;
    Текст = ЗначениеВСтрокуВнутр(Значение);
    Текст = СтрЗаменить(Текст, "\", "\\");
    Текст = СтрЗаменить(Текст, Символ(13), "\r");
    Текст = СтрЗаменить(Текст, Символ(10), "\n");
    Текст = СтрЗаменить(Текст, Символ(9), "\t");
    Возврат Текст;
КонецФункции

// Именованные поля раскрываются построчно, массивы сохраняют порядок в строке.
Процедура ДобавитьПоляВыводаТаблицы(СтрокиВывода, Знач Путь, Знач Значение)
    Если ТипЗнч(Значение) = Тип("Структура") И Значение.Количество() > 0 Тогда
        Для Каждого Поле Из Значение Цикл
            ДобавитьПоляВыводаТаблицы(СтрокиВывода, Путь + "." + Поле.Ключ, Поле.Значение);
        КонецЦикла;
    Иначе
        СтрокиВывода.Добавить("  " + Путь + "=" + КомпактноеЗначениеТаблицы(Значение));
    КонецЕсли;
КонецПроцедуры

Функция КонструкторТаблицыПробы(Знач Объект)
    Возврат Новый Структура("Type,Text,View", ТипЗнч(Объект), Строка(Объект), ВидОбъектаТаблицы(Объект));
КонецФункции

Процедура НаблюдатьТаблицы(Знач Метка, Знач Выражение)
    Попытка
        Результат = Вычислить(Выражение);
    Исключение
        Сообщить("table." + Метка + ": [error]");
        Возврат;
    КонецПопытки;
    Попытка
        Если ТипЗнч(Результат) = Тип("Структура") Тогда
            СтрокиВывода = Новый Массив;
            СтрокиВывода.Добавить("table." + Метка + ": [");
            Для Каждого Поле Из Результат Цикл
                ДобавитьПоляВыводаТаблицы(СтрокиВывода, Поле.Ключ, Поле.Значение);
            КонецЦикла;
            СтрокиВывода.Добавить("]");
            Сообщить(СтрСоединить(СтрокиВывода, Символ(10)));
        Иначе
            Сообщить("table." + Метка + ": [" + КомпактноеЗначениеТаблицы(Результат) + "]");
        КонецЕсли;
    Исключение
        Сообщить("table." + Метка + ": [serialize-error]");
    КонецПопытки;
КонецПроцедуры

Функция НоваяТаблицаПробы()
    Таблица = Вычислить("Новый ТаблицаЗначений");
    Колонки = Таблица.Колонки;
    Колонки.Добавить("Имя");
    Колонки.Добавить("Число", Новый ОписаниеТипов("Число"));
    Для Индекс = 1 По 3 Цикл
        СтрокаТаблицы = Таблица.Добавить();
        СтрокаТаблицы.Имя = "row" + Строка(Индекс);
        СтрокаТаблицы.Число = Индекс;
    КонецЦикла;
    Возврат Таблица;
КонецФункции

// Наблюдаемые поля выводятся отдельно от непрозрачных внутренних потоков.
Функция ПоляКолонкиПробы(Знач Колонка)
    Возврат Новый Структура("Name,Title,Width,ValueType",
        Колонка.Имя, Колонка.Заголовок, Колонка.Ширина, Колонка.ТипЗначения);
КонецФункции

Функция ПоляСтрокиПробы(Знач СтрокаТаблицы)
    Значения = Новый Массив;
    Для Каждого Ячейка Из СтрокаТаблицы Цикл
        Значения.Добавить(Ячейка);
    КонецЦикла;
    Возврат Значения;
КонецФункции

Функция ПоляТаблицыПробы(Знач Таблица)
    Поля = Новый Массив;
    Для Каждого Колонка Из Таблица.Колонки Цикл
        Поля.Добавить(Колонка.Имя);
    КонецЦикла;
    Строки = Новый Массив;
    Для Каждого СтрокаТаблицы Из Таблица Цикл
        Строки.Добавить(ПоляСтрокиПробы(СтрокаТаблицы));
    КонецЦикла;
    Возврат Новый Структура("Count,Names,Rows", Таблица.Количество(), Поля, Строки);
КонецФункции

Функция ВидОбъектаТаблицы(Знач Объект)
    Если ТипЗнч(Объект) = Тип("Массив") Тогда
        ИтогМассива = Новый Массив;
        Для Каждого Элемент Из Объект Цикл
            ИтогМассива.Добавить(ВидОбъектаТаблицы(Элемент));
        КонецЦикла;
        Возврат ИтогМассива;
    ИначеЕсли ТипЗнч(Объект) = Тип("ТаблицаЗначений") Тогда
        Возврат ПоляТаблицыПробы(Объект);
    ИначеЕсли ТипЗнч(Объект) = Тип("СтрокаТаблицыЗначений") Тогда
        Возврат ПоляСтрокиПробы(Объект);
    ИначеЕсли ТипЗнч(Объект) = Тип("КолонкаТаблицыЗначений") Тогда
        Возврат ПоляКолонкиПробы(Объект);
    ИначеЕсли ТипЗнч(Объект) = Тип("КоллекцияКолонокТаблицыЗначений") Тогда
        Поля = Новый Массив;
        Для Каждого Колонка Из Объект Цикл
            Поля.Добавить(ПоляКолонкиПробы(Колонка));
        КонецЦикла;
        Возврат Поля;
    КонецЕсли;
    Возврат Объект;
КонецФункции

// Каждая стадия защищена независимо; ошибка codec не скрывает поля/тип.
Функция КодекТаблицыПробы(Знач Объект)
    Итог = Новый Структура("Type,Text,View,TypeWrite,TypeRead,Write,ReadType,ReadWrite,ReadView,Equal,Nested");
    Попытка Итог.Type = ТипЗнч(Объект); Исключение Итог.Type = "[error]"; КонецПопытки;
    Попытка Итог.Text = Строка(Объект); Исключение Итог.Text = "[error]"; КонецПопытки;
    Попытка Итог.View = ВидОбъектаТаблицы(Объект); Исключение Итог.View = "[error]"; КонецПопытки;
    Попытка Итог.TypeWrite = ЗначениеВСтрокуВнутр(ТипЗнч(Объект)); Исключение Итог.TypeWrite = "[error]"; КонецПопытки;
    Попытка
        ПрочитанныйТип = ЗначениеИзСтрокиВнутр(Итог.TypeWrite);
        Итог.TypeRead = Новый Структура("Type,Equal,Stable", ТипЗнч(ПрочитанныйТип), ПрочитанныйТип = Итог.Type, ЗначениеВСтрокуВнутр(ПрочитанныйТип) = Итог.TypeWrite);
    Исключение Итог.TypeRead = "[error]"; КонецПопытки;
    Попытка Итог.Write = ЗначениеВСтрокуВнутр(Объект); Исключение Итог.Write = "[error]"; КонецПопытки;
    Попытка
        Копия = ЗначениеИзСтрокиВнутр(Итог.Write);
        Попытка Итог.ReadType = ТипЗнч(Копия); Исключение Итог.ReadType = "[error]"; КонецПопытки;
        Попытка
            ПовторнаяЗапись = ЗначениеВСтрокуВнутр(Копия);
            Итог.ReadWrite = ?(ПовторнаяЗапись = Итог.Write, "same-as-Write", ПовторнаяЗапись);
        Исключение Итог.ReadWrite = "[error]"; КонецПопытки;
        Попытка Итог.ReadView = ВидОбъектаТаблицы(Копия); Исключение Итог.ReadView = "[error]"; КонецПопытки;
        Попытка Итог.Equal = Копия = Объект; Исключение Итог.Equal = "[error]"; КонецПопытки;
    Исключение Итог.ReadType = "[error]";
    КонецПопытки;
    // Запись вложения сохраняется даже при ошибке последующего чтения/снимка.
    Вложение = Новый Структура("Write,ReadType,ReadView,ReadWrite");
    Итог.Nested = Вложение;
    Контейнер = Новый Массив;
    Контейнер.Добавить(Объект);
    Попытка Вложение.Write = ЗначениеВСтрокуВнутр(Контейнер); Исключение Вложение.Write = "[error]"; КонецПопытки;
    Попытка
        КопияКонтейнера = ЗначениеИзСтрокиВнутр(Вложение.Write);
        Попытка Вложение.ReadType = ТипЗнч(КопияКонтейнера); Исключение Вложение.ReadType = "[error]"; КонецПопытки;
        Попытка Вложение.ReadView = ВидОбъектаТаблицы(КопияКонтейнера); Исключение Вложение.ReadView = "[error]"; КонецПопытки;
        Попытка
            ПовторнаяЗапись = ЗначениеВСтрокуВнутр(КопияКонтейнера);
            Вложение.ReadWrite = ?(ПовторнаяЗапись = Вложение.Write, "same-as-Write", ПовторнаяЗапись);
        Исключение Вложение.ReadWrite = "[error]"; КонецПопытки;
    Исключение Вложение.ReadType = "[error]";
    КонецПопытки;
    Возврат Итог;
КонецФункции

Функция ОбъектТаблицыПробы(Знач ИмяОбъекта)
