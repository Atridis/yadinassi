Вложение.Добавить(Новый ФиксированноеСоответствие(СмешанныеКлючи));
ВосстановленноеВложение = Неопределено;
ПоказатьВнутреннее("internal.array.nested", Вложение, ВосстановленноеВложение);
Если ТипЗнч(ВосстановленноеВложение) = Тип("Array") Тогда
    Попытка
        ПоказатьБулево("internal.nested.structure-type", ТипЗнч(ВосстановленноеВложение[0]) = Тип("Structure"));
        ПоказатьБулево("internal.nested.fixed-structure-type", ТипЗнч(ВосстановленноеВложение[1]) = Тип("FixedStructure"));
        ПоказатьБулево("internal.nested.fixed-map-type", ТипЗнч(ВосстановленноеВложение[2]) = Тип("FixedMap"));
        ПоказатьБулево("internal.nested.record-value", ВосстановленноеВложение[0].Код = 7 И ВосстановленноеВложение[0].Пустое = Неопределено);
        ПоказатьБулево("internal.nested.string-value", ВосстановленноеВложение[1].Массив[4] = "а,""б""");
        ПоказатьБулево("internal.nested.map-value", ВосстановленноеВложение[1].Словарь["ключ"] = 7);
        ПоказатьБулево("internal.nested.typed-keys", ВосстановленноеВложение[2][Ложь] = "boolean" И ВосстановленноеВложение[2][0] = "number");
    Исключение
        Показать("internal.nested.roundtrip.error", ОписаниеОшибки());
    КонецПопытки;
КонецЕсли;

ИменаТипов = СтрРазделить("Undefined,Boolean,Number,String,Array,Structure,Map,FixedArray,FixedStructure,FixedMap,KeyAndValue,Type", ",");
Для Каждого ИмяТипа Из ИменаТипов Цикл
    ПоказатьВнутреннее("internal.type." + ИмяТипа, Тип(ИмяТипа));
КонецЦикла;
Показать("present.type.string", Строка(Тип("Число")));
Контейнеры = Новый Массив;
Контейнеры.Добавить(Новый Структура("Ключ", 7));
Контейнеры.Добавить(Новый ФиксированнаяСтруктура("Ключ", 7));
Контейнеры.Добавить(Словарь);
Контейнеры.Добавить(Новый ФиксированноеСоответствие(Словарь));
Метки = СтрРазделить("structure,fixed-structure,map,fixed-map", ",");
Для Индекс = 0 По Контейнеры.Количество() - 1 Цикл
    Для Каждого Пара Из Контейнеры[Индекс] Цикл
        ПоказатьВнутреннее("internal.key-and-value." + Метки[Индекс], Пара);
        Показать("present.key-and-value." + Метки[Индекс], Строка(Пара));
    КонецЦикла;
КонецЦикла;
