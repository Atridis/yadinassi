        ИначеЕсли Сценарий = "row-wrong-number" Тогда
            СтрокаТаблицы.Число = "bad";
        ИначеЕсли Сценарий = "row-null-number" Тогда
            СтрокаТаблицы.Число = Null;
        ИначеЕсли Сценарий = "row-undefined-number" Тогда
            СтрокаТаблицы.Число = Неопределено;
        ИначеЕсли Сценарий = "row-missing-property" Тогда
            СтрокаТаблицы.Missing = 1;
        ИначеЕсли Сценарий = "row-index-out" Тогда
            СтрокаТаблицы[2] = 1;
        ИначеЕсли Сценарий = "row-delete-index" Тогда
            Таблица.Удалить(1);
        ИначеЕсли Сценарий = "row-delete-object" Тогда
            Таблица.Delete(СтрокаТаблицы);
        ИначеЕсли Сценарий = "row-delete-past" Тогда
            Таблица.Удалить(9);
        ИначеЕсли Сценарий = "row-delete-negative" Тогда
            Таблица.Delete(-1);
        ИначеЕсли Сценарий = "row-delete-foreign" Тогда
            Таблица.Delete(ДругаяСтрока);
        ИначеЕсли Сценарий = "row-move" Тогда
            Таблица.Сдвинуть(СтрокаТаблицы, 2);
        ИначеЕсли Сценарий = "row-move-wrap" Тогда
            Таблица.Move(0, 5);
        ИначеЕсли Сценарий = "row-move-negative" Тогда
            Таблица.Move(0, -1);
        ИначеЕсли Сценарий = "row-clear" Тогда
            Таблица.Очистить();
        ИначеЕсли Сценарий = "column-add" Тогда
            Результат = Колонки.Add("Новая", , "Заголовок", 12);
        ИначеЕсли Сценарий = "column-add-default" Тогда
            Результат = Колонки.Добавить();
        ИначеЕсли Сценарий = "column-add-duplicate" Тогда
            Результат = Колонки.Add("иМя");
        ИначеЕсли Сценарий = "column-add-invalid" Тогда
            Результат = Колонки.Добавить("bad name");
        ИначеЕсли Сценарий = "column-add-number-name" Тогда
            Результат = Колонки.Add(7);
        ИначеЕсли Сценарий = "column-add-invalid-type" Тогда
            Результат = Колонки.Add("Новая", "Строка");
        ИначеЕсли Сценарий = "column-insert" Тогда
            Результат = Колонки.Insert(1, "Новая");
        ИначеЕсли Сценарий = "column-insert-past" Тогда
            Результат = Колонки.Вставить(9, "Новая");
        ИначеЕсли Сценарий = "column-insert-negative" Тогда
            Результат = Колонки.Insert(-1, "Новая");
        ИначеЕсли Сценарий = "column-rename" Тогда
            Колонка.Name = "Другое"; Результат = СтрокаТаблицы.Другое;
        ИначеЕсли Сценарий = "column-rename-duplicate" Тогда
            Колонка.Имя = "ЧИСЛО";
        ИначеЕсли Сценарий = "column-rename-empty" Тогда
            Колонка.Имя = "";
        ИначеЕсли Сценарий = "column-title-width" Тогда
            Колонка.Title = "Я😀"; Колонка.Width = 7.9;
        ИначеЕсли Сценарий = "column-negative-width" Тогда
            Колонка.Ширина = -1;
        ИначеЕсли Сценарий = "column-readonly-type" Тогда
            Колонка.ValueType = Новый ОписаниеТипов("Строка");
        ИначеЕсли Сценарий = "columns-readonly" Тогда
            Таблица.Columns = ДругиеКолонки;
        ИначеЕсли Сценарий = "column-readonly-slot" Тогда
            Колонки[0] = ДругаяКолонка;
        ИначеЕсли Сценарий = "row-readonly-slot" Тогда
            Таблица[0] = ДругаяСтрока;
        ИначеЕсли Сценарий = "column-delete-name" Тогда
            Колонки.Delete("Имя");
        ИначеЕсли Сценарий = "column-delete-object" Тогда
            Колонки.Удалить(Колонка);
        ИначеЕсли Сценарий = "column-delete-index" Тогда
            Колонки.Delete(0);
        ИначеЕсли Сценарий = "column-delete-past" Тогда
            Колонки.Delete(9);
        ИначеЕсли Сценарий = "column-delete-foreign" Тогда
            Колонки.Delete(ДругаяКолонка);
        ИначеЕсли Сценарий = "column-move" Тогда
            Колонки.Сдвинуть(Колонка, 1);
        ИначеЕсли Сценарий = "column-move-wrap" Тогда
            Колонки.Move(0, 3);
        ИначеЕсли Сценарий = "column-clear" Тогда
            Колонки.Очистить();
        ИначеЕсли Сценарий = "column-method-name" Тогда
            Колонки.Add("Get"); СтрокаТаблицы.Get = "property"; Результат = Новый Структура("Property,Method", СтрокаТаблицы.Get, СтрокаТаблицы.Get(0));
        ИначеЕсли Сценарий = "untyped-mixed-total" Тогда
            СтрокаТаблицы.Имя = 1; СтрокаТаблицы = Таблица[1]; СтрокаТаблицы.Имя = 2; СтрокаТаблицы = Таблица[2]; СтрокаТаблицы.Имя = "3"; СтрокаТаблицы = Таблица.Add(); СтрокаТаблицы.Имя = Истина; СтрокаТаблицы = Таблица.Add(); СтрокаТаблицы.Имя = Null; Таблица.Add(); Результат = Таблица.Total("Имя");
        ИначеЕсли Сценарий = "column-delete-final" Тогда
            Колонки.Delete(1); Колонки.Delete(0);
        ИначеЕсли Сценарий = "column-add-typed-existing" Тогда
            Результат = Колонки.Add("Булево", Новый ОписаниеТипов("Булево"));
        ИначеЕсли Сценарий = "copy-empty-columns" Тогда
            Результат = Таблица.CopyColumns("");
        ИначеЕсли Сценарий = "fill-all" Тогда
            Таблица.ЗаполнитьЗначения(7);
        ИначеЕсли Сценарий = "fill-selection" Тогда
            Таблица.FillValues("text", "Имя");
        ИначеЕсли Сценарий = "fill-empty" Тогда
            Таблица.FillValues(8, "");
        ИначеЕсли Сценарий = "fill-unknown" Тогда
            Таблица.FillValues(8, "Имя,Нет");
        ИначеЕсли Сценарий = "fill-duplicate" Тогда
            Таблица.FillValues(9, "Число,Число");
        ИначеЕсли Сценарий = "load-short" Тогда
            Массив = Новый Массив; Массив.Добавить(7); Таблица.LoadColumn(Массив, "Число");
        ИначеЕсли Сценарий = "load-long" Тогда
            Массив = Новый Массив; Для Номер = 1 По 5 Цикл Массив.Добавить(Номер + 10); КонецЦикла; Таблица.ЗагрузитьКолонку(Массив, 1);
        ИначеЕсли Сценарий = "load-object-column" Тогда
            Массив = Новый Массив; Массив.Добавить("loaded"); Таблица.LoadColumn(Массив, Колонка);
        ИначеЕсли Сценарий = "load-invalid-values" Тогда
            Массив = Новый Массив; Массив.Добавить("bad"); Таблица.LoadColumn(Массив, "Число");
        ИначеЕсли Сценарий = "copy-all" Тогда
            Результат = Таблица.Скопировать();
        ИначеЕсли Сценарий = "copy-columns" Тогда
            Результат = Таблица.CopyColumns("Число,Имя");
        ИначеЕсли Сценарий = "copy-selected" Тогда
            Результат = Таблица.Copy(, "Число");
        ИначеЕсли Сценарий = "copy-filter" Тогда
            Результат = Таблица.Copy(Новый Структура("Имя", "row2"));
        ИначеЕсли Сценарий = "copy-rows" Тогда
            Массив = Новый Массив; Массив.Добавить(Таблица[2]); Массив.Добавить(Таблица[0]); Массив.Добавить(Таблица[0]); Результат = Таблица.Copy(Массив);
        ИначеЕсли Сценарий = "copy-foreign" Тогда
            Массив = Новый Массив; Массив.Добавить(ДругаяСтрока); Результат = Таблица.Copy(Массив);
        ИначеЕсли Сценарий = "copy-unknown-column" Тогда
            Результат = Таблица.CopyColumns("Имя,Нет");
        КонецЕсли;
    Исключение Статус = "error";
    КонецПопытки;
    ВидРезультата = Неопределено;
    Попытка ВидРезультата = ВидОбъектаТаблицы(Результат); Исключение ВидРезультата = "[error]"; КонецПопытки;
    Итог = Новый Структура("Status,Table,Result", Статус, Неопределено, ВидРезультата);
    Если Сценарий = "column-rename" Или Сценарий = "column-rename-duplicate" Или Сценарий = "column-rename-empty"
        Или Сценарий = "column-title-width" Или Сценарий = "column-negative-width" Или Сценарий = "column-readonly-type" Тогда
        Попытка Итог.Вставить("Column", ПоляКолонкиПробы(Колонка)); Исключение Итог.Вставить("Column", "[error]"); КонецПопытки;
    КонецЕсли;
    Попытка Итог.Table = ПоляТаблицыПробы(Таблица); Исключение Итог.Table = "[snapshot-error]"; КонецПопытки;
    Если ТипЗнч(Результат) = Тип("ТаблицаЗначений") Тогда
        Попытка Итог.Вставить("ResultSchema", ВидОбъектаТаблицы(Результат.Колонки)); Исключение Итог.Вставить("ResultSchema", "[error]"); КонецПопытки;
    КонецЕсли;
    Возврат Итог;
КонецФункции

Функция ТипизированнаяТаблицаПробы(Знач Описание, Знач Значение)
    Таблица = Вычислить("New ValueTable");
    Колонки = Таблица.Columns;
    Колонка = Колонки.Add("Value", Описание);
    СтрокаТаблицы = Таблица.Add();
    Умолчание = СтрокаТаблицы.Value;
    Статус = "ok";
    Попытка СтрокаТаблицы.Value = Значение; Исключение Статус = "error"; КонецПопытки;
    Итог = Новый Структура("Default,Status,Assigned,Total", Умолчание, Статус, СтрокаТаблицы.Value);
    Попытка Итог.Total = Таблица.Total("Value"); Исключение Итог.Total = "[error]"; КонецПопытки;
    Возврат Итог;
КонецФункции

Функция СвязиТаблицыПробы(Знач Сценарий)
    Таблица = НоваяТаблицаПробы();
    Колонки = Таблица.Columns;
    Колонка = Колонки[0];
    СтрокаТаблицы = Таблица[0];
    Итог = Новый Структура("Owner,SameRow,SameColumn,Status,After,Extra");
    Итог.Owner = СтрокаТаблицы.Owner() = Таблица;
    Итог.SameRow = Таблица.Get(0) = СтрокаТаблицы;
    Итог.SameColumn = Колонки.Find("ИМЯ") = Колонка;
    Итог.Status = "ok";
    Попытка
        Если Сценарий = "deleted-row" Тогда
            Таблица.Delete(СтрокаТаблицы);
            Итог.Extra = Новый Структура("Owner,Index,Value,Write");
            Попытка Итог.Extra.Owner = СтрокаТаблицы.Owner() = Таблица; Исключение Итог.Extra.Owner = "[error]"; КонецПопытки;
            Попытка Итог.Extra.Index = Таблица.IndexOf(СтрокаТаблицы); Исключение Итог.Extra.Index = "[error]"; КонецПопытки;
            Попытка Итог.Extra.Value = СтрокаТаблицы.Имя; Исключение Итог.Extra.Value = "[error]"; КонецПопытки;
            Попытка СтрокаТаблицы.Имя = "detached"; Итог.Extra.Write = СтрокаТаблицы.Имя; Исключение Итог.Extra.Write = "[error]"; КонецПопытки;
        ИначеЕсли Сценарий = "deleted-column" Тогда
            Колонки.Delete(Колонка);
            Итог.Extra = Новый Структура("Index,Fields");
            Попытка Итог.Extra.Index = Колонки.IndexOf(Колонка); Исключение Итог.Extra.Index = "[error]"; КонецПопытки;
            Попытка Итог.Extra.Fields = ПоляКолонкиПробы(Колонка); Исключение Итог.Extra.Fields = "[error]"; КонецПопытки;
        ИначеЕсли Сценарий = "copy-independence" Тогда
            Копия = Таблица.Copy();
            КопияКолонок = Копия.Columns;
            КопияКолонок[0].Name = "Копия";
            КопияСтроки = Копия[0];
            КопияСтроки.Копия = "changed";
            Итог.Extra = ПоляТаблицыПробы(Копия);
        ИначеЕсли Сценарий = "nested-sharing" Тогда
            Массив = Новый Массив;
            Массив.Добавить(1);
            СтрокаТаблицы.Имя = Массив;
            Копия = Таблица.Copy();
            КопияСтроки = Копия[0];
            КопияСтроки.Имя.Добавить(2);
            Итог.Extra = ПоляТаблицыПробы(Копия);
        ИначеЕсли Сценарий = "codec-sharing" Тогда
            Массив = Новый Массив;
            Массив.Добавить(Таблица);
            Массив.Добавить(Таблица);
            Копия = ЗначениеИзСтрокиВнутр(ЗначениеВСтрокуВнутр(Массив));
            Первая = Копия[0];
            Вторая = Копия[1];
            До = Вторая.Count();
            Первая.Add();
            Итог.Extra = Новый Структура("Equal,Before,After", Первая = Вторая, До, Вторая.Count());
        ИначеЕсли Сценарий = "codec-object-graph" Тогда
            Массив = Новый Массив;
            Массив.Добавить(Таблица);
            Массив.Добавить(СтрокаТаблицы);
            Массив.Добавить(Колонки);
            Массив.Добавить(Колонка);
            Итог.Extra = Новый Структура("Codec,RowOwner,Columns,Column,Row");
            Итог.Extra.Codec = КодекТаблицыПробы(Массив);
            Попытка
                Копия = ЗначениеИзСтрокиВнутр(ЗначениеВСтрокуВнутр(Массив));
                НоваяТаблица = Копия[0]; НоваяСтрока = Копия[1]; НовыеКолонки = Копия[2]; НоваяКолонка = Копия[3];
                Попытка Итог.Extra.RowOwner = НоваяСтрока.Owner() = НоваяТаблица; Исключение Итог.Extra.RowOwner = "[error]"; КонецПопытки;
                Попытка Итог.Extra.Columns = НовыеКолонки = НоваяТаблица.Columns; Исключение Итог.Extra.Columns = "[error]"; КонецПопытки;
                Попытка Итог.Extra.Column = НоваяКолонка = НовыеКолонки[0]; Исключение Итог.Extra.Column = "[error]"; КонецПопытки;
                Попытка Итог.Extra.Row = НоваяСтрока = НоваяТаблица[0]; Исключение Итог.Extra.Row = "[error]"; КонецПопытки;
            Исключение Итог.Status = "error";
            КонецПопытки;
        ИначеЕсли Сценарий = "found-live" Тогда
            Найденные = Таблица.FindRows(Новый Структура("Имя", "row1"));
            Найденная = Найденные[0];
            Найденная.Имя = "changed";
            Итог.Extra = Найденная = СтрокаТаблицы;
        ИначеЕсли Сценарий = "unload-sharing" Тогда
            Массив = Новый Массив;
            Массив.Добавить(1);
            СтрокаТаблицы.Имя = Массив;
            Выгрузка = Таблица.UnloadColumn("Имя");
            Вложенный = Выгрузка[0];
            Вложенный.Добавить(2);
            Итог.Extra = Массив.Количество();
        КонецЕсли;
    Исключение Итог.Status = "error";
    КонецПопытки;
    Попытка Итог.After = ПоляТаблицыПробы(Таблица); Исключение Итог.After = "[snapshot-error]"; КонецПопытки;
    Возврат Итог;
КонецФункции

