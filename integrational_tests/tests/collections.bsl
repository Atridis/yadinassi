Функция ПоляИндексовПробы(Знач Индексы)
    Состав = Новый Массив;
    Для Каждого Индекс Из Индексы Цикл Состав.Add(ПоляИндексаПробы(Индекс)); КонецЦикла;
    Возврат Новый Структура("Count,Items", Индексы.Количество(), Состав);
КонецФункции

Функция ПоискИндексовПробы(Знач Таблица, Знач Ссылка)
    Отбор = Новый Структура("Key", "a");
    Найденные = Таблица.FindRows(Отбор);
    Поля = Новый Массив;
    Для Каждого Найденная Из Найденные Цикл Поля.Add(ПоляСтрокиПробы(Найденная)); КонецЦикла;
    Первая = Таблица.Find("a", "Key");
    Позиция = -1;
    Если Первая <> Неопределено Тогда Позиция = Таблица.IndexOf(Первая); КонецЕсли;
    Возврат Новый Структура("Count,Rows,FindIsSaved,FindIndex", Найденные.Count(), Поля,
        Первая = Ссылка, Позиция);
КонецФункции

// Точный поток записывается как строковое поле, без угаданных UUID или эталона.
Функция КонструкторИндексовПробы(Знач Вид)
    Если Вид = "collection" Тогда Объект = Вычислить("New CollectionIndexes()");
    Иначе Объект = Вычислить("New CollectionIndex()"); КонецЕсли;
    Итог = Новый Структура("Type,Text,View", Строка(ТипЗнч(Объект)), Строка(Объект));
    Попытка
        Если Вид = "collection" Тогда Итог.View = ПоляИндексовПробы(Объект);
        Иначе Итог.View = ПоляИндексаПробы(Объект); КонецЕсли;
    Исключение Итог.View = "[error]"; КонецПопытки;
    Возврат Итог;
КонецФункции

Функция КодекИндексовПробы(Знач Вид)
    Таблица = ТаблицаИндексовПробы();
    Индексы = Таблица.Indexes;
    Индекс = Неопределено;
    Если Вид <> "empty" Тогда Индекс = Индексы.Add("Key,Second"); КонецЕсли;
    Объект = Индекс;
    Если Вид = "collection" Или Вид = "empty" Тогда Объект = Индексы;
    ИначеЕсли Вид = "table" Тогда Объект = Таблица; Индексы.Add("Amount");
    КонецЕсли;
    Итог = Новый Структура("Type,Text,View,TypeWrite,TypeRead,Write,ReadType,ReadWrite,ReadView,Equal");
    Попытка Итог.Type = Строка(ТипЗнч(Объект)); Исключение Итог.Type = "[error]"; КонецПопытки;
    Попытка Итог.Text = Строка(Объект); Исключение Итог.Text = "[error]"; КонецПопытки;
    Попытка
    Если Вид = "index" Тогда Итог.View = ПоляИндексаПробы(Объект);
    ИначеЕсли Вид = "collection" Или Вид = "empty" Тогда Итог.View = ПоляИндексовПробы(Объект);
    Иначе Итог.View = Новый Структура("Table,Indexes", ПоляТаблицыПробы(Таблица), ПоляИндексовПробы(Индексы));
    КонецЕсли;
    Исключение Итог.View = "[error]"; КонецПопытки;
    Попытка Итог.TypeWrite = ЗначениеВСтрокуВнутр(ТипЗнч(Объект)); Исключение Итог.TypeWrite = "[error]"; КонецПопытки;
    Попытка
        ПрочитанныйТип = ЗначениеИзСтрокиВнутр(Итог.TypeWrite);
        Итог.TypeRead = Новый Структура("Type,Equal,Stable", Строка(ТипЗнч(ПрочитанныйТип)), ПрочитанныйТип = ТипЗнч(Объект),
            ЗначениеВСтрокуВнутр(ПрочитанныйТип) = Итог.TypeWrite);
    Исключение Итог.TypeRead = "[error]"; КонецПопытки;
    Попытка Итог.Write = ЗначениеВСтрокуВнутр(Объект); Исключение Итог.Write = "[error]"; КонецПопытки;
    Попытка
        Копия = ЗначениеИзСтрокиВнутр(Итог.Write);
        Итог.ReadType = Строка(ТипЗнч(Копия));
        Попытка
            ПовторнаяЗапись = ЗначениеВСтрокуВнутр(Копия);
            Итог.ReadWrite = ?(ПовторнаяЗапись = Итог.Write, "same-as-Write", ПовторнаяЗапись);
        Исключение Итог.ReadWrite = "[error]"; КонецПопытки;
        Попытка
            Если Вид = "index" Тогда Итог.ReadView = ПоляИндексаПробы(Копия);
            ИначеЕсли Вид = "collection" Или Вид = "empty" Тогда Итог.ReadView = ПоляИндексовПробы(Копия);
            Иначе
                ИндексыКопии = Копия.Indexes;
                Итог.ReadView = Новый Структура("Table,Indexes", ПоляТаблицыПробы(Копия), ПоляИндексовПробы(ИндексыКопии));
            КонецЕсли;
        Исключение Итог.ReadView = "[error]"; КонецПопытки;
        Попытка Итог.Equal = Копия = Объект; Исключение Итог.Equal = "[error]"; КонецПопытки;
    Исключение Итог.ReadType = "[error]"; КонецПопытки;
    Возврат Итог;
КонецФункции

// Небольшая серия ошибок имеет независимые приемники и сохраняет частичную вставку.
Функция ОшибкиИндексовПробы(Знач Действие)
    Результаты = Новый Массив;
    Если Действие = "add" Тогда
        Случаи = СтрРазделить("unknown|trailing|consecutive|undefined|omitted", "|");
    Иначе
        Случаи = СтрРазделить("negative|past|fraction|string|undefined|omitted", "|");
    КонецЕсли;
    Для Каждого Случай Из Случаи Цикл
        Таблица = ТаблицаИндексовПробы(); Индексы = Таблица.Indexes;
        Итог = Новый Структура("Case,Status,Indexes", Случай, "ok");
        Попытка
            Если Случай = "unknown" Тогда Индексы.Add("Key,Missing");
            ИначеЕсли Случай = "trailing" Тогда Индексы.Add("Key,");
            ИначеЕсли Случай = "consecutive" Тогда Индексы.Add("Key,,Second");
            ИначеЕсли Действие = "add" И Случай = "undefined" Тогда Индексы.Add(Неопределено);
            ИначеЕсли Действие = "add" Тогда Временный = Вычислить("Индексы.Add()");
            Иначе
                Индексы.Add("Key");
                Если Случай = "negative" Тогда Индексы.Delete(-1);
                ИначеЕсли Случай = "past" Тогда Индексы.Delete(1);
                ИначеЕсли Случай = "fraction" Тогда Индексы.Delete(0.5);
                ИначеЕсли Случай = "string" Тогда Индексы.Delete("0");
                ИначеЕсли Случай = "undefined" Тогда Индексы.Delete(Неопределено);
                Иначе Индексы.Delete(); КонецЕсли;
            КонецЕсли;
        Исключение Итог.Status = "error"; КонецПопытки;
        Итог.Indexes = ПоляИндексовПробы(Индексы);
        Результаты.Add(Итог);
    КонецЦикла;
    Возврат Результаты;
КонецФункции

Функция ИндексыТаблицыПробы(Знач Сценарий, Знач Список = "Key")
    Таблица = ТаблицаИндексовПробы();
    Индексы = Таблица.Indexes;
    Итог = Новый Структура("Status,Extra,Indexes,Table", "ok");
    Индекс = Неопределено;
    Попытка
        Если Сценарий = "add" Тогда
            Индекс = Индексы.Add(Список);
            Итог.Extra = ПоляИндексаПробы(Индекс);
        Иначе
            Индекс = Индексы.Add("Key,Second");
            Если Сценарий = "identity" Тогда
                ДругаяТаблица = ТаблицаИндексовПробы();
                ДругиеИндексы = ДругаяТаблица.Indexes;
                ДругойИндекс = ДругиеИндексы.Add("Key,Second");
                Первый = Неопределено;
                Для Каждого Элемент Из Индексы Цикл Первый = Элемент; Прервать; КонецЦикла;
                Связи = Новый Структура("SameProperty,SameIteration,EqualOtherCollection,EqualOtherIndex",
                    Индексы = Таблица.Индексы, Индекс = Первый, Индексы = ДругиеИндексы, Индекс = ДругойИндекс);
                Итог.Extra = Связи;
                Попытка Связи.Вставить("CollectionType", ТипЗнч(Индексы) = Тип("CollectionIndexes")); Исключение Связи.Вставить("CollectionType", "[error]"); КонецПопытки;
                Попытка Связи.Вставить("IndexType", ТипЗнч(Индекс) = Тип("CollectionIndex")); Исключение Связи.Вставить("IndexType", "[error]"); КонецПопытки;
                Попытка Связи.Вставить("RussianCollection", ТипЗнч(Индексы) = Тип("ИндексыКоллекции")); Исключение Связи.Вставить("RussianCollection", "[error]"); КонецПопытки;
                Попытка Связи.Вставить("RussianIndex", ТипЗнч(Индекс) = Тип("ИндексКоллекции")); Исключение Связи.Вставить("RussianIndex", "[error]"); КонецПопытки;
            ИначеЕсли Сценарий = "access" Тогда
                Доступ = Новый Структура("IndexZero,IndexLast,IndexPast,CollectionZero,CollectionGet,IndexCount,IndexNegative,IndexFraction,IndexString,IndexUndefined,IndexWrite");
                Итог.Extra = Доступ;
                Попытка Доступ.IndexZero = Вычислить("Индекс[0]"); Исключение Доступ.IndexZero = "[error]"; КонецПопытки;
                Попытка Доступ.IndexLast = Вычислить("Индекс[1]"); Исключение Доступ.IndexLast = "[error]"; КонецПопытки;
                Попытка Доступ.IndexPast = Вычислить("Индекс[2]"); Исключение Доступ.IndexPast = "[error]"; КонецПопытки;
                Попытка Доступ.CollectionZero = Вычислить("Индексы[0] = Индекс"); Исключение Доступ.CollectionZero = "[error]"; КонецПопытки;
                Попытка Доступ.CollectionGet = Вычислить("Индексы.Get(0) = Индекс"); Исключение Доступ.CollectionGet = "[error]"; КонецПопытки;
                Попытка Доступ.IndexCount = Вычислить("Индекс.Count()"); Исключение Доступ.IndexCount = "[error]"; КонецПопытки;
                Попытка Доступ.IndexNegative = Вычислить("Индекс[-1]"); Исключение Доступ.IndexNegative = "[error]"; КонецПопытки;
                Попытка Доступ.IndexFraction = Вычислить("Индекс[0.9]"); Исключение Доступ.IndexFraction = "[error]"; КонецПопытки;
                Попытка Доступ.IndexString = Вычислить("Индекс[""0""]"); Исключение Доступ.IndexString = "[error]"; КонецПопытки;
                Попытка Доступ.IndexUndefined = Вычислить("Индекс[Неопределено]"); Исключение Доступ.IndexUndefined = "[error]"; КонецПопытки;
                Попытка Индекс[0] = "Amount"; Доступ.IndexWrite = "ok"; Исключение Доступ.IndexWrite = "[error]"; КонецПопытки;
            ИначеЕсли Сценарий = "readonly" Тогда
                Таблица.Indexes = Индексы;
            ИначеЕсли Сценарий = "repeat" Тогда
                Повтор = Индексы.Add("key,SECOND");
                Итог.Extra = Новый Структура("Same,Names", Повтор = Индекс, ПоляИндексаПробы(Повтор));
            ИначеЕсли Сценарий = "delete-number" Тогда
                Индексы.Add("Amount"); Индексы.Delete(0);
            ИначеЕсли Сценарий = "delete-object" Тогда
                Индексы.Добавить("Amount"); Индексы.Удалить(Индекс);
            ИначеЕсли Сценарий = "delete-foreign" Тогда
                ДругаяТаблица = ТаблицаИндексовПробы();
                ДругиеИндексы = ДругаяТаблица.Indexes;
                ДругойИндекс = ДругиеИндексы.Add("Key,Second");
                Индексы.Delete(ДругойИндекс);
            ИначеЕсли Сценарий = "delete-stale" Тогда
                Индексы.Delete(Индекс); Индексы.Add("Amount"); Индексы.Delete(Индекс);
            ИначеЕсли Сценарий = "clear" Тогда
                Индексы.Add("Amount"); Индексы.Clear(); Индексы.Очистить();
            ИначеЕсли Сценарий = "rename" Тогда
                Колонки = Таблица.Columns; Колонка = Колонки[0]; Колонка.Name = "Renamed";
            ИначеЕсли Сценарий = "column-delete" Тогда
                Колонки = Таблица.Columns; Колонки.Delete("Key");
            ИначеЕсли Сценарий = "column-move" Тогда
                Колонки = Таблица.Columns; Колонки.Move("Key", 2);
            ИначеЕсли Сценарий = "table-clear" Тогда
                Таблица.Clear();
            ИначеЕсли Сценарий = "columns-clear" Тогда
                Колонки = Таблица.Columns; Колонки.Clear();
            ИначеЕсли Сценарий = "sort" Тогда
                Сохраненная = Таблица[0];
                Таблица.Sort("Second Desc");
                Итог.Extra = ПоискИндексовПробы(Таблица, Сохраненная);
            ИначеЕсли Сценарий = "group" Тогда
                Индексы.Add("Amount");
                Таблица.GroupBy("Key,Second", "Amount");
                Итог.Extra = ПоляИндексовПробы(Индексы);
                Таблица.GroupBy("Key", "Amount");
            ИначеЕсли Сценарий = "copy" Тогда
                Копия = Таблица.Copy(); ИндексыКопии = Копия.Indexes;
                Итог.Extra = Новый Структура("Indexes,Rows,Same", ПоляИндексовПробы(ИндексыКопии),
                    ПоляТаблицыПробы(Копия), ИндексыКопии = Индексы);
                Проекция = Таблица.Copy(, "Key"); ИндексыПроекции = Проекция.Indexes;
                ТолькоКолонки = Таблица.CopyColumns("Key"); ИндексыКолонок = ТолькоКолонки.Indexes;
                Итог.Extra.Вставить("ProjectedIndexes", ПоляИндексовПробы(ИндексыПроекции));
                Итог.Extra.Вставить("ColumnsOnlyIndexes", ПоляИндексовПробы(ИндексыКолонок));
                Итог.Extra.Вставить("ProjectedColumn", Проекция.Columns[0].Name);
                Итог.Extra.Вставить("ColumnsOnlyColumn", ТолькоКолонки.Columns[0].Name);
            Иначе
                Индексы.Add("Key");
                Сохраненная = Таблица[0];
                Этапы = Новый Массив;
                Итог.Extra = Этапы;
                Этапы.Add(ПоискИндексовПробы(Таблица, Сохраненная));
                Прямой = Таблица.FindRows(Новый Структура("Key,Second", "a", 1));
                Обратный = Таблица.FindRows(Новый Структура("Second,Key", 1, "a"));
                Итог.Вставить("Composite", Новый Структура("Count,ReverseCount,SameSaved,ReverseSameSaved",
                    Прямой.Count(), Обратный.Count(), Прямой[0] = Сохраненная, Обратный[0] = Сохраненная));
                Если Сценарий = "search-edit" Тогда
                    Сохраненная.Key = "b";
                    Этапы.Add(ПоискИндексовПробы(Таблица, Сохраненная));
                    Сохраненная.Key = "a";
                ИначеЕсли Сценарий = "search-add-delete" Тогда
                    Новая = Таблица.Add(); Новая.Key = "a"; Новая.Second = 3; Новая.Amount = 3;
                    Этапы.Add(ПоискИндексовПробы(Таблица, Сохраненная));
                    Таблица.Delete(Сохраненная);
                ИначеЕсли Сценарий = "search-bulk" Тогда
                    Таблица.FillValues("b", "Key");
                    Этапы.Add(ПоискИндексовПробы(Таблица, Сохраненная));
                    Значения = Новый Массив; Значения.Add("a"); Значения.Add("a");
                    Таблица.LoadColumn(Значения, "Key");
                КонецЕсли;
                Этапы.Add(ПоискИндексовПробы(Таблица, Сохраненная));
            КонецЕсли;
        КонецЕсли;
    Исключение Итог.Status = "error"; КонецПопытки;
    Попытка Итог.Indexes = ПоляИндексовПробы(Индексы); Исключение Итог.Indexes = "[error]"; КонецПопытки;
    Попытка Итог.Table = ПоляТаблицыПробы(Таблица); Исключение Итог.Table = "[error]"; КонецПопытки;
    Если Индекс <> Неопределено Тогда
        Попытка Итог.Вставить("SavedIndex", ПоляИндексаПробы(Индекс)); Исключение Итог.Вставить("SavedIndex", "[error]"); КонецПопытки;
    КонецЕсли;
    Возврат Итог;
КонецФункции
// Конец компактных проб индексов.

// Начало дополнительных компактных проб индексов.
// Amount — уникальный ID; порядок строк и результаты каждого поиска наблюдаются отдельно.
Функция ДопТаблицаИндексов()
    Таблица = Вычислить("Новый ТаблицаЗначений"); Колонки = Таблица.Columns;
    Колонки.Add("Key"); Колонки.Add("Second"); Колонки.Add("Amount");
    Для Номер = 1 По 3 Цикл
        СтрокаТаблицы = Таблица.Add();
        СтрокаТаблицы.Key = "a"; СтрокаТаблицы.Second = 1; СтрокаТаблицы.Amount = Номер;
    КонецЦикла;
    Возврат Таблица;
КонецФункции

Функция ДопИдентификаторыИндексов(Знач СтрокиТаблицы)
    Идентификаторы = Новый Массив;
    Для Каждого СтрокаТаблицы Из СтрокиТаблицы Цикл Идентификаторы.Add(СтрокаТаблицы.Amount); КонецЦикла;
    Возврат Идентификаторы;
КонецФункции

Функция ДопПервыйИндексПоиска(Знач Таблица, Знач Вид = "key")
    Попытка
        Если Вид = "all" Тогда Найденная = Таблица.Find("a");
        ИначеЕсли Вид = "second-key" Тогда Найденная = Таблица.Find("a", "Second,Key");
        Иначе Найденная = Таблица.Find("a", "Key"); КонецЕсли;
        Если Найденная = Неопределено Тогда Возврат Неопределено; КонецЕсли;
        Возврат Найденная.Amount;
    Исключение Возврат "[error]"; КонецПопытки;
КонецФункции

Функция ДопПоискИндексов(Знач Таблица, Знач Вид = "edit")
    Итог = Новый Структура("Order,Rows,FindKey");
    Попытка Итог.Order = ДопИдентификаторыИндексов(Таблица); Исключение Итог.Order = "[error]"; КонецПопытки;
    Попытка
        Найденные = Таблица.FindRows(Новый Структура("Key", "a"));
        Итог.Rows = ДопИдентификаторыИндексов(Найденные);
    Исключение Итог.Rows = "[error]"; КонецПопытки;
    Итог.FindKey = ДопПервыйИндексПоиска(Таблица);
    Если Вид = "reorder" Тогда
        Итог.Insert("FindAll", ДопПервыйИндексПоиска(Таблица, "all"));
        Итог.Insert("FindSecondKey", ДопПервыйИндексПоиска(Таблица, "second-key"));
    ИначеЕсли Вид = "selection" Тогда
        Попытка
            Найденные = Таблица.FindRows(Новый Структура("Key,Second", "a", 1));
            Итог.Insert("Composite", ДопИдентификаторыИндексов(Найденные));
        Исключение Итог.Insert("Composite", "[error]"); КонецПопытки;
        Попытка
            Найденные = Таблица.FindRows(Новый Структура("Second,Key", 1, "a"));
            Итог.Insert("Reverse", ДопИдентификаторыИндексов(Найденные));
        Исключение Итог.Insert("Reverse", "[error]"); КонецПопытки;
    КонецЕсли;
    Возврат Итог;
КонецФункции

Функция ДопПорядокИндексов(Знач Вид)
    Таблица = ДопТаблицаИндексов(); Индексы = Таблица.Indexes;
    Статусы = Новый Массив; Итог = Новый Структура("Steps", Статусы);
    Попытка Индексы.Add("Key"); Статусы.Add("AddKey:ok");
    Исключение Статусы.Add("AddKey:error"); КонецПопытки;
    Первая = Таблица[0]; Вторая = Таблица[1];
    Итог.Insert("Initial", ДопПоискИндексов(Таблица, Вид));
    Если Вид = "reorder" Тогда
        Попытка Таблица.Sort("Amount Desc"); Статусы.Add("Sort:ok");
        Исключение Статусы.Add("Sort:error"); КонецПопытки;
        Итог.Insert("Sorted", ДопПоискИндексов(Таблица, Вид));
        Попытка Таблица.Move(Таблица[0], 2); Статусы.Add("Move:ok");
        Исключение Статусы.Add("Move:error"); КонецПопытки;
        Итог.Insert("Moved", ДопПоискИндексов(Таблица, Вид));
    Иначе
        Попытка Первая.Key = "a"; Статусы.Add("SameKey:ok");
        Исключение Статусы.Add("SameKey:error"); КонецПопытки;
        Итог.Insert("SameKey", ДопПоискИндексов(Таблица));
        Попытка Вторая.Second = 2; Статусы.Add("OtherColumn:ok");
        Исключение Статусы.Add("OtherColumn:error"); КонецПопытки;
        Итог.Insert("OtherColumn", ДопПоискИндексов(Таблица));
        Попытка Первая.Key = "b"; Первая.Key = "a"; Статусы.Add("BeforeFill:ok");
        Исключение Статусы.Add("BeforeFill:error"); КонецПопытки;
        Итог.Insert("BeforeFill", ДопПоискИндексов(Таблица));
        Попытка Таблица.FillValues("a", "Key"); Статусы.Add("Fill:ok");
        Исключение Статусы.Add("Fill:error"); КонецПопытки;
        Итог.Insert("AfterFill", ДопПоискИндексов(Таблица));
        Попытка Первая.Key = "b"; Первая.Key = "a"; Статусы.Add("BeforeLoad:ok");
        Исключение Статусы.Add("BeforeLoad:error"); КонецПопытки;
        Итог.Insert("BeforeLoad", ДопПоискИндексов(Таблица));
        Значения = Новый Массив; Значения.Add("a"); Значения.Add("a"); Значения.Add("a");
        Попытка Таблица.LoadColumn(Значения, "Key"); Статусы.Add("Load:ok");
        Исключение Статусы.Add("Load:error"); КонецПопытки;
        Итог.Insert("AfterLoad", ДопПоискИндексов(Таблица));
    КонецЕсли;
    Возврат Итог;
КонецФункции

Функция ДопВыборИндекса()
    Таблица = ДопТаблицаИндексов(); Индексы = Таблица.Indexes;
    Статусы = Новый Массив; Итог = Новый Структура("Steps", Статусы);
    Старый = Неопределено; Составной = Неопределено;
    Попытка Старый = Индексы.Add("Key"); Статусы.Add("AddOld:ok");
    Исключение Статусы.Add("AddOld:error"); КонецПопытки;
    Первая = Таблица[0];
    Попытка Первая.Key = "b"; Первая.Key = "a"; Статусы.Add("Scramble:ok");
    Исключение Статусы.Add("Scramble:error"); КонецПопытки;
    Итог.Insert("BeforeAdd", ДопПоискИндексов(Таблица, "selection"));
    Попытка Составной = Индексы.Add("Key,Second"); Статусы.Add("AddComposite:ok");
    Исключение Статусы.Add("AddComposite:error"); КонецПопытки;
    Итог.Insert("AfterComposite", ДопПоискИндексов(Таблица, "selection"));
    Попытка Индексы.Add("Key"); Итог.Insert("DuplicateAdd", "ok");
    Исключение Итог.Insert("DuplicateAdd", "[error]"); КонецПопытки;
    Итог.Insert("AfterDuplicate", ДопПоискИндексов(Таблица, "selection"));
    Попытка
        Если Старый = Неопределено Тогда Статусы.Add("DeleteOld:unavailable");
        Иначе Индексы.Delete(Старый); Статусы.Add("DeleteOld:ok"); КонецЕсли;
    Исключение Статусы.Add("DeleteOld:error"); КонецПопытки;
    Итог.Insert("AfterDeleteOld", ДопПоискИндексов(Таблица, "selection"));
    Попытка
        Если Составной = Неопределено Тогда Статусы.Add("DeleteComposite:unavailable");
        Иначе Индексы.Delete(Составной); Статусы.Add("DeleteComposite:ok"); КонецЕсли;
    Исключение Статусы.Add("DeleteComposite:error"); КонецПопытки;
    Итог.Insert("AfterDeleteComposite", ДопПоискИндексов(Таблица, "selection"));
    Возврат Итог;
КонецФункции

Функция ДопСоставКопииИндексов(Знач Таблица)
    Итог = Новый Структура("Columns,Indexes");
    Попытка
        Имена = Новый Массив; Колонки = Таблица.Columns;
        Для Каждого Колонка Из Колонки Цикл Имена.Add(Колонка.Name); КонецЦикла;
        Итог.Columns = Имена;
    Исключение Итог.Columns = "[error]"; КонецПопытки;
    Попытка
        Имена = Новый Массив; Индексы = Таблица.Indexes;
        Для Каждого Индекс Из Индексы Цикл Имена.Add(ПоляИндексаПробы(Индекс)); КонецЦикла;
        Итог.Indexes = Имена;
    Исключение Итог.Indexes = "[error]"; КонецПопытки;
    Возврат Итог;
КонецФункции

Функция ДопКопииИндексов()
    Таблица = ДопТаблицаИндексов(); Индексы = Таблица.Indexes;
    Статусы = Новый Массив; Итог = Новый Структура("Steps", Статусы);
    Попытка Индексы.Add("Key,Second"); Статусы.Add("AddComposite:ok");
    Исключение Статусы.Add("AddComposite:error"); КонецПопытки;
    Попытка Индексы.Add("Key"); Статусы.Add("AddKey:ok");
    Исключение Статусы.Add("AddKey:error"); КонецПопытки;
    Попытка Индексы.Add("Amount"); Статусы.Add("AddAmount:ok");
    Исключение Статусы.Add("AddAmount:error"); КонецПопытки;
    ПолнаяКопия = Неопределено;
    Для Каждого Вид Из СтрРазделить("CopyAll|CopyPair|CopyKey|ColumnsAll|ColumnsPair|ColumnsKey", "|") Цикл
        Попытка
            Если Вид = "CopyAll" Тогда Копия = Таблица.Copy(, "Second,Key,Amount");
            ИначеЕсли Вид = "CopyPair" Тогда Копия = Таблица.Copy(, "Second,Key");
            ИначеЕсли Вид = "CopyKey" Тогда Копия = Таблица.Copy(, "Key");
            ИначеЕсли Вид = "ColumnsAll" Тогда Копия = Таблица.CopyColumns();
            ИначеЕсли Вид = "ColumnsPair" Тогда Копия = Таблица.CopyColumns("Second,Key");
            Иначе Копия = Таблица.CopyColumns("Key"); КонецЕсли;
            Итог.Insert(Вид, ДопСоставКопииИндексов(Копия));
        Исключение Итог.Insert(Вид, "[error]"); КонецПопытки;
    КонецЦикла;
    Попытка ПолнаяКопия = Таблица.Copy(); Статусы.Add("FullCopy:ok");
    Исключение Статусы.Add("FullCopy:error"); КонецПопытки;
    Итог.Insert("FullCopy", ДопСоставКопииИндексов(ПолнаяКопия));
    Попытка
        Колонки = ПолнаяКопия.Columns; Колонка = Колонки.Find("Key"); Колонка.Name = "Renamed";
        Статусы.Add("RenameCopy:ok");
    Исключение Статусы.Add("RenameCopy:error"); КонецПопытки;
    Итог.Insert("RenamedCopy", ДопСоставКопииИндексов(ПолнаяКопия));
    Итог.Insert("Source", ДопСоставКопииИндексов(Таблица));
    Возврат Итог;
КонецФункции

Функция ДопУдаленныйИндекс(Знач Индексы, Знач Сохраненный)
    Итог = Новый Структура("Names,Zero,One,Text,Count");
    Попытка Итог.Names = ПоляИндексаПробы(Сохраненный); Исключение Итог.Names = "[error]"; КонецПопытки;
    Попытка Итог.Zero = Вычислить("Сохраненный[0]"); Исключение Итог.Zero = "[error]"; КонецПопытки;
    Попытка Итог.One = Вычислить("Сохраненный[1]"); Исключение Итог.One = "[error]"; КонецПопытки;
    Попытка Итог.Text = Строка(Сохраненный); Исключение Итог.Text = "[error]"; КонецПопытки;
    Попытка Итог.Count = Индексы.Количество(); Исключение Итог.Count = "[error]"; КонецПопытки;
    Возврат Итог;
КонецФункции

Функция ДопСвязиИндексов()
    Итог = Новый Структура;
    Для Каждого Вид Из СтрРазделить("Delete|Clear|Group", "|") Цикл
        Статусы = Новый Массив; Этапы = Новый Структура("Steps", Статусы);
        Итог.Insert(Вид, Этапы);
        Попытка
            Таблица = ДопТаблицаИндексов(); Индексы = Таблица.Indexes; Сохраненный = Неопределено;
            Попытка Сохраненный = Индексы.Add("Key,Second"); Статусы.Add("Add:ok");
            Исключение Статусы.Add("Add:error"); КонецПопытки;
            Попытка
                Если Вид = "Delete" Тогда
                    Если Сохраненный = Неопределено Тогда Статусы.Add("Delete:unavailable");
                    Иначе Индексы.Delete(Сохраненный); Статусы.Add("Delete:ok"); КонецЕсли;
                ИначеЕсли Вид = "Clear" Тогда Индексы.Clear(); Статусы.Add("Clear:ok");
                Иначе Таблица.GroupBy("Key", "Amount"); Статусы.Add("Group:ok"); КонецЕсли;
            Исключение Статусы.Add(Вид + ":error"); КонецПопытки;
            Этапы.Insert("Immediately", ДопУдаленныйИндекс(Индексы, Сохраненный));
            Попытка
                Колонки = Таблица.Columns; Колонка = Колонки.Find("Key"); Колонка.Name = "Renamed";
                Статусы.Add("Rename:ok");
            Исключение Статусы.Add("Rename:error"); КонецПопытки;
            Этапы.Insert("AfterRename", ДопУдаленныйИндекс(Индексы, Сохраненный));
            ИмяУдаляемой = ?(Вид = "Group", "Amount", "Second");
            Попытка
                Колонки = Таблица.Columns; Колонки.Delete(ИмяУдаляемой);
                Статусы.Add("Delete" + ИмяУдаляемой + ":ok");
            Исключение Статусы.Add("Delete" + ИмяУдаляемой + ":error"); КонецПопытки;
            Этапы.Insert("AfterDelete" + ИмяУдаляемой, ДопУдаленныйИндекс(Индексы, Сохраненный));
        Исключение Этапы.Insert("Setup", "[error]"); КонецПопытки;
    КонецЦикла;
    Возврат Итог;
КонецФункции
// Конец дополнительных компактных проб индексов.

// Начало компактных проб списка значений.
// Операции защищены отдельно от снимков. Эталон создаёт только реальная 1С.
Функция НовыйСписокПробы(Знач Вид = "base")
    Список = Вычислить("Новый СписокЗначений");
    Если Вид <> "empty" Тогда
        Список.Add(10, "first", Истина);
        Список.Add(20, "second", Ложь);
    КонецЕсли;
    Возврат Список;
КонецФункции

Функция ПоляЭлементаСписка(Знач Элемент)
    Поля = Новый Массив;
    Попытка Поля.Add(Элемент.Value); Исключение Поля.Add("[value-error]"); КонецПопытки;
    Попытка Поля.Add(Элемент.Presentation); Исключение Поля.Add("[presentation-error]"); КонецПопытки;
    Попытка Поля.Add(Элемент.Check); Исключение Поля.Add("[check-error]"); КонецПопытки;
    Возврат Поля;
КонецФункции

Функция ПоляСпискаПробы(Знач Список)
    Итог = Новый Структура("Count,Items");
    Попытка Итог.Count = Список.Count(); Исключение Итог.Count = "[error]"; КонецПопытки;
    Элементы = Новый Массив;
    Попытка
        Для Каждого Элемент Из Список Цикл
            Если Элементы.Count() >= 8 Тогда
                Элементы.Add("[limit]");
                Прервать;
            КонецЕсли;
            Элементы.Add(ПоляЭлементаСписка(Элемент));
        КонецЦикла;
    Исключение
        Элементы.Add("[iteration-error]");
    КонецПопытки;
    Итог.Items = Элементы;
    Возврат Итог;
КонецФункции

Функция ОтветСпискаПробы(Знач Ответ, Знач Сохраненный)
    Если ТипЗнч(Ответ) = Тип("ValueListItem") Тогда
        Возврат Новый Структура("Saved,Fields", Ответ = Сохраненный, ПоляЭлементаСписка(Ответ));
    ИначеЕсли ТипЗнч(Ответ) = Тип("ValueList") Тогда
        Возврат ПоляСпискаПробы(Ответ);
    КонецЕсли;
    Возврат Ответ;
КонецФункции

// Каждый оператор получает новый список. Ошибка после изменения видна в After.
Функция ДействиеСпискаПробы(Знач Команда, Знач Вид = "base")
    Список = НовыйСписокПробы("empty");
    Сохраненный = Неопределено;
    Если Вид <> "empty" Тогда
        Сохраненный = Список.Add(10, "first", Истина);
        Список.Add(20, "second", Ложь);
    КонецЕсли;
    ЧужойСписок = НовыйСписокПробы("empty");
    Чужой = ЧужойСписок.Add(10, "first", Истина);
    Ответ = Неопределено;
    Итог = Новый Структура("Status,Result,After", "ok");
    Попытка
        Выполнить(Команда);
    Исключение
        Итог.Status = "error";
    КонецПопытки;
    Попытка Итог.Result = ОтветСпискаПробы(Ответ, Сохраненный);
    Исключение Итог.Result = "[result-error]"; КонецПопытки;
    Итог.After = ПоляСпискаПробы(Список);
    Возврат Итог;
КонецФункции

Функция СерияСпискаПробы(Знач Команды, Знач Вид = "base")
    Ответы = Новый Массив;
    Для Каждого Команда Из СтрРазделить(Команды, "|") Цикл
        Ответы.Add(ДействиеСпискаПробы(Команда, Вид));
    КонецЦикла;
    Возврат Ответы;
КонецФункции

Функция ИдентичностьСпискаПробы()
    Список = НовыйСписокПробы();
    Элемент = Список.Получить(0);
    Итог = Новый Структура("ListType,ItemType,Names,Text,IndexIdentity,IterationIdentity,ValueType,AvailableValues,Fields");
    Попытка Итог.ListType = Строка(ТипЗнч(Список)); Исключение Итог.ListType = "[error]"; КонецПопытки;
    Попытка Итог.ItemType = Строка(ТипЗнч(Элемент)); Исключение Итог.ItemType = "[error]"; КонецПопытки;
    Попытка
        Итог.Names = Новый Массив;
        Итог.Names.Add(Тип("ValueList") = Тип("СписокЗначений"));
        Итог.Names.Add(Тип("ValueListItem") = Тип("ЭлементСпискаЗначений"));
    Исключение Итог.Names = "[error]"; КонецПопытки;
    Попытка Итог.Text = Новый Структура("List,Item", Строка(Список), Строка(Элемент));
    Исключение Итог.Text = "[error]"; КонецПопытки;
    Попытка Итог.IndexIdentity = Список[0] = Элемент; Исключение Итог.IndexIdentity = "[error]"; КонецПопытки;
    Попытка
        Для Каждого Текущий Из Список Цикл
            Итог.IterationIdentity = Текущий = Элемент;
            Прервать;
        КонецЦикла;
    Исключение Итог.IterationIdentity = "[error]"; КонецПопытки;
    Попытка
        Описание = Список.ValueType;
        Итог.ValueType = Описание.Types();
    Исключение Итог.ValueType = "[error]"; КонецПопытки;
    Попытка Итог.AvailableValues = Список.AvailableValues;
    Исключение Итог.AvailableValues = "[error]"; КонецПопытки;
    Итог.Fields = ПоляСпискаПробы(Список);
    Возврат Итог;
КонецФункции

Функция ПоискЗначенияСпискаПробы()
    Список = НовыйСписокПробы("empty");
    Вложенный = Новый Массив;
    Значения = Новый Массив;
    Значения.Add(10);
    Значения.Add("10");
    Значения.Add(1);
    Значения.Add(Истина);
    Значения.Add(Неопределено);
    Значения.Add(Null);
    Значения.Add(Вложенный);
    Значения.Add("a");
    Значения.Add("A");
    Для Каждого Значение Из Значения Цикл
        Список.Add(Значение);
    КонецЦикла;
    Список.Add(10, "duplicate");
    Значения.Add(Новый Массив);
    Значения.Add("missing");
    Итог = Новый Массив;
    Для Каждого Значение Из Значения Цикл
        Попытка
            Найденный = Список.FindByValue(Значение);
            Если Найденный = Неопределено Тогда
                Итог.Add(Неопределено);
            Иначе
                // Независимая позиция обхода, без IndexOf как неявного оракула.
                Позиция = 0;
                РезультатПоиска = "[not-in-list]";
                Для Каждого Элемент Из Список Цикл
                    Если Элемент = Найденный Тогда
                        РезультатПоиска = Позиция;
                        Прервать;
                    КонецЕсли;
                    Позиция = Позиция + 1;
                КонецЦикла;
                Итог.Add(РезультатПоиска);
            КонецЕсли;
        Исключение Итог.Add("[error]"); КонецПопытки;
    КонецЦикла;
    Возврат Итог;
КонецФункции

Функция СвязиСпискаПробы(Знач Вид)
    Список = НовыйСписокПробы("empty");
    Сохраненный = Список.Add(10, "first", Истина);
    Список.Add(20, "second", Ложь);
    Итог = Новый Структура("Status,BeforeID,AfterID,Found,Index,Fields,After,NewID", "ok");
    Попытка Итог.BeforeID = Сохраненный.GetID(); Исключение Итог.BeforeID = "[error]"; КонецПопытки;
    Попытка
        Если Вид = "delete" Тогда
            Список.Delete(Сохраненный);
        ИначеЕсли Вид = "clear" Тогда
            Список.Clear();
        Иначе
            Список.Insert(0, 30);
            Список.Move(Сохраненный, 1);
        КонецЕсли;
    Исключение Итог.Status = "error"; КонецПопытки;
    Попытка Итог.AfterID = Сохраненный.GetID(); Исключение Итог.AfterID = "[error]"; КонецПопытки;
    Попытка Итог.Found = Список.FindByID(Итог.BeforeID) = Сохраненный; Исключение Итог.Found = "[error]"; КонецПопытки;
    Попытка Итог.Index = Список.IndexOf(Сохраненный); Исключение Итог.Index = "[error]"; КонецПопытки;
    Итог.Fields = ПоляЭлементаСписка(Сохраненный);
    Если Вид <> "move" Тогда
        СтатусыЗаписи = Новый Структура("Value,Presentation,Check", "ok", "ok", "ok");
        Попытка Сохраненный.Value = 99;
        Исключение СтатусыЗаписи.Value = "error"; КонецПопытки;
        Попытка Сохраненный.Presentation = "detached";
        Исключение СтатусыЗаписи.Presentation = "error"; КонецПопытки;
        Попытка Сохраненный.Check = Ложь;
        Исключение СтатусыЗаписи.Check = "error"; КонецПопытки;
        Итог.Insert("WriteStatus", СтатусыЗаписи);
        Итог.Insert("Written", ПоляЭлементаСписка(Сохраненный));
    КонецЕсли;
    Попытка
        НовыйЭлемент = Список.Add(40);
        Итог.NewID = НовыйЭлемент.GetID();
    Исключение Итог.NewID = "[error]"; КонецПопытки;
    Итог.After = ПоляСпискаПробы(Список);
    Возврат Итог;
КонецФункции

Функция КопированиеСпискаПробы(Знач Вид)
    Список = НовыйСписокПробы("empty");
    Вложенный = Новый Массив;
    Вложенный.Add(1);
    Сохраненный = Список.Add(Вложенный, "nested", Истина);
    Список.Add(20, "second", Ложь);
    Итог = Новый Структура("Status,After,Other,SameItem,SharedValue,IDs", "ok");
    Другой = Неопределено;
    Попытка
        Если Вид = "copy" Тогда
            Другой = Список.Copy();
            ДругойЭлемент = Другой.Get(0);
            Итог.SameItem = ДругойЭлемент = Сохраненный;
            Итог.SharedValue = ДругойЭлемент.Value = Вложенный;
            Попытка Итог.IDs = Новый Структура("Original,Copy", Сохраненный.GetID(), ДругойЭлемент.GetID());
            Исключение Итог.IDs = "[error]"; КонецПопытки;
            ДругойЭлемент.Presentation = "copy";
            Другой.Delete(1);
        ИначеЕсли Вид = "load" Тогда
            МассивЗначений = Новый Массив;
            МассивЗначений.Add(Вложенный);
            МассивЗначений.Add(Неопределено);
            Список.LoadValues(МассивЗначений);
            ДругойЭлемент = Список.Get(0);
            Итог.SameItem = ДругойЭлемент = Сохраненный;
            Итог.SharedValue = ДругойЭлемент.Value = Вложенный;
            Попытка Итог.IDs = Новый Структура("Old,New", Сохраненный.GetID(), ДругойЭлемент.GetID());
            Исключение Итог.IDs = "[error]"; КонецПопытки;
            МассивЗначений.Clear();
            Другой = ПоляЭлементаСписка(Сохраненный);
        Иначе
            Другой = Список.UnloadValues();
            Итог.SharedValue = Другой[0] = Вложенный;
            Другой.Add(30);
        КонецЕсли;
        Вложенный.Add(2);
    Исключение Итог.Status = "error"; КонецПопытки;
    Итог.After = ПоляСпискаПробы(Список);
    Попытка Итог.Other = ОтветСпискаПробы(Другой, Сохраненный);
    Исключение Итог.Other = "[error]"; КонецПопытки;
    Возврат Итог;
КонецФункции

Функция ИдентификаторыСпискаПробы(Знач Список)
    Итог = Новый Массив;
    Попытка
        Для Каждого Элемент Из Список Цикл
            Если Итог.Count() >= 8 Тогда
                Итог.Add("[limit]");
                Прервать;
            КонецЕсли;
            Запись = Новый Структура("ID,Found");
            Попытка Запись.ID = Элемент.GetID();
            Исключение Запись.ID = "[error]"; КонецПопытки;
            Попытка
                Найденный = Список.FindByID(Запись.ID);
                Запись.Found = Найденный = Элемент;
            Исключение Запись.Found = "[error]"; КонецПопытки;
            Итог.Add(Запись);
        КонецЦикла;
    Исключение Итог.Add("[iteration-error]"); КонецПопытки;
    Возврат Итог;
КонецФункции

Функция КодекСпискаПробы(Знач Вид)
    Список = НовыйСписокПробы("empty");
    Первый = Неопределено;
    Второй = Неопределено;
    Если Вид <> "empty" Тогда
        Первый = Список.Add(10, "first", Истина);
        Второй = Список.Add(20, "second", Ложь);
    КонецЕсли;
    Если Вид = "history" Тогда
        Список.Delete(0);
        Список.Add(30, "third", Истина);
        Список.Move(0, 1);
    ИначеЕсли Вид = "base" Тогда
        Первый.Value = "Я😀";
        Вложенный = Новый Массив;
        Вложенный.Add(10);
        Вложенный.Add(Null);
        Вложенный.Add(Неопределено);
        Второй.Value = Вложенный;
    КонецЕсли;
    Объект = Список;
    Если Вид = "item" Тогда
        Объект = Первый;
    КонецЕсли;
    Итог = Новый Структура("TypeWrite,TypeRead,Write,ReadType,ReadWrite,ReadView,Equal");
    Если Вид = "history" Тогда
        Итог.Insert("IDs", ИдентификаторыСпискаПробы(Список));
    КонецЕсли;
    Попытка Итог.TypeWrite = ЗначениеВСтрокуВнутр(ТипЗнч(Объект));
    Исключение Итог.TypeWrite = "[error]"; КонецПопытки;
    Попытка
        ТипКопии = ЗначениеИзСтрокиВнутр(Итог.TypeWrite);
        Итог.TypeRead = Новый Структура("Equal,Stable", ТипКопии = ТипЗнч(Объект), ЗначениеВСтрокуВнутр(ТипКопии) = Итог.TypeWrite);
    Исключение Итог.TypeRead = "[error]"; КонецПопытки;
    Попытка Итог.Write = ЗначениеВСтрокуВнутр(Объект);
    Исключение Итог.Write = "[error]"; КонецПопытки;
    Попытка
        Копия = ЗначениеИзСтрокиВнутр(Итог.Write);
        Итог.ReadType = Строка(ТипЗнч(Копия));
        Попытка
            Повтор = ЗначениеВСтрокуВнутр(Копия);
            Итог.ReadWrite = ?(Повтор = Итог.Write, "same-as-Write", Повтор);
        Исключение Итог.ReadWrite = "[error]"; КонецПопытки;
        Если Вид = "history" Тогда
            Итог.Insert("ReadIDs", ИдентификаторыСпискаПробы(Копия));
        КонецЕсли;
        Попытка Итог.ReadView = ОтветСпискаПробы(Копия, Объект);
        Исключение Итог.ReadView = "[error]"; КонецПопытки;
        Попытка Итог.Equal = Копия = Объект;
        Исключение Итог.Equal = "[error]"; КонецПопытки;
    Исключение Итог.ReadType = "[error]"; КонецПопытки;
    Возврат Итог;
КонецФункции
// Конец компактных проб списка значений.

// Начало уточняющих проб списка значений.
Функция ВозвращенныеЭлементыСпискаПробы()
    Список = НовыйСписокПробы("empty");
    Первый = Список.Add(10);
    Второй = Список.Insert(0, 20);
    Итог = Новый Структура("Add,Insert,FindValue,FindID,WriteStatus,After");
    Итог.WriteStatus = "ok";
    Попытка Итог.Add = Первый = Список.Get(1);
    Исключение Итог.Add = "[error]"; КонецПопытки;
    Попытка Итог.Insert = Второй = Список.Get(0);
    Исключение Итог.Insert = "[error]"; КонецПопытки;
    Попытка Итог.FindValue = Список.FindByValue(10) = Первый;
    Исключение Итог.FindValue = "[error]"; КонецПопытки;
    Попытка Итог.FindID = Список.FindByID(Второй.GetID()) = Второй;
    Исключение Итог.FindID = "[error]"; КонецПопытки;
    Попытка Первый.Value = 11;
    Исключение Итог.WriteStatus = "error"; КонецПопытки;
    Итог.After = ПоляСпискаПробы(Список);
    Возврат Итог;
КонецФункции

Функция ЧужойСдвигСпискаПробы()
    Ответы = Новый Массив;
    Для Каждого Случай Из СтрРазделить("different-value|reordered|missing-id|deleted", "|") Цикл
        Список = НовыйСписокПробы();
        Список.Add(30, "third");
        ЧужойСписок = НовыйСписокПробы("empty");
        ЧужойСписок.Add(100, "foreign-first");
        Чужой = ЧужойСписок.Add(200, "foreign-second");
        ЧужойСписок.Add(300, "foreign-third");
        Если Случай = "reordered" Тогда
            ЧужойСписок.Move(Чужой, -1);
        ИначеЕсли Случай = "missing-id" Тогда
            Чужой = ЧужойСписок.Add(400, "foreign-fourth");
            ЧужойСписок.Move(Чужой, -3);
        ИначеЕсли Случай = "deleted" Тогда
            ЧужойСписок.Delete(Чужой);
        КонецЕсли;
        Итог = Новый Структура("Case,ID,ForeignIndex,Status,Target,Foreign", Случай);
        Итог.Status = "ok";
        Попытка Итог.ID = Чужой.GetID();
        Исключение Итог.ID = "[error]"; КонецПопытки;
        Попытка Итог.ForeignIndex = ЧужойСписок.IndexOf(Чужой);
        Исключение Итог.ForeignIndex = "[error]"; КонецПопытки;
        Попытка Список.Move(Чужой, 1);
        Исключение Итог.Status = "error"; КонецПопытки;
        Итог.Target = ПоляСпискаПробы(Список);
        Итог.Foreign = ПоляСпискаПробы(ЧужойСписок);
        Ответы.Add(Итог);
    КонецЦикла;
    Возврат Ответы;
КонецФункции
// Конец уточняющих проб списка значений.

// Начало компактных проб сортировки списка.
// Порядок — позиции исходных живых элементов, а не значения/представления.
Функция ПорядокСортировкиСписка(Знач Список, Знач Исходные)
    Итог = Новый Структура("Count,Order");
    Попытка Итог.Count = Список.Count();
    Исключение Итог.Count = "[error]"; КонецПопытки;
    Порядок = Новый Массив;
    Итог.Order = Порядок;
    Попытка
        Для Каждого Элемент Из Список Цикл
            Если Порядок.Count() >= 12 Тогда
                Порядок.Add("[limit]"); Прервать;
            КонецЕсли;
            Позиция = -1;
            Для Номер = 0 По Исходные.Count() - 1 Цикл
                Если Элемент = Исходные[Номер] Тогда Позиция = Номер; КонецЕсли;
            КонецЦикла;
            Порядок.Add(Позиция);
        КонецЦикла;
    Исключение Порядок.Add("[iteration-error]"); КонецПопытки;
    Возврат Итог;
КонецФункции

Функция НаборСортировкиСписка(Знач Вид)
    Список = Новый ValueList;
    Ключи = Новый Массив;
    Если Вид = "numeric" Тогда
        Ключи.Add(2.1); Ключи.Add(-1); Ключи.Add(2.10); Ключи.Add(0); Ключи.Add(-1);
    ИначеЕсли Вид = "boolean" Тогда
        Ключи.Add(Истина); Ключи.Add(Ложь); Ключи.Add(Истина); Ключи.Add(Ложь);
    ИначеЕсли Вид = "date" Тогда
        Ключи.Add(Дата(2024, 1, 2)); Ключи.Add(Дата(2024, 1, 1, 12, 0, 0));
        Ключи.Add(Дата(2024, 1, 1)); Ключи.Add(Дата(2024, 1, 1, 12, 0, 0));
    ИначеЕсли Вид = "mixed" Тогда
        Ключи.Add("2"); Ключи.Add(Дата(2024, 1, 1)); Ключи.Add(2);
        Ключи.Add(Истина); Ключи.Add(Неопределено); Ключи.Add(Null); Ключи.Add(Ложь); Ключи.Add(0);
    ИначеЕсли Вид = "nulls" Тогда
        Ключи.Add(Null); Ключи.Add(Неопределено); Ключи.Add(Null); Ключи.Add(Неопределено);
    ИначеЕсли Вид = "strings" Тогда
        Ключи = СтрРазделить("a|A|á|a |a-1|a1|a10|a2|ё|е|Е|Ё", "|");
    ИначеЕсли Вид = "unicode" Тогда
        Ключи = СтрРазделить("я|😀|😁|𐀀||é|é|ß|SS|İ|i", "|");
    ИначеЕсли Вид = "objects" Тогда
        Ключи.Add(Новый Массив); Ключи.Add(Новый Структура); Ключи.Add(Ключи[0]); Ключи.Add(Новый Массив);
    ИначеЕсли Вид = "types" Тогда
        Ключи.Add(Тип("Строка")); Ключи.Add(Тип("Число")); Ключи.Add(Тип("Строка"));
    ИначеЕсли Вид = "enums" Тогда
        Ключи.Add(SortDirection.Desc); Ключи.Add(SortDirection.Asc); Ключи.Add(SortDirection.Desc);
    ИначеЕсли Вид = "singleton" Тогда
        Ключи.Add(7);
    ИначеЕсли Вид <> "empty" Тогда
        Ключи.Add(30); Ключи.Add(10); Ключи.Add(20); Ключи.Add(10);
    КонецЕсли;
    Для Номер = 0 По Ключи.Count() - 1 Цикл
        Представление = Строка(Номер);
        Если Вид = "strings" Или Вид = "unicode" Тогда
            Представление = Ключи[Номер];
        ИначеЕсли Вид = "duplicates" Тогда
            Представление = ?(Номер = 0 Или Номер = 2, "b", "a");
        ИначеЕсли Вид = "blank" Тогда
            Представление = ?(Номер = 1, "15", "");
        КонецЕсли;
        Список.Add(Ключи[Номер], Представление, Номер = 0);
    КонецЦикла;
    Если Вид = "history" Тогда
        Список.Delete(1); Список.Insert(0, 15, "x", Истина);
    КонецЕсли;
    Возврат Список;
КонецФункции

Функция ДействиеСортировкиСписка(Знач Вид, Знач Команда)
    Список = НаборСортировкиСписка(Вид);
    Исходные = Новый Массив;
    Для Каждого Элемент Из Список Цикл Исходные.Add(Элемент); КонецЦикла;
    Итог = Новый Структура("Status,After", "ok");
    Если Вид = "history" Тогда
        Итог.Insert("BeforeIDs", ИдентификаторыСпискаПробы(Список));
    КонецЕсли;
    Попытка Выполнить(Команда);
    Исключение Итог.Status = "error"; КонецПопытки;
    Итог.After = ПорядокСортировкиСписка(Список, Исходные);
    Если Вид = "history" Тогда
        Итог.Insert("AfterIDs", ИдентификаторыСпискаПробы(Список));
        Итог.Insert("Fields", ПоляСпискаПробы(Список));
        Ссылки = Новый Массив;
        Для Каждого Элемент Из Исходные Цикл
            Запись = Новый Структура("ID,Index,Same");
            Попытка Запись.ID = Элемент.GetID(); Исключение Запись.ID = "[error]"; КонецПопытки;
            Попытка Запись.Index = Список.IndexOf(Элемент); Исключение Запись.Index = "[error]"; КонецПопытки;
            Попытка Запись.Same = Список.FindByID(Запись.ID) = Элемент; Исключение Запись.Same = "[error]"; КонецПопытки;
            Ссылки.Add(Запись);
        КонецЦикла;
        Итог.Insert("Saved", Ссылки);
    КонецЕсли;
    Возврат Итог;
КонецФункции

Функция СерияСортировкиСписка(Знач Вид, Знач Команды)
    Итоги = Новый Массив;
    Для Каждого Команда Из СтрРазделить(Команды, "|") Цикл
        Итоги.Add(ДействиеСортировкиСписка(Вид, Команда));
    КонецЦикла;
    Возврат Итоги;
КонецФункции

Функция ТипНаправленияСортировкиПробы()
    Итог = Новый Структура("TypeRU,TypeEN,AscAlias,DescAlias,Distinct,AscText,DescText,Namespace,Iteration");
    Попытка Итог.TypeRU = ТипЗнч(SortDirection.Asc) = Тип("НаправлениеСортировки"); Исключение Итог.TypeRU = "[error]"; КонецПопытки;
    Попытка Итог.TypeEN = ТипЗнч(НаправлениеСортировки.Убыв) = Тип("SortDirection"); Исключение Итог.TypeEN = "[error]"; КонецПопытки;
    Попытка Итог.AscAlias = SortDirection.Asc = НаправлениеСортировки.Возр; Исключение Итог.AscAlias = "[error]"; КонецПопытки;
    Попытка Итог.DescAlias = SortDirection.Desc = НаправлениеСортировки.Убыв; Исключение Итог.DescAlias = "[error]"; КонецПопытки;
    Попытка Итог.Distinct = SortDirection.Asc <> SortDirection.Desc; Исключение Итог.Distinct = "[error]"; КонецПопытки;
    Попытка Итог.AscText = Строка(SortDirection.Asc); Исключение Итог.AscText = "[error]"; КонецПопытки;
    Попытка Итог.DescText = Строка(SortDirection.Desc); Исключение Итог.DescText = "[error]"; КонецПопытки;
    Попытка Итог.Namespace = Строка(SortDirection); Исключение Итог.Namespace = "[error]"; КонецПопытки;
    Порядок = Новый Массив; Итог.Iteration = Порядок;
    Попытка
        Для Каждого Направление Из SortDirection Цикл
            Если Порядок.Count() >= 4 Тогда Порядок.Add("[limit]"); Прервать; КонецЕсли;
            Порядок.Add(Новый Структура("Asc,Desc", Направление = SortDirection.Asc, Направление = SortDirection.Desc));
        КонецЦикла;
    Исключение Порядок.Add("[iteration-error]"); КонецПопытки;
    Возврат Итог;
КонецФункции

Функция КодекНаправленияСортировкиПробы(Знач Направление, Знач СТипом = Ложь)
    Итог = Новый Структура("Write,ReadType,ReadEqual,ReadWrite");
    Если СТипом Тогда
        Итог.Insert("TypeWrite"); Итог.Insert("TypeRead");
        Попытка Итог.TypeWrite = ЗначениеВСтрокуВнутр(ТипЗнч(Направление)); Исключение Итог.TypeWrite = "[error]"; КонецПопытки;
        Попытка
            ТипКопии = ЗначениеИзСтрокиВнутр(Итог.TypeWrite);
            Итог.TypeRead = Новый Структура("Equal,Stable", ТипКопии = ТипЗнч(Направление), ЗначениеВСтрокуВнутр(ТипКопии) = Итог.TypeWrite);
        Исключение Итог.TypeRead = "[error]"; КонецПопытки;
    КонецЕсли;
    Попытка Итог.Write = ЗначениеВСтрокуВнутр(Направление); Исключение Итог.Write = "[error]"; КонецПопытки;
    Попытка
        Копия = ЗначениеИзСтрокиВнутр(Итог.Write);
        Попытка Итог.ReadType = ТипЗнч(Копия) = ТипЗнч(Направление); Исключение Итог.ReadType = "[error]"; КонецПопытки;
        Попытка Итог.ReadEqual = Копия = Направление; Исключение Итог.ReadEqual = "[error]"; КонецПопытки;
        Попытка
            Повтор = ЗначениеВСтрокуВнутр(Копия);
            Итог.ReadWrite = ?(Повтор = Итог.Write, "same-as-Write", Повтор);
        Исключение Итог.ReadWrite = "[error]"; КонецПопытки;
    Исключение Итог.ReadType = "[error]"; КонецПопытки;
    Возврат Итог;
КонецФункции
// Конец компактных проб сортировки списка.

#Область МассивыИСтруктуры
// Типичный конвейер: массив записей, расчет суммы и сбор кодов для выгрузки.
Позиции = Новый Массив;
Позиции.Добавить(Новый Структура("Код,Цена,Количество", "а", 10, 2));
Позиции.Добавить(Новый Структура("Код,Цена,Количество", "б", 3, 5));
