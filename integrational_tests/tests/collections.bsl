КонтрольСтруктура = Новый Структура;
КонтрольСоответствие = Новый Соответствие;
ПроверитьЗаполненность("filled.array.empty", КонтрольМассив);
ПроверитьЗаполненность("filled.structure.empty", КонтрольСтруктура);
