// Каждая мутация начинается с одной и той же независимой таблицы.
// Статус и конечные поля сохраняются даже при частичном изменении и ошибке.
Функция ИзменениеТаблицыПробы(Знач Сценарий)
    Таблица = НоваяТаблицаПробы();
    Колонки = Таблица.Колонки;
    Колонка = Колонки[0];
    СтрокаТаблицы = Таблица[0];
    ДругаяТаблица = НоваяТаблицаПробы();
