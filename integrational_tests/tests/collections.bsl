    Итог.Insert("AfterAction", ПоляКэшаСписка(Список));
    Если Элемент = Неопределено Тогда Итог.Insert("BetweenStatus", "not-run");
    Иначе Итог.Insert("BetweenStatus", ПолеИнициализацииКэша(Элемент, "presentation", "between")); КонецЕсли;
    Итог.Insert("FirstState", ПоляКэшаСписка(Список));
    Итог.Insert("First", РезультатТекстаСписка(Список));
    Если Элемент = Неопределено Тогда Итог.Insert("AfterStatus", "not-run");
    Иначе Итог.Insert("AfterStatus", ПолеИнициализацииКэша(Элемент, "presentation", "second")); КонецЕсли;
    Итог.Insert("After", ПоляКэшаСписка(Список));
    Если Элемент = Неопределено Тогда Итог.Insert("ItemAfter", "not-run");
    Иначе Итог.Insert("ItemAfter", РезультатТекстаСписка(Элемент)); КонецЕсли;
    Итог.Insert("Second", РезультатТекстаСписка(Список));
    Возврат Итог;
КонецФункции

Функция КопияКэшаСписка()
    Список = Новый ValueList; Копия = Неопределено;
    Итог = Новый Структура("Prepare", "ok");
    Попытка Элемент = Список.Add(7, "start");
    Исключение Итог.Prepare = "error"; Возврат Итог; КонецПопытки;
    Итог.Insert("Warm", РезультатТекстаСписка(Список));
    Итог.Insert("PendingStatus", ПолеИнициализацииКэша(Элемент, "presentation", "source-current"));
    Итог.Insert("Before", ПоляКэшаСписка(Список));
    Итог.Insert("Status", "ok");
    Попытка Копия = Список.Copy();
    Исключение Итог.Status = "error"; КонецПопытки;
    Итог.Insert("SourceAfter", ПоляКэшаСписка(Список));
    Если Копия = Неопределено Тогда
        Для Каждого Поле Из СтрРазделить("CopyAfter|BetweenStatus|Between|First|AfterStatus|After|Second", "|") Цикл
            Итог.Insert(Поле, "not-run");
        КонецЦикла;
        Итог.Insert("Source", РезультатТекстаСписка(Список));
        Итог.Insert("SourceItem", РезультатТекстаСписка(Элемент));
        Возврат Итог;
    КонецЕсли;
    Итог.Insert("CopyAfter", ПоляКэшаСписка(Копия));
    Итог.Insert("BetweenStatus", ПоменятьПервыйКэшСписка(Копия, 8, "copy-between"));
    Итог.Insert("Between", ПоляКэшаСписка(Копия));
    Итог.Insert("First", РезультатТекстаСписка(Копия));
    Итог.Insert("Source", РезультатТекстаСписка(Список));
    Итог.Insert("SourceItem", РезультатТекстаСписка(Элемент));
    Итог.Insert("AfterStatus", ПоменятьПервыйКэшСписка(Копия, 9, "copy-after"));
    Итог.Insert("After", ПоляКэшаСписка(Копия));
    Итог.Insert("Second", РезультатТекстаСписка(Копия));
    Возврат Итог;
КонецФункции
