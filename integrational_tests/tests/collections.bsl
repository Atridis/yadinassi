КонецФункции

Функция ЧужойСдвигСпискаПробы()
    Ответы = Новый Массив;
    Для Каждого Случай Из СтрРазделить("different-value|reordered|missing-id|deleted", "|") Цикл
        Список = НовыйСписокПробы();
        Список.Add(30, "third");
        ЧужойСписок = НовыйСписокПробы("empty");
        ЧужойСписок.Add(100, "foreign-first");
        Чужой = ЧужойСписок.Add(200, "foreign-second");
        ЧужойСписок.Add(300, "foreign-third");
        Если Случай = "reordered" Тогда
            ЧужойСписок.Move(Чужой, -1);
        ИначеЕсли Случай = "missing-id" Тогда
            Чужой = ЧужойСписок.Add(400, "foreign-fourth");
            ЧужойСписок.Move(Чужой, -3);
        ИначеЕсли Случай = "deleted" Тогда
            ЧужойСписок.Delete(Чужой);
        КонецЕсли;
        Итог = Новый Структура("Case,ID,ForeignIndex,Status,Target,Foreign", Случай);
        Итог.Status = "ok";
        Попытка Итог.ID = Чужой.GetID();
        Исключение Итог.ID = "[error]"; КонецПопытки;
        Попытка Итог.ForeignIndex = ЧужойСписок.IndexOf(Чужой);
        Исключение Итог.ForeignIndex = "[error]"; КонецПопытки;
        Попытка Список.Move(Чужой, 1);
        Исключение Итог.Status = "error"; КонецПопытки;
        Итог.Target = ПоляСпискаПробы(Список);
        Итог.Foreign = ПоляСпискаПробы(ЧужойСписок);
        Ответы.Add(Итог);
    КонецЦикла;
    Возврат Ответы;
КонецФункции
// Конец уточняющих проб списка значений.

// Начало компактных проб сортировки списка.
// Порядок — позиции исходных живых элементов, а не значения/представления.
Функция ПорядокСортировкиСписка(Знач Список, Знач Исходные)
    Итог = Новый Структура("Count,Order");
    Попытка Итог.Count = Список.Count();
    Исключение Итог.Count = "[error]"; КонецПопытки;
    Порядок = Новый Массив;
    Итог.Order = Порядок;
    Попытка
        Для Каждого Элемент Из Список Цикл
            Если Порядок.Count() >= 12 Тогда
                Порядок.Add("[limit]"); Прервать;
            КонецЕсли;
            Позиция = -1;
            Для Номер = 0 По Исходные.Count() - 1 Цикл
                Если Элемент = Исходные[Номер] Тогда Позиция = Номер; КонецЕсли;
            КонецЦикла;
            Порядок.Add(Позиция);
        КонецЦикла;
    Исключение Порядок.Add("[iteration-error]"); КонецПопытки;
    Возврат Итог;
КонецФункции

Функция НаборСортировкиСписка(Знач Вид)
    Список = Новый ValueList;
    Ключи = Новый Массив;
    Если Вид = "numeric" Тогда
        Ключи.Add(2.1); Ключи.Add(-1); Ключи.Add(2.10); Ключи.Add(0); Ключи.Add(-1);
    ИначеЕсли Вид = "boolean" Тогда
        Ключи.Add(Истина); Ключи.Add(Ложь); Ключи.Add(Истина); Ключи.Add(Ложь);
    ИначеЕсли Вид = "date" Тогда
        Ключи.Add(Дата(2024, 1, 2)); Ключи.Add(Дата(2024, 1, 1, 12, 0, 0));
        Ключи.Add(Дата(2024, 1, 1)); Ключи.Add(Дата(2024, 1, 1, 12, 0, 0));
    ИначеЕсли Вид = "mixed" Тогда
        Ключи.Add("2"); Ключи.Add(Дата(2024, 1, 1)); Ключи.Add(2);
        Ключи.Add(Истина); Ключи.Add(Неопределено); Ключи.Add(Null); Ключи.Add(Ложь); Ключи.Add(0);
    ИначеЕсли Вид = "nulls" Тогда
        Ключи.Add(Null); Ключи.Add(Неопределено); Ключи.Add(Null); Ключи.Add(Неопределено);
    ИначеЕсли Вид = "strings" Тогда
        Ключи = СтрРазделить("a|A|á|a |a-1|a1|a10|a2|ё|е|Е|Ё", "|");
    ИначеЕсли Вид = "unicode" Тогда
        Ключи = СтрРазделить("я|😀|😁|𐀀||é|é|ß|SS|İ|i", "|");
    ИначеЕсли Вид = "objects" Тогда
        Ключи.Add(Новый Массив); Ключи.Add(Новый Структура); Ключи.Add(Ключи[0]); Ключи.Add(Новый Массив);
    ИначеЕсли Вид = "types" Тогда
        Ключи.Add(Тип("Строка")); Ключи.Add(Тип("Число")); Ключи.Add(Тип("Строка"));
    ИначеЕсли Вид = "enums" Тогда
        Ключи.Add(SortDirection.Desc); Ключи.Add(SortDirection.Asc); Ключи.Add(SortDirection.Desc);
    ИначеЕсли Вид = "singleton" Тогда
        Ключи.Add(7);
    ИначеЕсли Вид <> "empty" Тогда
        Ключи.Add(30); Ключи.Add(10); Ключи.Add(20); Ключи.Add(10);
    КонецЕсли;
    Для Номер = 0 По Ключи.Count() - 1 Цикл
        Представление = Строка(Номер);
        Если Вид = "strings" Или Вид = "unicode" Тогда
            Представление = Ключи[Номер];
        ИначеЕсли Вид = "duplicates" Тогда
            Представление = ?(Номер = 0 Или Номер = 2, "b", "a");
        ИначеЕсли Вид = "blank" Тогда
            Представление = ?(Номер = 1, "15", "");
        КонецЕсли;
        Список.Add(Ключи[Номер], Представление, Номер = 0);
    КонецЦикла;
    Если Вид = "history" Тогда
        Список.Delete(1); Список.Insert(0, 15, "x", Истина);
    КонецЕсли;
    Возврат Список;
КонецФункции

Функция ДействиеСортировкиСписка(Знач Вид, Знач Команда)
    Список = НаборСортировкиСписка(Вид);
    Исходные = Новый Массив;
    Для Каждого Элемент Из Список Цикл Исходные.Add(Элемент); КонецЦикла;
    Итог = Новый Структура("Status,After", "ok");
    Если Вид = "history" Тогда
        Итог.Insert("BeforeIDs", ИдентификаторыСпискаПробы(Список));
    КонецЕсли;
    Попытка Выполнить(Команда);
    Исключение Итог.Status = "error"; КонецПопытки;
    Итог.After = ПорядокСортировкиСписка(Список, Исходные);
    Если Вид = "history" Тогда
        Итог.Insert("AfterIDs", ИдентификаторыСпискаПробы(Список));
        Итог.Insert("Fields", ПоляСпискаПробы(Список));
        Ссылки = Новый Массив;
        Для Каждого Элемент Из Исходные Цикл
            Запись = Новый Структура("ID,Index,Same");
            Попытка Запись.ID = Элемент.GetID(); Исключение Запись.ID = "[error]"; КонецПопытки;
            Попытка Запись.Index = Список.IndexOf(Элемент); Исключение Запись.Index = "[error]"; КонецПопытки;
            Попытка Запись.Same = Список.FindByID(Запись.ID) = Элемент; Исключение Запись.Same = "[error]"; КонецПопытки;
            Ссылки.Add(Запись);
        КонецЦикла;
        Итог.Insert("Saved", Ссылки);
    КонецЕсли;
    Возврат Итог;
КонецФункции

Функция СерияСортировкиСписка(Знач Вид, Знач Команды)
    Итоги = Новый Массив;
    Для Каждого Команда Из СтрРазделить(Команды, "|") Цикл
        Итоги.Add(ДействиеСортировкиСписка(Вид, Команда));
    КонецЦикла;
    Возврат Итоги;
КонецФункции

Функция ТипНаправленияСортировкиПробы()
    Итог = Новый Структура("TypeRU,TypeEN,AscAlias,DescAlias,Distinct,AscText,DescText,Namespace,Iteration");
    Попытка Итог.TypeRU = ТипЗнч(SortDirection.Asc) = Тип("НаправлениеСортировки"); Исключение Итог.TypeRU = "[error]"; КонецПопытки;
    Попытка Итог.TypeEN = ТипЗнч(НаправлениеСортировки.Убыв) = Тип("SortDirection"); Исключение Итог.TypeEN = "[error]"; КонецПопытки;
    Попытка Итог.AscAlias = SortDirection.Asc = НаправлениеСортировки.Возр; Исключение Итог.AscAlias = "[error]"; КонецПопытки;
    Попытка Итог.DescAlias = SortDirection.Desc = НаправлениеСортировки.Убыв; Исключение Итог.DescAlias = "[error]"; КонецПопытки;
    Попытка Итог.Distinct = SortDirection.Asc <> SortDirection.Desc; Исключение Итог.Distinct = "[error]"; КонецПопытки;
    Попытка Итог.AscText = Строка(SortDirection.Asc); Исключение Итог.AscText = "[error]"; КонецПопытки;
    Попытка Итог.DescText = Строка(SortDirection.Desc); Исключение Итог.DescText = "[error]"; КонецПопытки;
    Попытка Итог.Namespace = Строка(SortDirection); Исключение Итог.Namespace = "[error]"; КонецПопытки;
    Порядок = Новый Массив; Итог.Iteration = Порядок;
    Попытка
        Для Каждого Направление Из SortDirection Цикл
            Если Порядок.Count() >= 4 Тогда Порядок.Add("[limit]"); Прервать; КонецЕсли;
            Порядок.Add(Новый Структура("Asc,Desc", Направление = SortDirection.Asc, Направление = SortDirection.Desc));
        КонецЦикла;
    Исключение Порядок.Add("[iteration-error]"); КонецПопытки;
    Возврат Итог;
КонецФункции

Функция КодекНаправленияСортировкиПробы(Знач Направление, Знач СТипом = Ложь)
    Итог = Новый Структура("Write,ReadType,ReadEqual,ReadWrite");
    Если СТипом Тогда
        Итог.Insert("TypeWrite"); Итог.Insert("TypeRead");
        Попытка Итог.TypeWrite = ЗначениеВСтрокуВнутр(ТипЗнч(Направление)); Исключение Итог.TypeWrite = "[error]"; КонецПопытки;
        Попытка
            ТипКопии = ЗначениеИзСтрокиВнутр(Итог.TypeWrite);
            Итог.TypeRead = Новый Структура("Equal,Stable", ТипКопии = ТипЗнч(Направление), ЗначениеВСтрокуВнутр(ТипКопии) = Итог.TypeWrite);
        Исключение Итог.TypeRead = "[error]"; КонецПопытки;
    КонецЕсли;
    Попытка Итог.Write = ЗначениеВСтрокуВнутр(Направление); Исключение Итог.Write = "[error]"; КонецПопытки;
    Попытка
        Копия = ЗначениеИзСтрокиВнутр(Итог.Write);
        Попытка Итог.ReadType = ТипЗнч(Копия) = ТипЗнч(Направление); Исключение Итог.ReadType = "[error]"; КонецПопытки;
        Попытка Итог.ReadEqual = Копия = Направление; Исключение Итог.ReadEqual = "[error]"; КонецПопытки;
        Попытка
            Повтор = ЗначениеВСтрокуВнутр(Копия);
            Итог.ReadWrite = ?(Повтор = Итог.Write, "same-as-Write", Повтор);
        Исключение Итог.ReadWrite = "[error]"; КонецПопытки;
    Исключение Итог.ReadType = "[error]"; КонецПопытки;
    Возврат Итог;
КонецФункции
// Конец компактных проб сортировки списка.

// Начало компактных проб копирования списка.
// Снимки не содержат живых элементов списка. Вложенный числовой массив
// копируется для наблюдения, чтобы последующая мутация не меняла Before.
Функция ПозицияСсылкиКопииСписка(Знач Список, Знач Элемент)
    Если Элемент = Неопределено Тогда Возврат -1; КонецЕсли;
    Номер = 0;
    Для Каждого Проверяемый Из Список Цикл
        Если Номер >= 8 Тогда Возврат "[limit]"; КонецЕсли;
        Если Проверяемый = Элемент Тогда Возврат Номер; КонецЕсли;
        Номер = Номер + 1;
    КонецЦикла;
    Возврат -2; // Найден объект, которого нет при независимом обходе владельца.
КонецФункции

Функция РазмерыКопииСписка(Знач Список, Знач Копия)
    Итог = Новый Массив;
    Попытка Итог.Add(Список.Count()); Исключение Итог.Add("[error]"); КонецПопытки;
    Попытка Итог.Add(Копия.Count()); Исключение Итог.Add("[error]"); КонецПопытки;
    Возврат Итог;
КонецФункции

Функция СнимокКопированияСписка(Знач Список)
    Итог = Новый Структура("Count,Items,Find");
    Попытка Итог.Count = Список.Count(); Исключение Итог.Count = "[error]"; КонецПопытки;
    Строки = Новый Массив;
    Итог.Items = Строки;
    Попытка
        Для Каждого Элемент Из Список Цикл
            Если Строки.Count() >= 8 Тогда Строки.Add("[limit]"); Прервать; КонецЕсли;
            Поля = ПоляЭлементаСписка(Элемент);
            Если ТипЗнч(Поля[0]) = Тип("Массив") Тогда
                Значения = Новый Массив;
                Для Каждого Значение Из Поля[0] Цикл
                    Если Значения.Count() >= 8 Тогда Значения.Add("[limit]"); Прервать; КонецЕсли;
                    Значения.Add(Значение);
                КонецЦикла;
                Поля[0] = Значения;
            КонецЕсли;
            Идентификатор = Неопределено;
            Попытка Идентификатор = Элемент.GetID(); Поля.Add(Идентификатор);
            Исключение Поля.Add("[id-error]"); КонецПопытки;
            Попытка Поля.Add(Список.FindByID(Идентификатор) = Элемент);
            Исключение Поля.Add("[find-error]"); КонецПопытки;
            Строки.Add(Поля);
        КонецЦикла;
    Исключение Строки.Add("[iteration-error]"); КонецПопытки;
    Поиск = Новый Массив;
    Итог.Find = Поиск;
    // Нулевые/удалённые ID также наблюдаются, а не только ID живых элементов.
    Для Номер = 0 По 5 Цикл
        Попытка
            Найденный = Список.FindByID(Номер);
            Поиск.Add(ПозицияСсылкиКопииСписка(Список, Найденный));
        Исключение Поиск.Add("[error]"); КонецПопытки;
    КонецЦикла;
    Возврат Итог;
КонецФункции

Функция ДобавлениеПослеКопииСписка(Знач Список, Знач Представление)
    Итог = Новый Структура("Status,ID,Found,Index", "ok");
    Элемент = Неопределено;
    Попытка Элемент = Список.Add(99, Представление, Истина);
    Исключение Итог.Status = "error"; КонецПопытки;
    Попытка Итог.ID = Элемент.GetID(); Исключение Итог.ID = "[error]"; КонецПопытки;
    Попытка Итог.Found = Список.FindByID(Итог.ID) = Элемент;
    Исключение Итог.Found = "[error]"; КонецПопытки;
    Попытка Итог.Index = ПозицияСсылкиКопииСписка(Список, Элемент); Исключение Итог.Index = "[error]"; КонецПопытки;
    Возврат Итог;
КонецФункции

Функция ИсторияКопированияСписка(Знач Вид)
    Список = Новый ValueList;
    Копия = Неопределено;
    Вложенный = Новый Массив; Вложенный.Add(1);
    Итог = Новый Структура("Prepare,Before,ReferenceStatus,Status,Source,Copy,SameList,SourceLinks,CopyLinks", "ok");
    Попытка
        Если Вид = "nested" Тогда
            Список.Add(10, "z", Ложь); Список.Add(Вложенный, "b", Истина);
            Список.Add(20, "a", Ложь); Список.Delete(0); Список.SortByPresentation();
        ИначеЕсли Вид <> "fresh-empty" Тогда
            Список.Add(30, "b", Истина); Список.Add(10, "c", Ложь); Список.Add(20, "a", Истина);
            Если Вид = "value-asc" Тогда Список.SortByValue();
            ИначеЕсли Вид = "value-desc" Тогда Список.SortByValue(SortDirection.Desc);
            ИначеЕсли Вид = "presentation-asc" Тогда Список.SortByPresentation();
            ИначеЕсли Вид = "presentation-desc" Тогда Список.SortByPresentation(SortDirection.Desc);
            ИначеЕсли Вид = "deleted-reordered" Тогда
                // Count=2, max live ID+1=3, allocated high-water=4 различаются.
                Список.Add(40, "d", Ложь); Список.Delete(3); Список.Delete(1); Список.Move(1, -1);
            ИначеЕсли Вид = "clear-empty" Или Вид = "clear-refilled" Тогда
                Список.Clear();
                Если Вид = "clear-refilled" Тогда
                    Список.Add(20, "b", Ложь); Список.Add(10, "a", Истина);
                КонецЕсли;
            КонецЕсли;
        КонецЕсли;
    Исключение Итог.Prepare = "error"; КонецПопытки;
    Итог.Before = СнимокКопированияСписка(Список);
    Если Итог.Prepare <> "ok" Тогда
        Итог.Status = "not-run";
        Возврат Итог;
    КонецЕсли;
    Исходные = Новый Массив;
    Итог.ReferenceStatus = "ok";
    Попытка
        Для Каждого Элемент Из Список Цикл
            Если Исходные.Count() >= 8 Тогда Итог.ReferenceStatus = "limit"; Прервать; КонецЕсли;
            Исходные.Add(Элемент);
        КонецЦикла;
    Исключение Итог.ReferenceStatus = "error"; КонецПопытки;
    Итог.Status = "ok";
    Попытка
        Если Вид = "fresh" Или Вид = "presentation-desc" Или Вид = "clear-refilled" Тогда
            Копия = Список.Скопировать();
        Иначе Копия = Список.Copy(); КонецЕсли;
    Исключение Итог.Status = "error"; КонецПопытки;
    // Оба владельца остаются живыми до всех чтений ID и последующих Add.
    Итог.Source = СнимокКопированияСписка(Список);
    Итог.Copy = СнимокКопированияСписка(Копия);
    Итог.SameList = Список = Копия;
    Если Итог.ReferenceStatus = "ok" Тогда
        Попытка Итог.SourceLinks = ПорядокСортировкиСписка(Список, Исходные);
        Исключение Итог.SourceLinks = "[error]"; КонецПопытки;
        Попытка Итог.CopyLinks = ПорядокСортировкиСписка(Копия, Исходные);
        Исключение Итог.CopyLinks = "[error]"; КонецПопытки;
    Иначе Итог.SourceLinks = "not-run"; Итог.CopyLinks = "not-run"; КонецЕсли;
    Если Вид = "nested" Тогда
        Связи = Новый Структура("SameValue,SharedStatus,SharedSource,SharedCopy,FieldsStatus,Source,Copy");
        Итог.Insert("Nested", Связи);
        Попытка Связи.SameValue = Список.Get(1).Value = Копия.Get(1).Value;
        Исключение Связи.SameValue = "[error]"; КонецПопытки;
        Связи.SharedStatus = "ok";
        Попытка
            ДругойЭлемент = Копия.Get(1); ДругойМассив = ДругойЭлемент.Value; ДругойМассив.Add(2);
        Исключение Связи.SharedStatus = "error"; КонецПопытки;
        Связи.SharedSource = СнимокКопированияСписка(Список);
        Связи.SharedCopy = СнимокКопированияСписка(Копия);
        Связи.FieldsStatus = "ok";
        Попытка
            ДругойЭлемент = Копия.Get(1); ДругойЭлемент.Value = 77;
            ДругойЭлемент.Presentation = "copy"; ДругойЭлемент.Check = Ложь;
        Исключение Связи.FieldsStatus = "error"; КонецПопытки;
        Связи.Source = СнимокКопированияСписка(Список);
        Связи.Copy = СнимокКопированияСписка(Копия);
    КонецЕсли;
    Итог.Insert("SourceNext", ДобавлениеПослеКопииСписка(Список, "source-next"));
    Итог.Insert("CountsAfterSourceAdd", РазмерыКопииСписка(Список, Копия));
    Если ТипЗнч(Копия) = Тип("ValueList") Тогда
        Итог.Insert("CopyNext", ДобавлениеПослеКопииСписка(Копия, "copy-next"));
    Иначе Итог.Insert("CopyNext", "not-run"); КонецЕсли;
    Итог.Insert("CountsAfterCopyAdd", РазмерыКопииСписка(Список, Копия));
    Возврат Итог;
КонецФункции
// Конец компактных проб копирования списка.

// Начало компактных проб строкового представления списка.
// Это наблюдения, не предположения о запасном представлении или разделителях.
// Каждое преобразование защищено отдельно; владельцы живы до конца снимка.
Функция РезультатТекстаСписка(Знач Значение)
    Итог = Новый Структура("Status,Text", "ok");
    Попытка Итог.Text = Строка(Значение);
    Исключение Итог.Status = "error"; КонецПопытки;
    Возврат Итог;
КонецФункции

Функция СнимокТекстаСписка(Знач Список)
    Итог = Новый Структура("Count,Items,Text");
    Попытка Итог.Count = Список.Count(); Исключение Итог.Count = "[error]"; КонецПопытки;
    Строки = Новый Массив; Итог.Items = Строки;
    Попытка
        Для Каждого Элемент Из Список Цикл
            Если Строки.Count() >= 8 Тогда Строки.Add("[limit]"); Прервать; КонецЕсли;
            // Порядок: Value, Presentation, Check, ID, String(Value), String(Item).
            Поля = ПоляЭлементаСписка(Элемент);
            Попытка Поля.Add(Элемент.GetID()); Исключение Поля.Add("[id-error]"); КонецПопытки;
            Попытка Поля.Add(РезультатТекстаСписка(Элемент.Value));
            Исключение Поля.Add("[value-read-error]"); КонецПопытки;
            Поля.Add(РезультатТекстаСписка(Элемент));
            Строки.Add(Поля);
        КонецЦикла;
    Исключение Строки.Add("[iteration-error]"); КонецПопытки;
    Итог.Text = РезультатТекстаСписка(Список);
    Возврат Итог;
КонецФункции

Функция ОдинТекстСписка(Знач Значение, Знач Вид = "value")
    Список = Новый ValueList;
    Итог = Новый Структура("Prepare,State", "ok");
    Попытка
        Если Вид = "omitted" Тогда Список.Add();
        Иначе Список.Add(Значение); КонецЕсли;
    Исключение Итог.Prepare = "error"; КонецПопытки;
    Итог.State = СнимокТекстаСписка(Список);
    Возврат Итог;
КонецФункции

Функция ПустыеТекстыСписка()
    Итог = Новый Структура;
    Для Каждого Вид Из СтрРазделить("Fresh|Clear|LoadEmpty", "|") Цикл
        Список = Новый ValueList;
        Шаг = Новый Структура("Prepare,State", "ok"); Итог.Insert(Вид, Шаг);
        Попытка
            Если Вид = "Clear" Тогда Список.Add(7, "before"); Список.Clear();
            ИначеЕсли Вид = "LoadEmpty" Тогда
                Список.Add(7, "before"); Значения = Новый Массив; Список.LoadValues(Значения);
            КонецЕсли;
        Исключение Шаг.Prepare = "error"; КонецПопытки;
        Шаг.State = СнимокТекстаСписка(Список);
    КонецЦикла;
    Возврат Итог;
КонецФункции

Функция СкалярныеТекстыСписка(Знач Вид)
    Итог = Новый Структура;
    Если Вид = "absent" Тогда
        Итог.Insert("Omitted", ОдинТекстСписка(Неопределено, "omitted"));
        Итог.Insert("Undefined", ОдинТекстСписка(Неопределено));
        Итог.Insert("Null", ОдинТекстСписка(Null));
    ИначеЕсли Вид = "numbers-booleans" Тогда
        Итог.Insert("Zero", ОдинТекстСписка(0));
        Итог.Insert("Negative", ОдинТекстСписка(-7.25));
        Итог.Insert("Grouped", ОдинТекстСписка(1234.5));
        Итог.Insert("False", ОдинТекстСписка(Ложь));
        Итог.Insert("True", ОдинТекстСписка(Истина));
    ИначеЕсли Вид = "strings" Тогда
        Итог.Insert("Empty", ОдинТекстСписка(""));
        Итог.Insert("Space", ОдинТекстСписка(" "));
        Итог.Insert("Unicode", ОдинТекстСписка("Я😀"));
        Итог.Insert("Semicolon", ОдинТекстСписка("a; b"));
        Итог.Insert("Newline", ОдинТекстСписка("a" + Символ(10) + "b"));
        Итог.Insert("Escaped", ОдинТекстСписка("a\nb"));
    ИначеЕсли Вид = "dates" Тогда
        Итог.Insert("Empty", ОдинТекстСписка(Дата(1, 1, 1)));
        Итог.Insert("Fixed", ОдинТекстСписка(Дата(2024, 2, 29, 13, 14, 15)));
    КонецЕсли;
    Возврат Итог;
КонецФункции

Функция СоставныеТекстыСписка()
    Итог = Новый Структура;
    Для Каждого Вид Из СтрРазделить("Leading|Interior|Trailing|AllEmpty|Absent|Whitespace|Explicit", "|") Цикл
        Список = Новый ValueList;
        Шаг = Новый Структура("Prepare,State", "ok"); Итог.Insert(Вид, Шаг);
        Попытка
            Если Вид = "Leading" Тогда Список.Add(""); Список.Add("A");
            ИначеЕсли Вид = "Interior" Тогда Список.Add("A"); Список.Add(""); Список.Add("B");
            ИначеЕсли Вид = "Trailing" Тогда Список.Add("A"); Список.Add("");
            ИначеЕсли Вид = "AllEmpty" Тогда Список.Add(""); Список.Add(""); Список.Add("");
            ИначеЕсли Вид = "Absent" Тогда Список.Add(Неопределено); Список.Add(Null); Список.Add("");
            ИначеЕсли Вид = "Whitespace" Тогда Список.Add(" "); Список.Add(""); Список.Add("A");
            Иначе Список.Add("", "left"); Список.Add(""); Список.Add("", "right"); КонецЕсли;
        Исключение Шаг.Prepare = "error"; КонецПопытки;
        Шаг.State = СнимокТекстаСписка(Список);
    КонецЦикла;
    Возврат Итог;
КонецФункции

Функция ЗагруженныеТекстыСписка()
    Список = Новый ValueList;
    Значения = Новый Массив;
    Значения.Add(Неопределено); Значения.Add(Null); Значения.Add(0);
    Значения.Add(-7.25); Значения.Add(Истина); Значения.Add("");
    Значения.Add("Я😀"); Значения.Add(Дата(2024, 2, 29, 13, 14, 15));
    Итог = Новый Структура("Prepare,State", "ok");
    Попытка Список.LoadValues(Значения);
    Исключение Итог.Prepare = "error"; КонецПопытки;
    Итог.State = СнимокТекстаСписка(Список);
    Возврат Итог;
КонецФункции

Функция ЖивыеТекстыСписка()
    Список = Новый ValueList;
    Итог = Новый Структура("Prepare,Initial", "ok");
    Попытка Элемент = Список.Add(7, "");
    Исключение Итог.Prepare = "error"; КонецПопытки;
    Итог.Initial = СнимокТекстаСписка(Список);
    Если Итог.Prepare <> "ok" Тогда Возврат Итог; КонецЕсли;
    Для Каждого Вид Из СтрРазделить("Value|Label|LabeledValue|Checked|Unchecked|Whitespace|Cleared|Undefined", "|") Цикл
        Шаг = Новый Структура("Status,SameItem,State", "ok"); Итог.Insert(Вид, Шаг);
        Попытка
            Если Вид = "Value" Тогда Элемент.Value = -7.25;
            ИначеЕсли Вид = "Label" Тогда Элемент.Presentation = "fixed; Я😀";
            ИначеЕсли Вид = "LabeledValue" Тогда Элемент.Value = 1234.5;
            ИначеЕсли Вид = "Checked" Тогда Элемент.Check = Истина;
            ИначеЕсли Вид = "Unchecked" Тогда Элемент.Check = Ложь;
            ИначеЕсли Вид = "Whitespace" Тогда Элемент.Presentation = " ";
            ИначеЕсли Вид = "Cleared" Тогда Элемент.Presentation = "";
            Иначе Элемент.Value = Неопределено; КонецЕсли;
        Исключение Шаг.Status = "error"; КонецПопытки;
        Попытка Шаг.SameItem = Список.Get(0) = Элемент;
        Исключение Шаг.SameItem = "[error]"; КонецПопытки;
        Шаг.State = СнимокТекстаСписка(Список);
    КонецЦикла;
    Возврат Итог;
КонецФункции
// Конец компактных проб строкового представления списка.

// Начало уточняющих проб кэша строки списка.
// Эти снимки читают только поля/ID: ни Строка(Список), ни Строка(Элемент).
Функция ПоляКэшаСписка(Знач Список)
    Итог = Новый Структура("Count,Items"); Строки = Новый Массив; Итог.Items = Строки;
    Попытка Итог.Count = Список.Count(); Исключение Итог.Count = "[error]"; КонецПопытки;
    Попытка
        Для Каждого Элемент Из Список Цикл
            Если Строки.Count() >= 8 Тогда Строки.Add("[limit]"); Прервать; КонецЕсли;
            Поля = ПоляЭлементаСписка(Элемент);
            Попытка Поля.Add(Элемент.GetID()); Исключение Поля.Add("[id-error]"); КонецПопытки;
            Строки.Add(Поля);
        КонецЦикла;
    Исключение Строки.Add("[iteration-error]"); КонецПопытки;
    Возврат Итог;
КонецФункции

Функция ПолеИнициализацииКэша(Знач Элемент, Знач Вид, Знач Значение)
    Попытка
        Если Вид = "value" Тогда Элемент.Value = Значение;
        Иначе Элемент.Presentation = Значение; КонецЕсли;
        Возврат "ok";
    Исключение Возврат "error"; КонецПопытки;
КонецФункции

Функция ИнициализацияКэшаСписка(Знач Вид, Знач Чтение)
    Список = Новый ValueList;
    Итог = Новый Структура("Prepare", "ok");
    Попытка
        Элемент = Список.Add(7, ?(Вид = "value", "", "start"));
    Исключение Итог.Prepare = "error"; Возврат Итог; КонецПопытки;
    Итог.Insert("MiddleStatus", ПолеИнициализацииКэша(Элемент, Вид, ?(Вид = "value", 8, "middle")));
    Итог.Insert("Middle", ПоляКэшаСписка(Список));
    Если Чтение = "item" Тогда Итог.Insert("Trigger", РезультатТекстаСписка(Элемент));
    ИначеЕсли Чтение = "scalar" Тогда
        Попытка Итог.Insert("Trigger", РезультатТекстаСписка(Элемент.Value));
        Исключение Итог.Insert("Trigger", Новый Структура("Status,Text", "[value-read-error]", "")); КонецПопытки;
    Иначе Итог.Insert("Trigger", "not-run"); КонецЕсли;
    Итог.Insert("BeforeStatus", ПолеИнициализацииКэша(Элемент, Вид, ?(Вид = "value", 9, "latest")));
    Итог.Insert("Before", ПоляКэшаСписка(Список));
    Итог.Insert("First", РезультатТекстаСписка(Список));
    Итог.Insert("AfterStatus", ПолеИнициализацииКэша(Элемент, Вид, ?(Вид = "value", 10, "after")));
    Итог.Insert("After", ПоляКэшаСписка(Список));
    Итог.Insert("ItemAfter", РезультатТекстаСписка(Элемент));
    Итог.Insert("Second", РезультатТекстаСписка(Список));
    Возврат Итог;
КонецФункции

Функция НачалоКэшаСписка()
    Итог = Новый Структура;
    Итог.Insert("ValueUnread", ИнициализацияКэшаСписка("value", "none"));
    Итог.Insert("ValueScalar", ИнициализацияКэшаСписка("value", "scalar"));
    Итог.Insert("ValueItem", ИнициализацияКэшаСписка("value", "item"));
    Итог.Insert("PresentationUnread", ИнициализацияКэшаСписка("presentation", "none"));
    Итог.Insert("PresentationItem", ИнициализацияКэшаСписка("presentation", "item"));
    Возврат Итог;
КонецФункции

Функция ПоменятьПервыйКэшСписка(Знач Список, Знач Значение, Знач Представление)
    Попытка
        Если Список.Count() = 0 Тогда Возврат "empty"; КонецЕсли;
        Элемент = Список.Get(0); Элемент.Value = Значение; Элемент.Presentation = Представление;
        Возврат "ok";
    Исключение Возврат "error"; КонецПопытки;
КонецФункции

Функция ДействиеКэшаСписка(Знач Вид)
    Список = Новый ValueList;
    Итог = Новый Структура("Prepare", "ok");
    Упорядочен = Вид = "SortValueNoop" Или Вид = "SortPresentationNoop";
    Попытка
        Если Упорядочен Тогда
            Список.Add(10, "a"); Список.Add(20, "b"); Список.Add(30, "c");
        Иначе Список.Add(30, "b"); Список.Add(10, "c"); Список.Add(20, "a"); КонецЕсли;
    Исключение Итог.Prepare = "error"; Возврат Итог; КонецПопытки;
    Итог.Insert("Initial", ПоляКэшаСписка(Список));
    Итог.Insert("Warm", РезультатТекстаСписка(Список));
    Итог.Insert("PendingStatus", ПоменятьПервыйКэшСписка(Список, ?(Упорядочен, 11, 40), ?(Упорядочен, "aa", "pending")));
    Итог.Insert("Before", ПоляКэшаСписка(Список));
    Итог.Insert("Status", "ok");
    Попытка
        Если Вид = "Add" Тогда Список.Add(50, "new");
        ИначеЕсли Вид = "Insert" Тогда Список.Insert(0, 50, "new");
        ИначеЕсли Вид = "Delete" Тогда Список.Delete(1);
        ИначеЕсли Вид = "Clear" Тогда Список.Clear();
        ИначеЕсли Вид = "LoadValues" Или Вид = "LoadEmpty" Тогда
            Значения = Новый Массив;
            Если Вид = "LoadValues" Тогда Значения.Add(70); Значения.Add(80); КонецЕсли;
            Список.LoadValues(Значения);
        ИначеЕсли Вид = "Move" Тогда Список.Move(0, 1);
        ИначеЕсли Вид = "MoveNoop" Тогда Список.Move(0, 0);
        ИначеЕсли Вид = "SortValue" Или Вид = "SortValueNoop" Тогда Список.SortByValue();
        ИначеЕсли Вид = "SortPresentation" Или Вид = "SortPresentationNoop" Тогда Список.SortByPresentation();
        ИначеЕсли Вид = "FillChecks" Тогда Список.FillChecks(Истина);
        ИначеЕсли Вид = "DeleteError" Тогда Список.Delete(-1); КонецЕсли;
    Исключение Итог.Status = "error"; КонецПопытки;
    Итог.Insert("AfterAction", ПоляКэшаСписка(Список));
    // Между действием и первой строкой меняются поля, но не состав списка.
    Итог.Insert("BetweenStatus", ПоменятьПервыйКэшСписка(Список, 99, "between"));
    Итог.Insert("Between", ПоляКэшаСписка(Список));
    Итог.Insert("First", РезультатТекстаСписка(Список));
    Итог.Insert("AfterStatus", ПоменятьПервыйКэшСписка(Список, 100, "after"));
    Итог.Insert("After", ПоляКэшаСписка(Список));
    Итог.Insert("Second", РезультатТекстаСписка(Список));
    Возврат Итог;
КонецФункции

Функция ИзмененияКэшаСписка(Знач Группа)
    Итог = Новый Структура;
    Если Группа = "structural" Тогда Виды = "Add|Insert|Delete|Clear|LoadValues|LoadEmpty|Move|SortValue|SortPresentation";
    Иначе Виды = "FillChecks|MoveNoop|SortValueNoop|SortPresentationNoop|DeleteError"; КонецЕсли;
    Для Каждого Вид Из СтрРазделить(Виды, "|") Цикл
        Итог.Insert(Вид, ДействиеКэшаСписка(Вид));
    КонецЦикла;
    Возврат Итог;
КонецФункции

Функция ПустойКэшСписка()
    Список = Новый ValueList; Элемент = Неопределено;
    Итог = Новый Структура("Before,Warm,Status", ПоляКэшаСписка(Список), РезультатТекстаСписка(Список), "ok");
    Попытка Элемент = Список.Add(7, "first");
