ПроверитьЗаполненность("filled.fixed-structure.item", Новый ФиксированнаяСтруктура(КонтрольСтруктура));
ПроверитьЗаполненность("filled.fixed-map.item", Новый ФиксированноеСоответствие(КонтрольСоответствие));
Попытка
    КонтрольМассив = Новый Массив;
    КонтрольМассив.Добавить();
    КонтрольМассив.Insert(0);
    ПоказатьСоставМассива("array.optional", КонтрольМассив);
    СнимокКонтроля = Новый ФиксированныйМассив(КонтрольМассив);
    КонтрольМассив.Вставить(4, "Я");
    КонтрольМассив.Insert(6);
    ПоказатьСоставМассива("array.gap", КонтрольМассив);
    ПоказатьСоставМассива("array.gap.snapshot", СнимокКонтроля);
Исключение
    Показать("array.optional-gap", "error");
КонецПопытки;
Показать("collections.checkpoint.complete", "ok");

// Многомерный конструктор: форма, независимость и нулевые измерения.
Попытка
    МатрицаКонтроль = Новый Массив(2, 3);
    МатрицаКонтроль[0][1] = "Я";
    Показать("array.shape.outer", МатрицаКонтроль.Количество());
    Показать("array.shape.inner", МатрицаКонтроль[1].Количество());
    ПоказатьБулево("array.shape.independent", МатрицаКонтроль[1][1] = Неопределено);
    Показать("array.shape.value", МатрицаКонтроль[0][1]);
    КопияМатрицы = ЗначениеИзСтрокиВнутр(ЗначениеВСтрокуВнутр(МатрицаКонтроль));
    ПоказатьБулево("array.shape.roundtrip", КопияМатрицы[0][1] = "Я"
        И КопияМатрицы[1][1] = Неопределено);
Исключение
