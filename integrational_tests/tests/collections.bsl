// Массив записей, общие ссылки и контракт Структуры. Эталон получает только 1С.
Перем Выход;

Процедура Показать(Знач Метка, Знач Значение)
    Сообщить(Метка + ": [" + Строка(Значение) + "]");
КонецПроцедуры

Процедура ПоказатьБулево(Знач Метка, Знач Значение)
    Показать(Метка, ?(Значение, "true", "false"));
КонецПроцедуры

Процедура ПолучитьПозиции(Знач Заказ, Результат)
    Заказ.Свойство("Позиции", Результат);
КонецПроцедуры

Процедура ДобавитьПозицию(Знач Позиции)
    Позиции.Добавить(Новый Структура("Код,Цена,Количество", "в", 4, 1));
    Позиции = Новый Массив; // Переприсваивание Знач не заменяет массив вызывающего.
КонецПроцедуры

// Типичный конвейер: массив записей, расчет суммы и сбор кодов для выгрузки.
Позиции = Новый Массив;
Позиции.Добавить(Новый Структура("Код,Цена,Количество", "а", 10, 2));
Позиции.Добавить(Новый Структура("Код,Цена,Количество", "б", 3, 5));
Заказ = Новый Структура("Позиции,Комментарий", Позиции);
Итого = 0;
Коды = Новый Массив;
Для Каждого Позиция Из Заказ.Позиции Цикл
    Итого = Итого + Позиция.Цена * Позиция.Количество;
    Коды.Добавить(Позиция.Код);
КонецЦикла;
Показать("pipeline.total", Итого);
Показать("pipeline.codes", СтрСоединить(Коды, ";"));
ПоказатьБулево("property.found", Заказ.Свойство("ПОЗИЦИИ", Выход));
Выход[0].Количество = 3;
Показать("property.array-alias", Позиции[0].Количество);
Выход = Неопределено;
ПолучитьПозиции(Заказ, Выход);
ДобавитьПозицию(Выход);
Показать("property.forwarded-alias", Заказ.Позиции.Количество());
Показать("array.val-rebind", Выход.Количество());

// Жизненный цикл буфера: заполнение, вставка, поиск, удаление и повторное использование.
Буфер = Новый Массив(1);
ПоказатьБулево("array.initial-undefined", Буфер[0] = Неопределено);
Буфер.Установить(0, "а");
Буфер.Вставить(1, "б");
Показать("array.get", Буфер.Получить(1));
Показать("array.find", Буфер.Найти("б"));
ПоказатьБулево("array.missing", Буфер.Найти("в") = Неопределено);
Буфер.Удалить(0);
Показать("array.shift", Буфер[0]);
Буфер.Очистить();
Показать("array.empty-bound", Буфер.ВГраница());
Попытка
    Показать("array.out-of-bounds", Буфер[0]);
Исключение
    Показать("array.out-of-bounds", "error");
КонецПопытки;
Буфер.Добавить("снова");
Показать("array.reuse", Буфер[0]);

// Есть со значением Неопределено и нет свойства — разные результаты поиска.
Выход = "sentinel";
ПоказатьБулево("property.present-undefined", Заказ.Свойство("Комментарий", Выход));
ПоказатьБулево("property.undefined-value", Выход = Неопределено);
Выход = "sentinel";
ПоказатьБулево("property.missing", Заказ.Свойство("НетСвойства", Выход));
ПоказатьБулево("property.missing-output", Выход = Неопределено);
ПоказатьБулево("property.without-output", Заказ.Property("Позиции"));

Данные = Новый Структура("Имя,Количество", "ёж", 7);
Ссылка = Данные;
Ссылка["ИМЯ"] = "бор";
Показать("keys.index-alias", Данные.Имя);
Данные.Вставить("имя", "лес");
Показать("keys.case-insensitive", Ссылка.Имя);
ПоказатьБулево("property.scalar-found", Данные.Свойство("ИМЯ", Выход));
Показать("property.scalar-value", Выход);
Попытка
    Показать("collision.property", Данные.Количество);
Исключение
    Показать("collision.property", "error");
КонецПопытки;
Попытка
    Показать("collision.method", Данные.Количество());
Исключение
    Показать("collision.method", "error");
КонецПопытки;
Данные.Вставить("Count", 8);
Попытка
    Показать("collision.english-property", Данные.Count);
Исключение
    Показать("collision.english-property", "error");
КонецПопытки;
Попытка
    Показать("collision.english-method", Данные.Count());
Исключение
    Показать("collision.english-method", "error");
КонецПопытки;

// Обход без изменения состава и без предположения о порядке нескольких ключей.
Числа = Новый Структура("Первое,Второе", 2, 3);
Сумма = 0;
ЧислоКлючей = 0;
Для Каждого Пара Из Числа Цикл
    Сумма = Сумма + Пара.Значение;
    Если Пара.Ключ = "Первое" Или Пара.Ключ = "Второе" Тогда
        ЧислоКлючей = ЧислоКлючей + 1;
    КонецЕсли;
КонецЦикла;
Показать("iteration.sum", Сумма);
Показать("iteration.keys", ЧислоКлючей);
ОдинКлюч = Новый Структура("MiXeD", 1);
ОдинКлюч.Insert("mixed", 2);
Для Каждого Пара Из ОдинКлюч Цикл
    Показать("keys.retained-spelling", Пара.Key);
    Показать("keys.replaced-value", Пара.Value);
КонецЦикла;

// Неоднозначные границы изолированы: ошибка не завершает оставшиеся проверки.
Попытка
    Границы = Новый Структура(" , Первое, , Второе, ", 1, 2);
    Показать("constructor.empty-fields-count", Границы.Количество());
    Показать("constructor.empty-fields-values", Границы.Первое + Границы.Второе);
Исключение
    Показать("constructor.empty-fields", "error");
КонецПопытки;
Попытка
    Границы = Новый Структура("Имя,имя", "первое", "второе");
    Показать("constructor.duplicate-count", Границы.Количество());
    Показать("constructor.duplicate-value", Границы.Имя);
Исключение
    Показать("constructor.duplicate", "error");
КонецПопытки;
Попытка
    Границы = Новый Структура("Первое", 1, 2);
    Показать("constructor.surplus-count", Границы.Количество());
    Показать("constructor.surplus-value", Границы.Первое);
Исключение
    Показать("constructor.surplus", "error");
КонецПопытки;
Попытка
    Показать("property.missing-read", Данные.НетСвойства);
Исключение
    Показать("property.missing-read", "error");
КонецПопытки;
Попытка
    Данные.НетСвойства = 9;
    Показать("property.missing-write", "accepted");
Исключение
    Показать("property.missing-write", "error");
КонецПопытки;
ПоказатьБулево("property.missing-not-created", Данные.Свойство("НетСвойства"));
Выход = "sentinel";
Попытка
    ПоказатьБулево("property.invalid-name", Данные.Свойство(" Имя ", Выход));
Исключение
    Показать("property.invalid-name", "error");
КонецПопытки;
ПоказатьБулево("property.invalid-output-unchanged", Выход = "sentinel");
Попытка
    Показать("keys.numeric-index", Данные[0]);
Исключение
    Показать("keys.numeric-index", "error");
КонецПопытки;

Данные.Вставить("Пустое");
ПоказатьБулево("insert.default", Данные.Пустое = Неопределено);
Данные.Удалить("ПУСТОЕ");
ПоказатьБулево("delete.present", Данные.Свойство("Пустое"));
ДоУдаления = Данные.Количество();
Данные.Удалить("НетСвойства");
ПоказатьБулево("delete.absent", Данные.Количество() = ДоУдаления);
Данные.Очистить();
Показать("clear.alias-count", Ссылка.Количество());
Данные.Вставить("Снова", 1);
Показать("clear.reuse", Ссылка.Снова);
Показать("collections.complete", "ok");
