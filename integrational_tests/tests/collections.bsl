Функция ПробаСсылкиСписка(Знач Случай)
    Список = Новый СписокЗначений;
    Элемент = Список.Add(10, "old", Ложь);
    Второй = Список.Add(20, "second", Ложь);
    Журнал = Новый Массив;
    Статус = "ok";
    Результат = Неопределено;
    Попытка
        Если Случай = "value-ru" Тогда
            ЗаписатьСсылкуСписка(Элемент.Значение, 11, Журнал);
        ИначеЕсли Случай = "value-en" Тогда
            ЗаписатьСсылкуСписка(Элемент.Value, 12, Журнал);
        ИначеЕсли Случай = "presentation-ru" Тогда
            ЗаписатьСсылкуСписка(Элемент.Представление, "new-ru", Журнал);
        ИначеЕсли Случай = "presentation-en" Тогда
            ЗаписатьСсылкуСписка(Элемент.Presentation, "new-en", Журнал);
        ИначеЕсли Случай = "check-ru" Тогда
            ЗаписатьСсылкуСписка(Элемент.Пометка, Истина, Журнал);
        ИначеЕсли Случай = "check-en" Тогда
            ЗаписатьСсылкуСписка(Элемент.Check, Истина, Журнал);
        ИначеЕсли Случай = "value-val" Тогда
            ЗаписатьЗначениеСписка(Элемент.Value, 13, Журнал);
        ИначеЕсли Случай = "presentation-val" Тогда
            ЗаписатьЗначениеСписка(Элемент.Presentation, "val", Журнал);
        ИначеЕсли Случай = "check-val" Тогда
            ЗаписатьЗначениеСписка(Элемент.Check, Истина, Журнал);
        ИначеЕсли Случай = "live" Тогда
            Результат = ЖиваяСсылкаСписка(Элемент.Value, Элемент, Журнал);
        ИначеЕсли Случай = "same-nested" Тогда
            ДвеСсылкиСписка(Элемент.Значение, Элемент.Value, Журнал);
        ИначеЕсли Случай = "write-throw" Тогда
            ОшибкаПослеСсылкиСписка(Элемент.Value, Журнал);
        ИначеЕсли Случай = "coercions" Тогда
            Попытка
                ЗаписатьСсылкуСписка(Элемент.Presentation, 123, Журнал);
                Журнал.Добавить("conversion-ok");
            Исключение
                Журнал.Добавить("conversion-error");
            КонецПопытки;
            Попытка
                ЗаписатьСсылкуСписка(Элемент.Presentation, Неопределено, Журнал);
                Журнал.Добавить("conversion-ok");
            Исключение
                Журнал.Добавить("conversion-error");
            КонецПопытки;
            Попытка
                ЗаписатьСсылкуСписка(Элемент.Check, 1, Журнал);
                Журнал.Добавить("conversion-ok");
            Исключение
                Журнал.Добавить("conversion-error");
            КонецПопытки;
            Попытка
                ЗаписатьСсылкуСписка(Элемент.Check, 0, Журнал);
                Журнал.Добавить("conversion-ok");
            Исключение
                Журнал.Добавить("conversion-error");
            КонецПопытки;
        ИначеЕсли Случай = "invalid-write" Тогда
            ЗаписатьСсылкуСписка(Элемент.Value, 42, Журнал);
            ЗаписатьСсылкуСписка(Элемент.Check, Новый Массив, Журнал);
        ИначеЕсли Случай = "receiver-once" Тогда
            ЗаписатьСсылкуСписка(ПолучательСсылкиСписка(Список, Журнал)[ИндексСсылкиСписка(Журнал)].Value, 52, Журнал);
            ЗаписатьСсылкуСписка(ПолучательСсылкиСписка(Список, Журнал).Get(ИндексСсылкиСписка(Журнал)).Presentation, "once", Журнал);
        ИначеЕсли Случай = "reorder-delete" Тогда
            ПерестроитьСсылкуСписка(Элемент.Value, Список, Элемент, Журнал);
        ИначеЕсли Случай = "cache" Тогда
            Журнал.Добавить(Строка(Список));
            ЗаписатьСсылкуСписка(Элемент.Presentation, "fresh", Журнал);
            Журнал.Добавить(Строка(Список));
            Журнал.Добавить(Строка(Элемент));
            Копия = Список.Copy();
            Журнал.Добавить(Строка(Копия));
        ИначеЕсли Случай = "missing-property" Тогда
            ЗаписатьСсылкуСписка(Элемент.NoSuchField, ПозднийАргументСписка(Журнал), Журнал);
        ИначеЕсли Случай = "invalid-receiver" Тогда
            ЗаписатьСсылкуСписка(Список.Get(99).Value, ПозднийАргументСписка(Журнал), Журнал);
        ИначеЕсли Случай = "function-result" Тогда
            Результат = ВозвратСсылкиСписка(Элемент.Value, Журнал);
        КонецЕсли;
    Исключение
        Статус = "error";
    КонецПопытки;
    Снимок = Новый Структура("Status,Log,Result,Count,Second,Identity", Статус, Журнал, Результат, Список.Count(), Второй.Value, Список.FindByID(0) = Элемент);
    Попытка
        Снимок.Insert("Value", Элемент.Value);
    Исключение
        Снимок.Insert("Value", "snapshot-error");
    КонецПопытки;
    Попытка
        Снимок.Insert("Presentation", Элемент.Presentation);
    Исключение
        Снимок.Insert("Presentation", "snapshot-error");
    КонецПопытки;
    Попытка
        Снимок.Insert("Check", Элемент.Check);
    Исключение
        Снимок.Insert("Check", "snapshot-error");
    КонецПопытки;
    Попытка
        Снимок.Insert("ID", Элемент.GetID());
    Исключение
        Снимок.Insert("ID", "snapshot-error");
    КонецПопытки;
    Возврат Снимок;
КонецФункции
// End ValueList field reference helpers.

// Begin descriptor Map-key checkpoint helpers.
// Native observations only: equality does not establish the Map key rule.
Функция ПараКлючейОписаний(Знач Вид)
    Первый = Новый TypeDescription("Number");
    Второй = Новый TypeDescription("Number");
    Если Вид = "same-object" Тогда
        Второй = Первый;
    ИначеЕсли Вид = "equal-empty" Тогда
        Первый = Новый TypeDescription;
        Второй = Новый TypeDescription;
    ИначеЕсли Вид = "equal-reordered" Тогда
        Первый = Новый TypeDescription("Number,String");
        Второй = Новый TypeDescription("String,Number");
    ИначеЕсли Вид = "equal-copy" Тогда
        Второй = Новый TypeDescription(Первый);
    ИначеЕсли Вид = "unequal-types" Тогда
        Второй = Новый TypeDescription("String");
    ИначеЕсли Вид = "unequal-number-qualifiers" Тогда
        Первый = Новый TypeDescription("Number", Новый NumberQualifiers(5, 2));
        Второй = Новый TypeDescription("Number", Новый NumberQualifiers(5, 1));
    ИначеЕсли Вид = "unequal-string-qualifiers" Тогда
        Первый = Новый TypeDescription("String", , Новый StringQualifiers(4, AllowedLength.Fixed));
        Второй = Новый TypeDescription("String", , Новый StringQualifiers(4, AllowedLength.Variable));
    ИначеЕсли Вид <> "equal-number" Тогда
        ВызватьИсключение "unknown descriptor pair";
    КонецЕсли;
    Возврат Новый Структура("First,Second", Первый, Второй);
КонецФункции

Функция РавенствоКлючейОписаний(Знач Вид)
    Попытка
        Пара = ПараКлючейОписаний(Вид);
    Исключение
        Возврат "setup-error";
    КонецПопытки;
    Попытка
        Возврат Пара.First = Пара.Second;
    Исключение
        Возврат "equality-error";
    КонецПопытки;
КонецФункции

Функция ИсторияКлючейОписаний(Знач Вид, Знач Режим)
    // Every operation is independently caught, named and projected to scalars.
    // A failed insertion never hides the later count or lookup observations.
    Попытка
        Пара = ПараКлючейОписаний(Вид);
        Первый = Пара.First;
        Второй = Пара.Second;
        Данные = Новый Map;
    Исключение
        Возврат "setup-error";
    КонецПопытки;
    Снимок = Неопределено;
    Копия = Неопределено;
    Восстановлено = Неопределено;
    Поток = Неопределено;
    Журнал = Новый Массив;
    Шаги = Новый Массив;
    Шаги.Add("insert-first|Данные.Insert(Первый, 101);");
    Шаги.Add("count-first|Ответ = Данные.Count();");
    Шаги.Add("get-first|Ответ = Данные.Get(Первый);");
    Шаги.Add("index-first|Ответ = Данные[Первый];");
    Шаги.Add("get-second-before|Ответ = Данные.Get(Второй);");
    Шаги.Add("index-second-before|Ответ = Данные[Второй];");
    Если Режим = "mutable" Тогда
        Шаги.Add("insert-second|Данные.Insert(Второй, 202);");
        Шаги.Add("count-second|Ответ = Данные.Count();");
        Шаги.Add("get-first-after|Ответ = Данные.Get(Первый);");
        Шаги.Add("get-second-after|Ответ = Данные.Get(Второй);");
        Шаги.Add("index-replace|Данные[Второй] = 303;");
        Шаги.Add("count-replaced|Ответ = Данные.Count();");
        Шаги.Add("get-first-replaced|Ответ = Данные.Get(Первый);");
        Шаги.Add("get-second-replaced|Ответ = Данные.Get(Второй);");
        Шаги.Add("delete-second|Данные.Delete(Второй);");
        Шаги.Add("count-deleted|Ответ = Данные.Count();");
        Шаги.Add("get-first-deleted|Ответ = Данные.Get(Первый);");
        Шаги.Add("get-second-deleted|Ответ = Данные.Get(Второй);");
        Шаги.Add("delete-first|Данные.Delete(Первый);");
        Шаги.Add("count-final|Ответ = Данные.Count();");
    ИначеЕсли Режим = "fixed-copy" Тогда
        Шаги.Add("snapshot|Снимок = Новый FixedMap(Данные);");
        Шаги.Add("fixed-count|Ответ = Снимок.Count();");
        Шаги.Add("fixed-get-first|Ответ = Снимок.Get(Первый);");
        Шаги.Add("fixed-get-second|Ответ = Снимок.Get(Второй);");
        Шаги.Add("fixed-index-second|Ответ = Снимок[Второй];");
        Шаги.Add("copy|Копия = Новый Map(Снимок);");
        Шаги.Add("copy-count|Ответ = Копия.Count();");
        Шаги.Add("copy-get-second|Ответ = Копия.Get(Второй);");
        Шаги.Add("source-replace|Данные.Insert(Первый, 404);");
        Шаги.Add("source-delete|Данные.Delete(Первый);");
        Шаги.Add("source-count|Ответ = Данные.Count();");
        Шаги.Add("fixed-isolated|Ответ = Снимок.Get(Первый);");
        Шаги.Add("copy-isolated|Ответ = Копия.Get(Первый);");
        Шаги.Add("copy-insert-second|Копия.Insert(Второй, 505);");
        Шаги.Add("copy-count-after|Ответ = Копия.Count();");
        Шаги.Add("copy-get-first-after|Ответ = Копия.Get(Первый);");
        Шаги.Add("copy-get-second-after|Ответ = Копия.Get(Второй);");
        Шаги.Add("fixed-count-after|Ответ = Снимок.Count();");
        Шаги.Add("fixed-first-after|Ответ = Снимок.Get(Первый);");
        Шаги.Add("fixed-second-after|Ответ = Снимок.Get(Второй);");
    Иначе
        // Single, unequal and duplicate-equal insertion, each mutable and fixed.
        Если СтрНайти(Режим, "single") = 0 Тогда
            Шаги.Add("insert-second|Данные.Insert(Второй, 202);");
        КонецЕсли;
        Шаги.Add("codec-source-count|Ответ = Данные.Count();");
        Если СтрНайти(Режим, "fixed") > 0 Тогда
            Шаги.Add("codec-fixed|Данные = Новый FixedMap(Данные);");
        КонецЕсли;
        Шаги.Add("codec-write|Поток = ValueToStringInternal(Данные); Ответ = Поток;");
        Шаги.Add("codec-read|Восстановлено = ValueFromStringInternal(Поток); Ответ = TypeOf(Восстановлено);");
        Шаги.Add("codec-count|Ответ = Восстановлено.Count();");
        Шаги.Add("codec-first|Ответ = Восстановлено.Get(Первый);");
        Шаги.Add("codec-second|Ответ = Восстановлено.Get(Второй);");
        Шаги.Add("codec-index-first|Ответ = Восстановлено[Первый];");
        Шаги.Add("codec-index-second|Ответ = Восстановлено[Второй];");
    КонецЕсли;
    Для Каждого Шаг Из Шаги Цикл
        Части = СтрРазделить(Шаг, "|");
        Ответ = "ok";
        Попытка
            Выполнить(Части[1]);
            Журнал.Add(Части[0] + ":ok:" + КомпактноеЗначениеТаблицы(Ответ));
        Исключение
            Журнал.Add(Части[0] + ":error");
        КонецПопытки;
    КонецЦикла;
    Возврат Журнал;
КонецФункции
// End descriptor Map-key checkpoint helpers.

// Begin bounded ValueTree FindRows helpers (measurement only; no native answers).
Функция TreeSearchFresh(Знач Kind)
    T = Новый ДеревоЗначений;
    T.Колонки.Добавить("Id");
    T.Колонки.Добавить("Key");
    T.Колонки.Добавить("Group");
    T.Колонки.Добавить("Mark");
    A = T.Строки.Добавить();
    B = T.Строки.Добавить();
    B1 = B.Строки.Добавить();
    A1 = A.Строки.Добавить();
    A2 = A.Строки.Добавить();
    A11 = A1.Строки.Добавить();
    A.Id = 1; B.Id = 2; B1.Id = 3; A1.Id = 4; A2.Id = 5; A11.Id = 6;
    A.Key = "hit"; B.Key = "hit"; B1.Key = "hit";
    A1.Key = "hit"; A2.Key = "hit"; A11.Key = "hit";
    A.Group = "x"; B.Group = "y"; B1.Group = "x";
    A1.Group = "x"; A2.Group = "y"; A11.Group = "y";
    A.Mark = "base"; B.Mark = "base"; B1.Mark = "base";
    A1.Mark = "base"; A2.Mark = "base"; A11.Mark = "base";
    Если Kind = "descendants" Тогда
        A.Key = "miss"; B.Key = "miss"; A1.Key = "miss";
    ИначеЕсли Kind = "scalars" Тогда
        A.Key = 1; B.Key = Истина; B1.Key = 2;
        A1.Key = "1"; A2.Key = Ложь; A11.Key = Неопределено;
    ИначеЕсли Kind = "strings" Тогда
        A.Key = "x"; B.Key = "X"; B1.Key = "x ";
        A1.Key = "X "; A2.Key = "xx"; A11.Key = "x";
    ИначеЕсли Kind = "nullish" Тогда
        A.Key = Неопределено; B.Key = Null; B1.Key = Неопределено;
        A1.Key = ""; A2.Key = 0; A11.Key = Null;
    КонецЕсли;
    Возврат Новый Структура("Tree,A,B,B1,A1,A2,A11", T, A, B, B1, A1, A2, A11);
КонецФункции

Функция TreeSearchMark(Знач Value)
    Если ТипЗнч(Value) <> Тип("Строка") Тогда
        ВызватьИсключение "tree-search-mark-type";
    КонецЕсли;
    Если Value <> "base" И Value <> "from-result" И Value <> "from-source" Тогда
        ВызватьИсключение "tree-search-mark-value";
    КонецЕсли;
    Возврат Value;
КонецФункции

Функция TreeSearchCell(Знач Value)
    Если ТипЗнч(Value) = Тип("Неопределено") Тогда
        Возврат "u";
    ИначеЕсли ТипЗнч(Value) = Тип("Null") Тогда
        Возврат "l";
    ИначеЕсли ТипЗнч(Value) = Тип("Булево") Тогда
        Если Value Тогда Возврат "b1"; Иначе Возврат "b0"; КонецЕсли;
    ИначеЕсли ТипЗнч(Value) = Тип("Число") Тогда
        Если Value < 0 Или Value > 7 Или Цел(Value) <> Value Тогда
            ВызватьИсключение "tree-search-cell-number";
        КонецЕсли;
        Возврат "n" + Строка(Value);
    ИначеЕсли ТипЗнч(Value) = Тип("Строка") Тогда
        Если СтрДлина(Value) > 16 Тогда
            ВызватьИсключение "tree-search-cell-length";
        КонецЕсли;
        Text = "s";
        Для I = 1 По СтрДлина(Value) Цикл
            Code = КодСимвола(Value, I);
            Если Code < 32 Или Code > 126 Тогда
                ВызватьИсключение "tree-search-cell-ascii";
            КонецЕсли;
            Text = Text + Строка(Code) + ".";
        КонецЦикла;
        Возврат Text;
    КонецЕсли;
    ВызватьИсключение "tree-search-cell-type";
КонецФункции

Функция TreeSearchState(Знач S)
    Counts = Новый Массив;
    Counts.Добавить(S.Tree.Rows.Count());
    Counts.Добавить(S.A.Rows.Count());
    Counts.Добавить(S.B.Rows.Count());
    Counts.Добавить(S.A1.Rows.Count());
    Counts.Добавить(S.A2.Rows.Count());
    Counts.Добавить(S.B1.Rows.Count());
    Counts.Добавить(S.A11.Rows.Count());
    Text = "";
    Для Каждого N Из Counts Цикл
        Если ТипЗнч(N) <> Тип("Число") Или N < 0 Или N > 7 Или Цел(N) <> N Тогда
            ВызватьИсключение "tree-search-state-count";
        КонецЕсли;
        Text = Text + Строка(N) + ",";
    КонецЦикла;
    Nodes = Новый Массив;
    Nodes.Добавить(S.A); Nodes.Добавить(S.B); Nodes.Добавить(S.B1);
    Nodes.Добавить(S.A1); Nodes.Добавить(S.A2); Nodes.Добавить(S.A11);
    Для Каждого R Из Nodes Цикл
        Text = Text + ";" + TreeSearchCell(R.Id) + "/" + TreeSearchCell(R.Key)
            + "/" + TreeSearchCell(R.Group) + "/" + TreeSearchMark(R.Mark);
    КонецЦикла;
    Возврат Text;
КонецФункции

Функция TreeSearchResult(Знач Result)
    Если ТипЗнч(Result) = Тип("Массив") Тогда
        Tag = "array";
    ИначеЕсли ТипЗнч(Result) = Тип("ФиксированныйМассив") Тогда
        Tag = "fixed-array";
    ИначеЕсли ТипЗнч(Result) = Тип("Неопределено") Тогда
        Возврат "undefined";
    ИначеЕсли ТипЗнч(Result) = Тип("Null") Тогда
        Возврат "null";
    ИначеЕсли ТипЗнч(Result) = Тип("Число") Тогда
        Возврат "number";
    ИначеЕсли ТипЗнч(Result) = Тип("Булево") Тогда
        Возврат "boolean";
    ИначеЕсли ТипЗнч(Result) = Тип("Строка") Тогда
        Возврат "string";
    ИначеЕсли ТипЗнч(Result) = Тип("Структура") Тогда
        Возврат "structure";
    ИначеЕсли ТипЗнч(Result) = Тип("ФиксированнаяСтруктура") Тогда
        Возврат "fixed-structure";
    ИначеЕсли ТипЗнч(Result) = Тип("ДеревоЗначений") Тогда
        Возврат "tree";
    ИначеЕсли ТипЗнч(Result) = Тип("СтрокаДереваЗначений") Тогда
        Возврат "tree-row";
    ИначеЕсли ТипЗнч(Result) = Тип("КоллекцияСтрокДереваЗначений") Тогда
        Возврат "tree-rows";
    Иначе
        ВызватьИсключение "tree-search-result-type";
    КонецЕсли;
    Count = Result.Количество();
    Если Count < 0 Или Count > 7 Тогда
        ВызватьИсключение "tree-search-result-count";
    КонецЕсли;
    Text = Tag + ":" + Строка(Count) + ":";
    Для Каждого R Из Result Цикл
        Если ТипЗнч(R) <> Тип("СтрокаДереваЗначений") Тогда
            ВызватьИсключение "tree-search-result-row";
        КонецЕсли;
        Id = R.Id;
        Если ТипЗнч(Id) <> Тип("Число") Или Id < 1 Или Id > 7 Или Цел(Id) <> Id Тогда
            ВызватьИсключение "tree-search-result-id";
        КонецЕсли;
        Text = Text + Строка(Id) + ",";
    КонецЦикла;
    Возврат Text;
КонецФункции

Функция TreeSearchProbe(Знач Expression, Знач Kind = "base", Знач Change = "none")
    Попытка
        S = TreeSearchFresh(Kind);
        Filter = Новый Структура("Key", "hit");
    Исключение
        Возврат "setup-error";
    КонецПопытки;
    Status = "ok";
    Second = Неопределено;
    Попытка
        Result = Вычислить(Expression);
    Исключение
        Status = "action-error";
    КонецПопытки;
    ChangeStatus = "none";
    Если Status = "ok" И Change <> "none" Тогда
        ChangeStatus = "ok";
        Попытка
        Если Change = "number-boolean" Тогда
            Second = S.Tree.Rows.FindRows(Новый Структура("Key", Истина), Истина);
        ИначеЕсли Change = "result-to-source" Тогда
            Result[0].Mark = "from-result";
        ИначеЕсли Change = "source-to-result" Тогда
            S.A1.Mark = "from-source";
        ИначеЕсли Change = "array-delete" Тогда
            Result.Удалить(0);
        ИначеЕсли Change = "add-node" Тогда
            Added = S.A.Rows.Add();
            Added.Id = 7; Added.Key = "hit"; Added.Group = "x"; Added.Mark = "base";
            Second = S.Tree.Rows.FindRows(Filter, Истина);
        ИначеЕсли Change = "filter-change" Тогда
            Filter.Вставить("Key", "miss");
            Second = S.Tree.Rows.FindRows(Filter, Истина);
        КонецЕсли;
        Исключение
            ChangeStatus = "change-error";
        КонецПопытки;
    КонецЕсли;
    Попытка
        State = TreeSearchState(S);
        Если Status = "action-error" Тогда
            Возврат Status + "|state=" + State;
        КонецЕсли;
        Text = "ok|change=" + ChangeStatus + "|result=" + TreeSearchResult(Result);
        Если Change = "number-boolean" Или Change = "add-node" Или Change = "filter-change" Тогда
            Text = Text + "|second=" + TreeSearchResult(Second);
        ИначеЕсли (Change = "result-to-source" Или Change = "source-to-result") И ChangeStatus = "ok" Тогда
            Text = Text + "|result-mark=" + TreeSearchMark(Result[0].Mark);
        КонецЕсли;
        Возврат Text + "|state=" + State;
    Исключение
        Возврат Status + "|change=" + ChangeStatus + "|observer-error";
    КонецПопытки;
КонецФункции

// End bounded ValueTree FindRows helpers.

// Begin bounded ValueTree Find helpers (measurement only; no native answers).
Функция TreeFindResult(Знач Result, Знач S)
    Если ТипЗнч(Result) = Тип("СтрокаДереваЗначений") Тогда
        Id = Result.Id;
        Если ТипЗнч(Id) <> Тип("Число") Или Id < 1 Или Id > 6 Или Цел(Id) <> Id Тогда
            ВызватьИсключение "tree-find-result-id";
        КонецЕсли;
        Parent = Result.Parent;
        ParentId = "undefined";
        Если ТипЗнч(Parent) <> Тип("Неопределено") Тогда
            ParentId = TreeSearchCell(Parent.Id);
        КонецЕсли;
        SameTree = Result.Owner() = S.Tree;
        Возврат "row:" + Строка(Id) + ":parent=" + ParentId
            + ":level=" + TreeSearchCell(Result.Level())
            + ":owner=" + TreeSearchCell(SameTree)
            + ":mark=" + TreeSearchMark(Result.Mark);
    КонецЕсли;
    Возврат TreeSearchResult(Result);
КонецФункции

Функция TreeFindProbe(Знач Expression, Знач Kind = "base", Знач Change = "none")
    Попытка
        S = TreeSearchFresh(Kind);
        Если Kind = "cross-columns" Тогда
            S.A.Key = "miss"; S.A.Group = "hit";
            S.B.Key = "hit"; S.B.Group = "miss";
        ИначеЕсли Kind = "empty" Тогда
            S.Tree.Rows.Clear();
        ИначеЕсли Kind = "no-columns" Тогда
            S.Tree.Rows.Clear();
            S.Tree.Columns.Clear();
        КонецЕсли;
    Исключение
        Возврат "setup-error";
    КонецПопытки;
    Status = "ok";
    Попытка
        Result = Вычислить(Expression);
    Исключение
        Status = "action-error";
    КонецПопытки;
    ChangeStatus = "none";
    Если Status = "ok" И Change <> "none" Тогда
        ChangeStatus = "ok";
        Попытка
            Если Change = "result-to-source" Тогда
                Result.Mark = "from-result";
            ИначеЕсли Change = "source-to-result" Тогда
                S.A1.Mark = "from-source";
            КонецЕсли;
        Исключение
            ChangeStatus = "change-error";
