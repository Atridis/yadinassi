ПоказатьВнутреннее("internal.map.typed-keys", СмешанныеКлючи);
ПоказатьВнутреннее("internal.map.typed-keys-again", СмешанныеКлючи);
ОбратныеКлючи = Новый Соответствие;
ОбратныеКлючи.Вставить(Тип("Число"), "type");
ОбратныеКлючи.Вставить("0", "string");
ОбратныеКлючи.Вставить(0, "number");
ОбратныеКлючи.Вставить(Ложь, "boolean");
ОбратныеКлючи.Вставить(Неопределено, "undefined");
