    Попытка
        Если Сценарий = "row-add" Тогда
            Результат = Таблица.Добавить();
        ИначеЕсли Сценарий = "row-insert" Тогда
            Результат = Таблица.Insert(1);
        ИначеЕсли Сценарий = "row-insert-end" Тогда
            Результат = Таблица.Вставить(3);
        ИначеЕсли Сценарий = "row-insert-negative" Тогда
            Результат = Таблица.Insert(-1);
        ИначеЕсли Сценарий = "row-insert-past" Тогда
