Попытка
    ОбщийМассивЗаполнения = Новый Массив;
    ОбщийМассивЗаполнения.Добавить("Я");
    ИсточникЗаполнения = Новый Структура("Данные,Пустое", ОбщийМассивЗаполнения, Неопределено);
    ПриемникЗаполнения = Новый Структура("Данные,Пустое", Неопределено, 9);
    ЗаполнитьЗначенияСвойств(ПриемникЗаполнения, ИсточникЗаполнения);
    ПриемникЗаполнения.Данные.Добавить(7);
    КопияЗаполнения = ЗначениеИзСтрокиВнутр(ЗначениеВСтрокуВнутр(ПриемникЗаполнения));
    Показать("fill.reference-roundtrip", ЗначениеВСтрокуВнутр(ИсточникЗаполнения.Данные.Количество())
        + ";" + ЗначениеВСтрокуВнутр(ПриемникЗаполнения.Пустое)
        + ";" + ЗначениеВСтрокуВнутр(КопияЗаполнения.Данные[1]));
Исключение
    Показать("fill.reference-roundtrip", "error");
КонецПопытки;
Показать("fill.checkpoint.complete", "ok");

