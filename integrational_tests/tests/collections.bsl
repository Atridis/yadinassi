КонтрольСтруктура.Вставить("Ключ", Неопределено);
КонтрольСоответствие.Вставить("Ключ", Неопределено);
ПроверитьЗаполненность("filled.array.item", КонтрольМассив);
ПроверитьЗаполненность("filled.structure.item", КонтрольСтруктура);
ПроверитьЗаполненность("filled.map.item", КонтрольСоответствие);
