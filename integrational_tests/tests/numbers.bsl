// Цел/Мин/Макс: сначала собираем нативные результаты, не угадываем
// преобразования типов. Внутренняя запись сохраняет тип победившего значения.
Процедура ПроверитьЦел(Знач Метка, Знач Значение)
    Попытка
        Показать(Метка, ЗначениеВСтрокуВнутр(Цел(Значение)));
    Исключение
        Показать(Метка, "error");
    КонецПопытки;
КонецПроцедуры

Процедура ПроверитьЭкстремумы(Знач Метка, Знач Левое, Знач Правое)
    Попытка
        Показать(Метка + ".min", ЗначениеВСтрокуВнутр(Мин(Левое, Правое)));
    Исключение
        Показать(Метка + ".min", "error");
    КонецПопытки;
    Попытка
        Показать(Метка + ".max", ЗначениеВСтрокуВнутр(Макс(Левое, Правое)));
    Исключение
        Показать(Метка + ".max", "error");
    КонецПопытки;
КонецПроцедуры

Процедура ПроверитьОдинЭкстремум(Знач Метка, Знач Значение)
    Попытка
        Показать(Метка + ".min", ЗначениеВСтрокуВнутр(Min(Значение)));
    Исключение
        Показать(Метка + ".min", "error");
    КонецПопытки;
    Попытка
        Показать(Метка + ".max", ЗначениеВСтрокуВнутр(Max(Значение)));
    Исключение
        Показать(Метка + ".max", "error");
    КонецПопытки;
КонецПроцедуры

// Разрядность арифметики и представление чисел.
// Ожидаемый вывод нужно получить на реальной 1С; заранее он не задан.
Процедура Показать(Метка, Знач Значение)
    Сообщить(Метка + ": [" + Строка(Значение) + "]");
КонецПроцедуры

// Нативный формат пока исследуется; ошибки записи и чтения различаются.
Процедура ПоказатьВнутреннее(Знач Метка, Знач Значение)
    Попытка
        Запись = ЗначениеВСтрокуВнутр(Значение);
        Показать(Метка + ".payload", Запись);
    Исключение
        Показать(Метка + ".error", ОписаниеОшибки());
        Возврат;
    КонецПопытки;
    Попытка
        Восстановлено = ЗначениеИзСтрокиВнутр(Запись);
        ПоказатьБулево(Метка + ".roundtrip.type", ТипЗнч(Восстановлено) = ТипЗнч(Значение));
        ПоказатьБулево(Метка + ".roundtrip.value", Восстановлено = Значение);
    Исключение
        Показать(Метка + ".roundtrip.error", ОписаниеОшибки());
    КонецПопытки;
КонецПроцедуры

Процедура ПоказатьБулево(Метка, Знач Значение)
    Если Значение Тогда
        Показать(Метка, "true");
    Иначе
        Показать(Метка, "false");
    КонецЕсли;
КонецПроцедуры

// Пробы входной грамматики: принятие и отказ одинаково допустимы до запуска 1С.
Процедура ПоказатьЧтениеВнутреннего(Знач Метка, Знач Текст)
    Попытка
        Значение = ЗначениеИзСтрокиВнутр(Текст);
        Показать(Метка + ".type", ТипЗнч(Значение));
        Показать(Метка + ".value", Значение);
    Исключение
        Описание = ОписаниеОшибки();
        ОшибкаФормата = Найти(Описание, "Ошибка преобразования: Ошибка формата потока") > 0;
        Показать(Метка + ".error", "error");
        ПоказатьБулево(Метка + ".error.stream-format", ОшибкаФормата);
        Если Не ОшибкаФормата Тогда
            Показать(Метка + ".error.other", Описание);
        КонецЕсли;
    КонецПопытки;
КонецПроцедуры

// Каждая дополнительная граница остается отдельным наблюдением при ошибке.
Процедура ПоказатьЧастное(Метка, Знач Числитель, Знач Знаменатель)
    Попытка
        Показать(Метка, Числитель / Знаменатель);
    Исключение
        Показать(Метка, "error");
    КонецПопытки;
КонецПроцедуры

// Разные порядки результата различают фиксированную дробную разрядность
// и фиксированное количество значащих цифр. Прямой вывод предшествует сложению.
Треть = 1 / 3;
ДесятьТретей = 10 / 3;
СтоТретей = 100 / 3;
Показать("div.1_3", Треть);
Показать("div.10_3", ДесятьТретей);
Показать("div.100_3", СтоТретей);
Показать("div.2_3", 2 / 3);
Показать("div.1_7", 1 / 7);
Показать("div.negative_1_7", -1 / 7);
Показать("div.fractional_operand", 13.1 / 3);
// Ошибка крайнего порядка не должна прерывать остальные наблюдения.
Попытка
    Показать("div.tiny", 0.0000000000000000000000000001 / 3);
Исключение
    Показать("div.tiny", "error");
КонецПопытки;
Попытка
    Показать("div.large", 1000000000000000000000000000 / 3);
Исключение
    Показать("div.large", "error");
КонецПопытки;

// Числовые сравнения отделяют реальное значение от округления при выводе.
ПоказатьБулево("equal.third.scale27", Треть = 0.333333333333333333333333333);
ПоказатьБулево("equal.third.scale28", Треть = 0.3333333333333333333333333333);
ПоказатьБулево("equal.ten_thirds.scale27", ДесятьТретей = 3.333333333333333333333333333);
ПоказатьБулево("equal.hundred_thirds.scale27", СтоТретей = 33.333333333333333333333333333);
ПоказатьБулево("equal.hundred_thirds.significant28", СтоТретей = 33.33333333333333333333333333);
// Малый остаток возвращается к обычному порядку без длинного литерала.
Остаток = (Треть - 0.3333333333333333333333333333) * 10000000000000000000000000000;
Показать("residual.third.scaled28", Остаток);
ПоказатьБулево("equal.residual.precision38_candidate", Остаток = 0.3333333333);

ПервоеУдвоение = ДесятьТретей + ДесятьТретей;
ВтороеУдвоение = ПервоеУдвоение + ПервоеУдвоение;
Показать("add.first", ПервоеУдвоение);
Показать("add.second", ВтороеУдвоение);
ПоказатьБулево("equal.first.native_basic", ПервоеУдвоение = 6.666666666666666666666666666);
ПоказатьБулево("equal.second.native_basic", ВтороеУдвоение = 13.333333333333333333333333332);
Показать("multiply.back", ДесятьТретей * 3);
ПоказатьБулево("equal.multiply_back.ten", ДесятьТретей * 3 = 10);

// Значение с конечной дробью позволяет отличить общую потерю точности
// от особого правила деления периодической дроби.
Точное = 1.2345678901234567890123456789;
Показать("exact.literal", Точное);
Показать("exact.add_zero", Точное + 0);
Показать("exact.divide_one", Точное / 1);
ПоказатьБулево("equal.exact_add_zero", Точное + 0 = Точное);
ПоказатьБулево("equal.exact_divide_one", Точное / 1 = Точное);

// Три пути представления и возможная группировка разрядов одной локали.
Показать("present.string", Строка(1234.5));
Сообщить("present.concat: [" + 1234.5 + "]");
Сообщить("present.direct.next:");
Сообщить(1234.5);
Показать("numbers.complete", "ok");

// Второй опыт: различаем вклад масштаба числителя и знаменателя,
// границы блоков, конечные нули, повторное деление и точную половину.
ПоказатьЧастное("div.fractional_divisor", 1, 0.3);
ПоказатьЧастное("div.fractional_divisor_scale10", 1, 0.0000000003);
ПоказатьЧастное("div.equal_scales", 0.1, 0.3);
ПоказатьЧастное("div.mixed_scales_left", 0.0000000001, 0.3);
ПоказатьЧастное("div.mixed_scales_right", 0.1, 0.0000000003);
ПоказатьЧастное("div.numerator_scale9", 0.000000001, 3);
ПоказатьЧастное("div.numerator_scale10", 0.0000000001, 3);
ПоказатьЧастное("div.numerator_scale18", 0.000000000000000001, 3);
ПоказатьЧастное("div.numerator_scale19", 0.0000000000000000001, 3);
ПоказатьЧастное("div.trailing_zero_integer", 1.0000000000, 3);
ПоказатьЧастное("div.trailing_zero_fraction", 13.1000000000, 3);
ПоказатьЧастное("div.redivide", Треть, 7);
ПоказатьЧастное("div.negative_third", -1, 3);
ПоказатьЧастное("div.tie_positive", 1, 2000000000000000000000000000);
ПоказатьЧастное("div.tie_odd", 3, 2000000000000000000000000000);
ПоказатьЧастное("div.tie_negative", -1, 2000000000000000000000000000);
Показать("numbers.precision_v2.complete", "ok");

// Внутренняя запись числа не должна зависеть от разделителей представления.
// Эти строки — пробы, а не заранее выбранный эталон.
ПоказатьВнутреннее("internal.number.zero", 0);
ПоказатьВнутреннее("internal.number.negative-zero", -0.000);
ПоказатьВнутреннее("internal.number.one", 1);
ПоказатьВнутреннее("internal.number.negative", -12.5);
ПоказатьВнутреннее("internal.number.grouping-boundary", 1234.5);
ПоказатьВнутреннее("internal.number.trailing-zeroes", 13.1000000000);
ПоказатьВнутреннее("internal.number.small", 0.0000000000000000000000000001);
ПоказатьВнутреннее("internal.number.large", 1000000000000000000000000000);
ПоказатьВнутреннее("internal.number.exact-fraction", Точное);
ПоказатьВнутреннее("internal.number.third", Треть);
ПоказатьВнутреннее("internal.number.ten-thirds", ДесятьТретей);
ПоказатьВнутреннее("internal.number.scaled-residual", Остаток);
Попытка
    Показать("internal.number.english-alias.payload", ValueToStringInternal(1234.5));
Исключение
    Показать("internal.number.english-alias.error", ОписаниеОшибки());
КонецПопытки;
Показать("numbers.internal.complete", "ok");

// Формы ниже специально не объявлены корректными или ошибочными заранее.
ПоказатьЧтениеВнутреннего("internal.read.empty", "");
ПоказатьЧтениеВнутреннего("internal.read.bare-number", "1");
ПоказатьЧтениеВнутреннего("internal.read.canonical", "{""N"",1}");
ПоказатьЧтениеВнутреннего("internal.read.outer-space", " {""N"",1} ");
ПоказатьЧтениеВнутреннего("internal.read.inner-space", "{ ""N"" , 1 }");
ПоказатьЧтениеВнутреннего("internal.read.trailing-garbage", "{""N"",1}x");
ПоказатьЧтениеВнутреннего("internal.read.truncated", "{""N"",1");
ПоказатьЧтениеВнутреннего("internal.read.unknown-tag", "{""UNKNOWN"",1}");
ПоказатьЧтениеВнутреннего("internal.read.lowercase-tag", "{""n"",1}");
ПоказатьЧтениеВнутреннего("internal.read.plus", "{""N"",+1}");
ПоказатьЧтениеВнутреннего("internal.read.leading-zero", "{""N"",01}");
ПоказатьЧтениеВнутреннего("internal.read.trailing-zero", "{""N"",1.2300}");
ПоказатьЧтениеВнутреннего("internal.read.negative-zero", "{""N"",-0.000}");
ПоказатьЧтениеВнутреннего("internal.read.exponent", "{""N"",1e2}");
ПоказатьЧтениеВнутреннего("internal.read.comma-fraction", "{""N"",1,5}");
ПоказатьЧтениеВнутреннего("internal.read.nan", "{""N"",NaN}");
Попытка
    Показать("internal.read.english-alias.value", ValueFromStringInternal("{""N"",12.5}"));
Исключение
    Показать("internal.read.english-alias.error", ОписаниеОшибки());
КонецПопытки;
Показать("numbers.inverse.complete", "ok");

ПроверитьЦел("helper.int.positive", 1.99);
ПроверитьЦел("helper.int.negative", -1.99);
ПроверитьЦел("helper.int.negative-small", -0.99);
Попытка
    ПроверитьЦел("helper.int.long", Число("12345678901234567890123456789012345678901234567890.9"));
Исключение
    Показать("helper.int.long", "input-error");
КонецПопытки;
ПроверитьЦел("helper.int.boolean", Истина);
ПроверитьЦел("helper.int.numeric-string", "12.75");
ПроверитьЦел("helper.int.invalid-string", "не число");
ПроверитьЦел("helper.int.undefined", Неопределено);
Попытка
    Показать("helper.int.english", ValueToStringInternal(Int(0)));
Исключение
    Показать("helper.int.english", "error");
КонецПопытки;
ПроверитьЭкстремумы("helper.extrema.numbers", 2, -3);
ПроверитьЭкстремумы("helper.extrema.strings", "2", "10");
ПроверитьЭкстремумы("helper.extrema.string-case", "a", "A");
ПроверитьЭкстремумы("helper.extrema.number-boolean", 2, Истина);
ПроверитьЭкстремумы("helper.extrema.boolean-number", Истина, 2);
ПроверитьЭкстремумы("helper.extrema.tie-number-boolean", 0, Ложь);
ПроверитьЭкстремумы("helper.extrema.tie-boolean-number", Ложь, 0);
ПроверитьЭкстремумы("helper.extrema.number-string", 2, "10");
ПроверитьЭкстремумы("helper.extrema.string-number", "2", 10);
ПроверитьЭкстремумы("helper.extrema.undefined-number", Неопределено, 2);
ПроверитьЭкстремумы("helper.extrema.number-undefined", 2, Неопределено);
ПроверитьОдинЭкстремум("helper.extrema.single-number", 7);
ПроверитьОдинЭкстремум("helper.extrema.single-boolean", Истина);
ПроверитьОдинЭкстремум("helper.extrema.single-undefined", Неопределено);
ПроверитьОдинЭкстремум("helper.extrema.single-array", Новый Массив);
Попытка
    Показать("helper.extrema.variadic.min", ЗначениеВСтрокуВнутр(Min(7, -2, 0, -1)));
Исключение
    Показать("helper.extrema.variadic.min", "error");
КонецПопытки;
Попытка
    Показать("helper.extrema.variadic.max", ЗначениеВСтрокуВнутр(Max(-7, 2, 0, 1)));
Исключение
    Показать("helper.extrema.variadic.max", "error");
КонецПопытки;
Показать("numbers.helpers.complete", "ok");
