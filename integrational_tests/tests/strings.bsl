// Строковый конвейер и границы встроенных функций. Эталон получает только 1С.
// Скобки сохраняют видимость пустых строк и краевых пробелов в сообщениях.
Процедура Показать(Знач Метка, Знач Значение)
    Сообщить(Метка + ": [" + Строка(Значение) + "]");
КонецПроцедуры

// Нативный формат пока исследуется; ошибки записи и чтения различаются.
Процедура ПоказатьВнутреннее(Знач Метка, Знач Значение)
    Попытка
        Запись = ЗначениеВСтрокуВнутр(Значение);
        Показать(Метка + ".payload", Запись);
    Исключение
        Показать(Метка + ".error", ОписаниеОшибки());
        Возврат;
    КонецПопытки;
    Попытка
        Восстановлено = ЗначениеИзСтрокиВнутр(Запись);
        ПоказатьБулево(Метка + ".roundtrip.type", ТипЗнч(Восстановлено) = ТипЗнч(Значение));
        ПоказатьБулево(Метка + ".roundtrip.value", Восстановлено = Значение);
    Исключение
        Показать(Метка + ".roundtrip.error", ОписаниеОшибки());
    КонецПопытки;
КонецПроцедуры

Процедура ПоказатьБулево(Знач Метка, Знач Значение)
    Показать(Метка, ?(Значение, "true", "false"));
КонецПроцедуры

Процедура ПоказатьЧасти(Знач Метка, Знач Части)
    Показать(Метка + ".count", Части.Количество());
    Для Индекс = 0 По Части.Количество() - 1 Цикл
        Показать(Метка + "." + Строка(Индекс), Части[Индекс]);
    КонецЦикла;
КонецПроцедуры

// Длина и коды вместо сырого NUL или одиночных суррогатов в консоли.
Процедура ПроверитьСимвол(Знач Метка, Знач Код)
    Попытка
        Результат = Символ(Код);
        Запись = ЗначениеВСтрокуВнутр(СтрДлина(Результат));
        Для Номер = 1 По СтрДлина(Результат) Цикл
            Запись = Запись + ";" + ЗначениеВСтрокуВнутр(КодСимвола(Результат, Номер));
        КонецЦикла;
        Показать(Метка, Запись);
    Исключение
        Показать(Метка, "error");
    КонецПопытки;
КонецПроцедуры

Процедура ПроверитьКодСимвола(Знач Метка, Знач Текст, Знач Номер = 1)
    Попытка
        Показать(Метка, ЗначениеВСтрокуВнутр(КодСимвола(Текст, Номер)));
    Исключение
        Показать(Метка, "error");
    КонецПопытки;
КонецПроцедуры

// Типичный разбор списка: удалить пустые поля, пробелы и унифицировать регистр.
