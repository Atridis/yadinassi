// Строковый конвейер и границы встроенных функций. Эталон получает только 1С.
// Скобки сохраняют видимость пустых строк и краевых пробелов в сообщениях.
Процедура Показать(Знач Метка, Знач Значение)
    Сообщить(Метка + ": [" + Строка(Значение) + "]");
КонецПроцедуры

// Нативный формат пока исследуется; ошибки записи и чтения различаются.
Процедура ПоказатьВнутреннее(Знач Метка, Знач Значение)
    Попытка
        Запись = ЗначениеВСтрокуВнутр(Значение);
        Показать(Метка + ".payload", Запись);
    Исключение
        Показать(Метка + ".error", ОписаниеОшибки());
        Возврат;
    КонецПопытки;
    Попытка
        Восстановлено = ЗначениеИзСтрокиВнутр(Запись);
        ПоказатьБулево(Метка + ".roundtrip.type", ТипЗнч(Восстановлено) = ТипЗнч(Значение));
        ПоказатьБулево(Метка + ".roundtrip.value", Восстановлено = Значение);
    Исключение
        Показать(Метка + ".roundtrip.error", ОписаниеОшибки());
    КонецПопытки;
КонецПроцедуры

Процедура ПоказатьБулево(Знач Метка, Знач Значение)
    Показать(Метка, ?(Значение, "true", "false"));
КонецПроцедуры

Процедура ПоказатьЧасти(Знач Метка, Знач Части)
    Показать(Метка + ".count", Части.Количество());
    Для Индекс = 0 По Части.Количество() - 1 Цикл
        Показать(Метка + "." + Строка(Индекс), Части[Индекс]);
    КонецЦикла;
КонецПроцедуры

// Длина и коды вместо сырого NUL или одиночных суррогатов в консоли.
Процедура ПроверитьСимвол(Знач Метка, Знач Код)
    Попытка
        Результат = Символ(Код);
        Запись = ЗначениеВСтрокуВнутр(СтрДлина(Результат));
        Для Номер = 1 По СтрДлина(Результат) Цикл
            Запись = Запись + ";" + ЗначениеВСтрокуВнутр(КодСимвола(Результат, Номер));
        КонецЦикла;
        Показать(Метка, Запись);
    Исключение
        Показать(Метка, "error");
    КонецПопытки;
КонецПроцедуры

Процедура ПроверитьКодСимвола(Знач Метка, Знач Текст, Знач Номер = 1)
    Попытка
        Показать(Метка, ЗначениеВСтрокуВнутр(КодСимвола(Текст, Номер)));
    Исключение
        Показать(Метка, "error");
    КонецПопытки;
КонецПроцедуры

// Только числовые внутренние записи: транспорт не скроет CR/LF, NUL или суррогаты.
Процедура ПроверитьЧислоСтрок(Знач Метка, Знач Текст)
    Попытка
        Показать(Метка, ЗначениеВСтрокуВнутр(StrLineCount(Текст)));
    Исключение
        Показать(Метка, "error");
    КонецПопытки;
КонецПроцедуры

Процедура ПроверитьСтрокуПоНомеру(Знач Метка, Знач Текст, Знач Номер)
    Попытка
        Результат = СтрПолучитьСтроку(Текст, Номер);
        Запись = ЗначениеВСтрокуВнутр(СтрДлина(Результат));
        Для Позиция = 1 По СтрДлина(Результат) Цикл
            Запись = Запись + ";" + ЗначениеВСтрокуВнутр(КодСимвола(Результат, Позиция));
        КонецЦикла;
        Показать(Метка, Запись);
    Исключение
        Показать(Метка, "error");
    КонецПопытки;
КонецПроцедуры

Процедура ПроверитьМногострочную(Знач Метка, Знач Текст)
    ПроверитьЧислоСтрок(Метка + ".count", Текст);
    Для Номер = 1 По 4 Цикл
        ПроверитьСтрокуПоНомеру(Метка + ".line" + Строка(Номер), Текст, Номер);
    КонецЦикла;
КонецПроцедуры

// Компактный контроль после строковых изменений. Ошибки не зависят от пути/локали.
Процедура ПроверитьГраницы(Знач Метка, Знач Текст, Знач Образец)
    Попытка
        Показать(Метка, ЗначениеВСтрокуВнутр(СтрНачинаетсяС(Текст, Образец))
            + ";" + ЗначениеВСтрокуВнутр(StrEndsWith(Текст, Образец)));
    Исключение
        Показать(Метка, "error");
    КонецПопытки;
КонецПроцедуры

Процедура ПроверитьВхождения(Знач Метка, Знач Текст, Знач Образец)
    Попытка
        Показать(Метка, ЗначениеВСтрокуВнутр(СтрЧислоВхождений(Текст, Образец))
            + ";" + ЗначениеВСтрокуВнутр(StrOccurrenceCount(Текст, Образец)));
    Исключение
        Показать(Метка, "error");
    КонецПопытки;
КонецПроцедуры

Процедура ПроверитьШаблон(Знач Метка, Знач Шаблон, Знач Значение)
    Попытка
        Показать(Метка, ЗначениеВСтрокуВнутр(СтрШаблон(Шаблон, Значение)));
    Исключение
        Показать(Метка, "error");
    КонецПопытки;
КонецПроцедуры

// Следующий контроль: результат сравнения/поиска и его внутренний roundtrip.
Процедура ПроверитьСравнение(Знач Метка, Знач Первый, Знач Второй)
    Попытка
        Результат = СтрСравнить(Первый, Второй);
        Запись = ЗначениеВСтрокуВнутр(Результат);
        Показать(Метка, Запись);
        ПоказатьБулево(Метка + ".alias", StrCompare(Первый, Второй) = Результат);
        ПоказатьБулево(Метка + ".roundtrip", ЗначениеИзСтрокиВнутр(Запись) = Результат);
    Исключение
        Показать(Метка, "error");
    КонецПопытки;
КонецПроцедуры

Процедура ПроверитьСтрНайти(Знач Метка, Знач Текст, Знач Образец)
    Попытка
        Показать(Метка, ЗначениеВСтрокуВнутр(СтрНайти(Текст, Образец))
            + ";" + ЗначениеВСтрокуВнутр(StrFind(Текст, Образец)));
    Исключение
        Показать(Метка, "error");
    КонецПопытки;
КонецПроцедуры

Процедура ПроверитьXML(Знач Метка, Знач Вид, Знач Текст)
    Попытка
        Результат = XMLЗначение(Вид, Текст);
        Показать(Метка, ЗначениеВСтрокуВнутр(Результат));
        Показать(Метка + ".writer", ЗначениеВСтрокуВнутр(XMLString(Результат)));
        ПоказатьБулево(Метка + ".alias", XMLValue(Вид, Текст) = Результат);
        ПоказатьБулево(Метка + ".roundtrip", XMLЗначение(Вид,
            ЗначениеИзСтрокиВнутр(ЗначениеВСтрокуВнутр(XMLСтрока(Результат)))) = Результат);
    Исключение
        Показать(Метка, "error");
    КонецПопытки;
КонецПроцедуры

