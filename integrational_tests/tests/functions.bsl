Перем МодульноеВычисления;

Функция Сложить(А, Б)
    Возврат А + Б;
КонецФункции

Процедура Показать(Знач Значение)
    Сообщить(Значение);
КонецПроцедуры

// Переходы только в том же блоке или наружу: вход в чужие ветви не проверяется.
Функция ПроверитьПереходы()
    След = "";
    Перейти ~Вперед;
    След = След + "bad";
    ~Вперед:
    Номер = 0;
    ~Повтор:
    Номер = Номер + 1;
    След = След + Строка(Номер);
    Если Номер < 3 Тогда
        Goto ~повтор;
    КонецЕсли;
    Возврат След;
КонецФункции

Функция ПроверитьВложенныеЦиклы()
    След = "";
    Для Внешний = 1 По 2 Цикл
        Для Внутренний = 1 По 3 Цикл
            Пока Истина Цикл
                Перейти ~Следующий;
                Прервать; // Страховка от зависания при неисправном переходе.
            КонецЦикла;
            След = След + "bad";
        КонецЦикла;
        След = След + "bad";
        ~Следующий:
        След = След + Строка(Внешний) + Строка(Внутренний);
    КонецЦикла;
    Возврат След;
КонецФункции

Функция ПроверитьВыходИзПопытки()
    След = "";
    Попытка
        Для Номер = 1 По 3 Цикл
            Пока Истина Цикл
                Попытка
                    Перейти ~Готово;
                Исключение
                    След = След + "bad-inner";
                КонецПопытки;
                Прервать; // Ошибка перехода не должна зациклить нативную пробу.
            КонецЦикла;
        КонецЦикла;
    Исключение
        След = След + "bad-outer";
    КонецПопытки;
    След = След + "bad";
    ~Готово:
    Возврат След + Строка(Номер);
КонецФункции

Процедура ПроверитьВыходИзОбработчика()
    Попытка
        ВызватьИсключение "outer";
    Исключение
        Попытка
            ВызватьИсключение "inner";
        Исключение
            Перейти ~Готово;
        КонецПопытки;
        Сообщить("goto.handler.unreachable");
    КонецПопытки;
    ~Готово:
    Сообщить("goto.handler.empty: " + ЗначениеВСтрокуВнутр(ОписаниеОшибки() = ""));
    Попытка
        ВызватьИсключение "fresh";
    Исключение
        Сообщить("goto.handler.fresh: " + ЗначениеВСтрокуВнутр(Найти(ОписаниеОшибки(), "fresh") > 0));
    КонецПопытки;
    Сообщить("goto.handler.after: " + ЗначениеВСтрокуВнутр(ОписаниеОшибки() = ""));
КонецПроцедуры

// Текст ошибочных выражений компилируется только внутри Вычислить.
// Все результаты — короткие записи скаляров; тексты ошибок не сохраняются.
Процедура ПроверитьВычисление(Знач Метка, Знач Выражение)
    ЛокальноеВычисления = 14;
    Попытка
        Результат = Вычислить(Выражение);
        Сообщить("eval." + Метка + ": [" + ЗначениеВСтрокуВнутр(Результат) + "]");
    Исключение
        Сообщить("eval." + Метка + ": [error]");
    КонецПопытки;
КонецПроцедуры

Функция УвеличитьДляВычисления(Параметр)
    Параметр = Параметр + 1;
    Возврат Параметр;
КонецФункции

Процедура ПроверитьСсылкуВычисления(Параметр)
    Попытка
        Результат = Eval("УвеличитьДляВычисления(Параметр)");
        Сообщить("eval.reference.result: [" + ЗначениеВСтрокуВнутр(Результат) + ";"
            + ЗначениеВСтрокуВнутр(Параметр) + "]");
    Исключение
        Сообщить("eval.reference.result: [error]");
    КонецПопытки;
КонецПроцедуры

Процедура ПроверитьГраницуВычисления(Знач Метка, Знач Выражение)
    СчетчикВычисления = 5;
    Попытка
        Результат = Eval(Выражение);
        Сообщить("eval." + Метка + ": [" + ЗначениеВСтрокуВнутр(Результат) + "]");
    Исключение
        Сообщить("eval." + Метка + ": [error]");
    КонецПопытки;
    Сообщить("eval." + Метка + ".state: [" + ЗначениеВСтрокуВнутр(СчетчикВычисления) + "]");
КонецПроцедуры

// Выполнить: ошибки компиляции остаются внутри строк и не ломают весь модуль.
// Один вывод фиксирует статус и состояние после вызова, без локализованной ошибки.
Процедура ПроверитьВыполнение(Знач Метка, Знач Код)
    Состояние = 5;
    Статус = "ok";
    Попытка
        Выполнить(Код);
    Исключение
        Статус = "error";
    КонецПопытки;
    Сообщить("execute." + Метка + ": [" + Статус + ";"
        + ЗначениеВСтрокуВнутр(Состояние) + "]");
КонецПроцедуры

Процедура ПроверитьИменаВыполнения()
    Состояние = 5;
    Попытка
        Execute("НовоеИмяВыполнения = 37; Состояние = НовоеИмяВыполнения;");
        Сообщить("execute.new.within: [" + ЗначениеВСтрокуВнутр(Состояние) + "]");
    Исключение
        Сообщить("execute.new.within: [error]");
    КонецПопытки;
    Попытка
        Сообщить("execute.new.eval-after: [" + ЗначениеВСтрокуВнутр(Eval("НовоеИмяВыполнения")) + "]");
    Исключение
        Сообщить("execute.new.eval-after: [error]");
    КонецПопытки;
    Попытка
        Execute("Состояние = НовоеИмяВыполнения;");
        Сообщить("execute.new.second: [" + ЗначениеВСтрокуВнутр(Состояние) + "]");
    Исключение
        Сообщить("execute.new.second: [error]");
    КонецПопытки;
КонецПроцедуры

Процедура ПроверитьПараметрыВыполнения(ПоСсылке, Знач ПоЗначению)
    Execute("ПоСсылке = ПоСсылке + 2; ПоЗначению = ПоЗначению + 3; МодульноеВычисления = МодульноеВычисления + 4;");
КонецПроцедуры

Функция ВозвратИзВыполнения(Знач Код)
    Состояние = 5;
    Выполнить(Код);
    Возврат Состояние + 100;
КонецФункции

Процедура ПроверитьВозвратВыполнения(Знач Метка, Знач Код)
    Попытка
        Сообщить("execute.return." + Метка + ": [" + ЗначениеВСтрокуВнутр(ВозвратИзВыполнения(Код)) + "]");
    Исключение
        Сообщить("execute.return." + Метка + ": [error]");
    КонецПопытки;
КонецПроцедуры

// Внешний цикл конечен даже при неожиданной обработке Break/Continue.
Процедура ПроверитьЦиклВыполнения(Знач Метка, Знач Код)
    След = "";
    Для Номер = 1 По 2 Цикл
        След = След + "a";
        Попытка
            Выполнить(Код);
            След = След + "b";
        Исключение
            След = След + "e";
        КонецПопытки;
        След = След + "c";
    КонецЦикла;
    Сообщить("execute.loop." + Метка + ": [" + След + "]");
КонецПроцедуры

Процедура ПроверитьПереходВыполнения()
    След = "a";
    Попытка
        Выполнить("Перейти ~ВнешняяМеткаВыполнения;");
        След = След + "b";
    Исключение
        След = След + "e";
    КонецПопытки;
    След = След + "c";
    ~ВнешняяМеткаВыполнения:
    Сообщить("execute.goto.outside: [" + След + "]");
КонецПроцедуры

Процедура ПроверитьПовторИсключенияВыполнения()
    Попытка
        ВызватьИсключение "execute-origin";
    Исключение
        Попытка
            Выполнить("ВызватьИсключение;");
            Сообщить("execute.rethrow: [no-error]");
        Исключение
            Сообщить("execute.rethrow: [" + ЗначениеВСтрокуВнутр(Найти(ОписаниеОшибки(), "execute-origin") > 0) + "]");
        КонецПопытки;
    КонецПопытки;
КонецПроцедуры

Показать(Сложить(2, 3));

Попытка
    Сообщить("goto.forward-backward: " + ПроверитьПереходы());
Исключение
    Сообщить("goto.forward-backward: error");
КонецПопытки;
Попытка
    Сообщить("goto.nested-loops: " + ПроверитьВложенныеЦиклы());
Исключение
    Сообщить("goto.nested-loops: error");
КонецПопытки;
Попытка
    Сообщить("goto.try-outward: " + ПроверитьВыходИзПопытки());
Исключение
    Сообщить("goto.try-outward: error");
КонецПопытки;
Попытка
    ПроверитьВыходИзОбработчика();
Исключение
    Сообщить("goto.handler: error");
КонецПопытки;
Сообщить("goto.complete: ok");

