// Проверки выполняются также при программной записи и загрузке через обмен.
Процедура ПередЗаписью(Отказ)

	// Пометка удаления должна быть доступна и для старых незаполненных карточек.
	Если ПометкаУдаления Тогда
		Возврат;
	КонецЕсли;

	ПодготовитьДанныеКЗаписи(Отказ);

КонецПроцедуры

Процедура ПодготовитьДанныеКЗаписи(Отказ) Экспорт

	Если ПометкаУдаления Тогда
		Возврат;
	КонецЕсли;

	Наименование = СокрЛП(Наименование);
	ПроверитьДанные(Отказ);

КонецПроцедуры

// Общая проверка для записи из формы, программной записи и команды списка.
// Не изменяет объект. Команда списка проверяет только сохраненные данные.
Процедура ПроверитьДанные(Отказ) Экспорт

	Если СтрДлина(СокрЛП(Наименование)) < 3 Тогда
		СообщитьОбОшибке(Отказ,
			"Укажите наименование номенклатуры длиной не менее трех символов.", "Наименование");
	КонецЕсли;

	Если Не ЗначениеЗаполнено(ВидНоменклатуры) Тогда
		СообщитьОбОшибке(Отказ, "Выберите вид номенклатуры.", "ВидНоменклатуры");
	Иначе
		ОбъектВида = ВидНоменклатуры.ПолучитьОбъект();
		Если ОбъектВида = Неопределено Тогда
			СообщитьОбОшибке(Отказ, "Выбранный вид номенклатуры не существует.", "ВидНоменклатуры");
		ИначеЕсли ОбъектВида.ПометкаУдаления Тогда
			СообщитьОбОшибке(Отказ,
				"Выбранный вид номенклатуры помечен на удаление. Выберите другой вид.", "ВидНоменклатуры");
		КонецЕсли;
	КонецЕсли;

	Если Склады.Количество() = 0 Тогда
		СообщитьОбОшибке(Отказ, "Укажите хотя бы один склад хранения.", "Склады");
	КонецЕсли;

	ПроверенныеСклады = Новый Соответствие;
	Для Каждого СтрокаСклада Из Склады Цикл
		ПолеСклада = "Склады[" + Формат(СтрокаСклада.НомерСтроки - 1, "ЧГ=0") + "].Склад";
		Если Не ЗначениеЗаполнено(СтрокаСклада.Склад) Тогда
			СообщитьОбОшибке(Отказ, "Заполните склад в строке " + Строка(СтрокаСклада.НомерСтроки) + ".", ПолеСклада);
			Продолжить;
		КонецЕсли;

		ПерваяСтрока = ПроверенныеСклады.Получить(СтрокаСклада.Склад);
		Если ПерваяСтрока <> Неопределено Тогда
			СообщитьОбОшибке(Отказ,
				"Этот склад уже указан в строке " + Строка(ПерваяСтрока) + ". Удалите повторяющуюся строку.", ПолеСклада);
			Продолжить;
		КонецЕсли;
		ПроверенныеСклады.Вставить(СтрокаСклада.Склад, СтрокаСклада.НомерСтроки);

		ОбъектСклада = СтрокаСклада.Склад.ПолучитьОбъект();
		Если ОбъектСклада = Неопределено Тогда
			СообщитьОбОшибке(Отказ, "Выбранный склад не существует.", ПолеСклада);
		ИначеЕсли ОбъектСклада.ПометкаУдаления Тогда
			СообщитьОбОшибке(Отказ, "Склад помечен на удаление. Выберите другой склад.", ПолеСклада);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

Процедура СообщитьОбОшибке(Отказ, ТекстОшибки, Поле)

	Отказ = Истина;
	Сообщение = Новый СообщениеПользователю;
	Сообщение.Текст = ТекстОшибки;
	Сообщение.Поле = Поле;
	Сообщение.УстановитьДанные(ЭтотОбъект);
	Сообщение.Сообщить();

КонецПроцедуры
